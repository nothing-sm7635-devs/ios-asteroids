+// The handler and present lists of a command buffer are filled by the thread that encodes it and drained by the one that
+// completes it (bg_cmdbuf_done runs on the submission thread): every access holds the command buffer's lock, and a list is
+// drained by taking it whole, so a handler that adds another handler cannot mutate a list being enumerated (backboardd
+// died on "Collection <__NSArrayM> was mutated while being enumerated" in bgCompleteFrom, ast9 2026-10-28).
+static NSArray *
+bg_take(id owner, NSMutableArray *list)
+{
+   NSArray *all;
+   @synchronized(owner) {
+      all = [list copy];
+      [list removeAllObjects];
+   }
+   return [all autorelease];
+}
