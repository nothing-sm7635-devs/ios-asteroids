+// BGMTL_SKIP_COMPUTE: comma-separated compute function names whose dispatches are dropped ("all": every one). The A810
+// (asteroids) hung its GPU twice right after backboardd's first compute_average_luma/compute_sum_luma dispatches (ast9,
+// ast10, 2026-10-28; Mesa 26.2's a8xx compute is new): what reads their results (luma statistics) then sees stale values.
+static int
+bg_compute_skipped(const char *name)
+{
+   const char *list = getenv("BGMTL_SKIP_COMPUTE");
+   if (!list || !list[0] || !name) return 0;
+   if (!strcmp(list, "all")) return 1;
+   size_t n = strlen(name);
+   for (const char *p = list; *p; ) {
+      const char *e = strchr(p, ',');
+      size_t len = e ? (size_t)(e - p) : strlen(p);
+      if (len == n && !strncmp(p, name, n)) return 1;
+      if (!e) break;
+      p = e + 1;
+   }
+   return 0;
+}
+
 @interface BGMTLComputePipeline : _MTLComputePipelineState {
  @public
    BGMTLDevice *_owner;
    struct chl_compute_pipeline *_p;
    struct chl_pipeline_info _info;
+   int _skip;     // its dispatches are dropped (bg_compute_skipped)
 }
 @end
 
