diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 2a8e5a0..5910399 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -525,11 +525,31 @@ LEXT(start_first_cpu)
 	mov		x21, #0
 
 #if defined(SWEET)
-	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	/*
+	 * Stage 0: white 64x32 band, no stack or page tables needed, near the
+	 * bottom of the boot_args framebuffer, clipped to the 32MB block that
+	 * holds its start (sweet_early.c uses the same block). boot_args (x20,
+	 * physical): Video.v_baseAddr at 40, v_rowBytes at 56, v_height at 72.
+	 * Asteroids: a fixed 0x9c000000 is a firmware carve-out under Gunyah.
+	 */
+	ldr		x0, [x20, #40]
+	ldr		x4, [x20, #56]
+	ldr		x6, [x20, #72]
+	cbz		x0, Lsweet_mark_done
+	cmp		x4, #(4 * 64)
+	b.lo	Lsweet_mark_done
+	and		x7, x0, #(ARM_TT_L2_OFFMASK)
+	mov		x8, #(ARM_TT_L2_SIZE)
+	sub		x8, x8, x7
+	udiv	x8, x8, x4
+	cmp		x6, x8
+	csel	x6, x6, x8, lo
+	cmp		x6, #64
+	b.lo	Lsweet_mark_done
+	sub		x6, x6, #32
+	madd	x0, x6, x4, x0
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -541,6 +561,7 @@ Lsweet_mark_pixel:
 	subs	x2, x2, #1
 	b.ne	Lsweet_mark_row
 	dsb		sy
+Lsweet_mark_done:
 #endif
 
 	// Set low reset vector before attempting any loads
@@ -697,13 +718,16 @@ Lkernelcache_base_found:
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	ldr		x10, [x20, #40]			// boot_args Video.v_baseAddr
+	cbz		x10, Lsweet_fb_map_done
+	and		x10, x10, #(~ARM_TT_L2_OFFMASK)	// the 32MB block holding it
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+Lsweet_fb_map_done:
 #endif
 
 	/* Ensure TTEs are visible */
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 7dcca46..d6b2949 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -13,13 +13,16 @@
 #include <pexpert/pexpert.h>
 
 /*
- * start.s and arm_vm_init map one 32MB block at 0x9c000000. It holds the
- * splash framebuffer of both boards (sweet 0x9c000000 1080x2400, Poco F1
- * 0x9d400000 1080x2246); sweet_early_set_video picks it from boot_args.
+ * start.s and arm_vm_init map one 32MB block: the one holding the boot_args
+ * framebuffer start (sweet 0x9c000000 1080x2400, Poco F1 0x9d400000 1080x2246,
+ * both in the block at 0x9c000000; Nothing Phone (3a) 0xe3940000 1080x2392 in
+ * the block at 0xe2000000). sweet_early_set_video picks it from boot_args and
+ * clips the height to the rows inside that block.
  */
-#define EARLY_BLOCK_PA 0x9c000000ull
 #define EARLY_BLOCK_SIZE 0x2000000ull
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)EARLY_BLOCK_PA;
+static uint64_t early_block_pa = 0x9c000000ull;
+#define EARLY_BLOCK_PA early_block_pa
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000ull;
 static unsigned int early_width = 1080u, early_height = 2400u, early_stride = 4320u / 4;
 static uint64_t early_off;
 #define EARLY_FB early_fb
@@ -200,17 +203,32 @@ sweet_early_flush_log(void)
 void
 sweet_early_set_video(uint64_t pa, uint64_t width, uint64_t height, uint64_t rowbytes)
 {
-	if (pa < EARLY_BLOCK_PA || width == 0 || height <= 32 || rowbytes < width * 4 ||
-	    pa + height * rowbytes > EARLY_BLOCK_PA + EARLY_BLOCK_SIZE) {
+	uint64_t block = pa & ~(EARLY_BLOCK_SIZE - 1);
+
+	if (pa == 0 || width == 0 || rowbytes < width * 4) {
 		return; /* keep the sweet default */
 	}
-	early_off = pa - EARLY_BLOCK_PA;
+	/* start.s mapped only this block: the rows past its end are not ours to touch */
+	if (pa + height * rowbytes > block + EARLY_BLOCK_SIZE) {
+		height = (block + EARLY_BLOCK_SIZE - pa) / rowbytes;
+	}
+	if (height <= 32) {
+		return;
+	}
+	early_block_pa = block;
+	early_off = pa - block;
 	early_width = (unsigned int)width;
 	early_height = (unsigned int)height;
 	early_stride = (unsigned int)(rowbytes / 4);
 	early_fb = (volatile uint32_t *)(uintptr_t)pa; /* bootstrap V=P */
 }
 
+uint64_t
+sweet_early_fb_block(void)
+{
+	return early_block_pa;
+}
+
 void
 sweet_early_relocate(uint64_t base)
 {
