diff --git a/bsd/dev/sweet_board.h b/bsd/dev/sweet_board.h
index 3d9c06a..3adf741 100644
--- a/bsd/dev/sweet_board.h
+++ b/bsd/dev/sweet_board.h
@@ -3,6 +3,8 @@
  * (tools/mkadt.py --board) names the board; everything else is common.
  *   xiaomi,sweet      Redmi Note 10 Pro, SM7150 (default)
  *   xiaomi,beryllium  Poco F1, SDM845
+ *   nothing,asteroids Nothing Phone (3a), SM7635 under Qualcomm's Gunyah hypervisor:
+ *                     none of the SM7150/SDM845 drivers (fixed MMIO) may run there
  */
 #ifndef _SWEET_BOARD_H_
 #define _SWEET_BOARD_H_
@@ -76,4 +78,14 @@ sweet_board_beryllium(void)
 	return cached == 1;
 }
 
+static inline bool
+sweet_board_asteroids(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		cached = sweet_board_is("nothing,asteroids") ? 1 : 0;
+	}
+	return cached == 1;
+}
+
 #endif /* _SWEET_BOARD_H_ */
