+/*
+ * Nothing Phone (3a) "asteroids" touch: FocalTech FT3683G on QUP0 SE0 SPI.
+ *
+ * SE0's GENI FIFO interface is disabled (GENI_IF_DISABLE_RO = 1), so every
+ * SPI frame goes through GPI DMA (static GPII 0). The sequence below is the
+ * one verified on the phone by asteroids/probe/probe5.c -DPROBE8 + gpi.c
+ * (run 10, 2026-10-19), see asteroids/NOTES.md:
+ *   1 TLMM    GPIO 0-3 qup0_se0, GPIO 20 reset low, GPIO 19 IRQ in + pull-up
+ *   2 RPMh    apps RSC DRV2 (v3 layout) AMC votes: ldob11 1800 mV, ldob22
+ *             3300 mV, BCM SN3 (aggre2_noc, which QUP0 masters on)
+ *   3 GCC     QUP0 wrapper + SE0 clock votes; 2 ms, reset high, 200 ms
+ *   4 SMMU    SMR entries for SIDs 0x576 (GPI) and 0x563 (QUP0 wrapper)
+ *             pointing at UFS's S2CR (context bank 0); sCR0 GFRE/GFIE
+ *             cleared as in run 10 (boot-arg sweettouchgf=1 keeps them)
+ *   5 GENI    SE0 in GSI mode; GPII 0 event ring + TX/RX channels
+ *   6 FTS     SPI v2 frames (header, 3 dummy bytes, data, CRC-16/KERMIT),
+ *             chip ID 0xA3/0x9F, touch report = 84 bytes at register 0x01
+ * The apps SMMU is emulated by Gunyah: its registers are accessed only as
+ * single plain ldr/str (a writeback load took an external abort, run 4).
+ * Everything is polled from one kernel thread; no GIC interrupts are used.
+ *
+ * Register layouts and sequences follow GPL-2.0 Linux sources of the phone
+ * (msm_gpi.c, spi-msm-geni.c, qcom-geni-se.c, rpmh-rsc.c, cmd-db.c,
+ * bcm-voter.c, focaltech_spi_v2.c, focaltech_core.c); no code is copied,
+ * only register offsets, bit positions and the order of operations.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
