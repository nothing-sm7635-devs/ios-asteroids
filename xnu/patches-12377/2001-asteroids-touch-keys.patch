+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_touch_asteroids_init(void);
+
+#define AT_TLMM_PA      0x0f100000u     /* TLMM + REG_BASE 0x100000 */
+#define AT_TLMM_SIZE    0x15000u        /* GPIO 0..20 */
+#define AT_GCC_PA       0x00100000u
+#define AT_GCC_SIZE     0x60000u
+#define AT_RSC_PA       0x17a20000u     /* apps RSC DRV2 */
+#define AT_RSC_SIZE     0x4000u
+#define AT_CMDDB_PA     0x81c60000u     /* reserved-memory cmd-db */
+#define AT_CMDDB_SIZE   0x20000u
+#define AT_SMMU_PA      0x15000000u     /* apps SMMU GR0 */
+#define AT_SMMU_SIZE    0x1000u
+#define AT_GPI_PA       0x00a00000u     /* gpi-top */
+#define AT_GPI_SIZE     0x60000u
+#define AT_SE_PA        0x00a80000u     /* QUP0 SE0 */
+#define AT_SE_SIZE      0x4000u
+
+/* TLMM */
+#define GPIO_CFG(n)     ((uint32_t)(n) * 0x1000u)
