+#define M_FIFO_IRQS             ((1u << 0) | (1u << 26) | (1u << 27) | (1u << 30))
+
+/* GPII 0 (gpi-ee-offset 0x10000 below gpi-top, msm_gpi_mmio.h) */
+#define EE              (-0x10000)
+#define CH_CNTXT(k)     (EE + 0x20000 + 0x80 * (k))
+#define CH_SCRATCH(k)   (EE + 0x20060 + 0x80 * (k))
+#define CH_QOS(k)       (EE + 0x2005c + 0x80 * (k))
+#define EV_CNTXT        (EE + 0x21000)
+#define CH_DB(k)        (EE + 0x22000 + 0x8 * (k))
+#define EV_DB           (EE + 0x22100)
+#define CH_CMD          (EE + 0x23008)
+#define EV_CMD          (EE + 0x23010)
+#define TYPE_IRQ        (EE + 0x23080)
+#define TYPE_IRQ_MSK    (EE + 0x23088)
+#define SRC_CH_IRQ      (EE + 0x23090)
+#define SRC_EV_IRQ      (EE + 0x23094)
+#define SRC_CH_MSK      (EE + 0x23098)
+#define SRC_EV_MSK      (EE + 0x2309c)
+#define SRC_CH_CLR      (EE + 0x230a0)
+#define SRC_EV_CLR      (EE + 0x230a4)
+#define IEOB_MSK        (EE + 0x230b8)
+#define IEOB_CLR        (EE + 0x230c0)
+#define GLOB_STTS       (EE + 0x23100)
+#define GLOB_EN         (EE + 0x23108)
+#define GPII_EN         (EE + 0x23120)
+#define INTSET          (EE + 0x23180)
+#define MSI_LSB         (EE + 0x23188)
+#define MSI_MSB         (EE + 0x2318c)
+#define GPII_SCRATCH0   (EE + 0x23400)
+#define GPII_SCRATCH1   (EE + 0x23404)
+#define ERROR_LOG       (EE + 0x23200)
+#define C_CONFIG        0x00
+#define C_LEN           0x04
+#define C_BASE_LO       0x08
+#define C_BASE_HI       0x0c
+#define C_RP_LO         0x10
+#define C_INT_MOD       0x20
+#define C_MSI_LO        0x28
+#define C_MSI_HI        0x2c
+#define C_RPU_LO        0x30
+#define C_RPU_HI        0x34
+#define T_CH_CTRL       0x01u
+#define T_EV_CTRL       0x02u
+#define T_GLOB          0x04u
+#define T_IEOB          0x08u
+#define T_GENERAL       0x40u
+#define OP_ALLOC        0u
