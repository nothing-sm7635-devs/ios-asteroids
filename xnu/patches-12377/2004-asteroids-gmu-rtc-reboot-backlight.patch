+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/*
+ * Adreno GMU firmware block planning and the modern GMU HFI transport, startup messages and RPMh votes, for the
+ * Nothing Phone (3a) "asteroids" Adreno 810 bring-up (sweet_a810*.c).
+ *
+ * Ported from AdrenoFirmware (branch asteroids, 96028a5; Copyright (c) 2026, ArmVirtPlatform contributors. All rights
+ * reserved. BSD-2-Clause-Patent): AdrenoFirmware.h, AdrenoHfi.h, AdrenoHfiStartup.h, AdrenoHfiVotes.h, unchanged
+ * apart from being one header.
+ */
+#ifndef SWEET_A810_HFI_H
+#define SWEET_A810_HFI_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* ---- AdrenoFirmware.h ---- */
+typedef struct {
+  uint32_t address;
+  uint64_t bytes;
+  uint32_t identifier;
+} AdrenoFirmwareRegion;
+
+typedef struct {
+  uint32_t address, bytes, type, value;
+  size_t payload_offset;
+  uint32_t region_identifier;
+} AdrenoFirmwareBlock;
+
+typedef enum {
+  AdrenoFirmwareSuccess,
+  AdrenoFirmwareInvalid,
+  AdrenoFirmwareTruncated,
+  AdrenoFirmwareUnmapped,
+  AdrenoFirmwareNoSpace
+} AdrenoFirmwareResult;
+
+/* No output entries are changed on failure; *count is then zero.
+ * Zero-size metadata stays opaque, with region_identifier UINT32_MAX.
+ * Success validates structure/ranges, not firmware authenticity or execution.
+ */
+AdrenoFirmwareResult AdrenoFirmwarePlanGmu(
+    const uint8_t *firmware, size_t bytes,
+    const AdrenoFirmwareRegion *regions, size_t region_count,
+    AdrenoFirmwareBlock *blocks, size_t capacity, size_t *count);
+
+/* ---- AdrenoHfi.h ---- */
+typedef enum {
+    AdrenoHfiSuccess,AdrenoHfiInvalid,AdrenoHfiBusy,AdrenoHfiNoSpace,
+    AdrenoHfiEmpty,AdrenoHfiCorrupt,AdrenoHfiUnexpected,AdrenoHfiFirmwareError,
+    AdrenoHfiNotifyError,AdrenoHfiWaitError,AdrenoHfiTimeout,AdrenoHfiPoisoned
+} AdrenoHfiStatus;
+typedef struct {
+    volatile uint32_t *shared;
+    uint32_t iova,sequence,pending_header,poisoned;
+    void *cookie;
+    int (*notify)(void *); /* real HOST2GMU interrupt write, 0=success */
+    /* Diagnostics of skipped response packets (a6xx_hfi_wait_for_ack skips firmware error messages and replies to
+     * another sequence number): their count and the first one's header, return header and code. */
+    uint32_t skipped,skipped_header,skipped_ret,skipped_code;
+} AdrenoHfi;
+/* Modern (nonlegacy) GMU HFI only. Caller owns an exclusive, 16KiB extent
+ * mapped with four native4K pages, coherent for CPU and GMU, and a valid 32bit
+ * GMU IOVA. Coherence, ownership and active mappings are platform obligations,
+ * not established by this API. The GMU MUST be stopped and unable to access
+ * this extent during initialization. No reset of a running queue is allowed.
+ * AArch64 little-endian; real outer-shareable barriers, no fake ACKs.
+ * All calls on an instance are serialized by the caller. Shared memory,
+ * object and message/output storage must be disjoint and remain owned.
+ * Never free/reuse shared storage until an external real stop+TLB drain is
+ * proved. Poison/timeout/notify failure do not establish safe release. */
+AdrenoHfiStatus AdrenoHfiInitializeStopped(AdrenoHfi *,volatile uint32_t *,
+    size_t shared_bytes,uint64_t iova,void *cookie,int (*notify)(void *));
+/* payload excludes the wire header. One command may be outstanding. A failed
+ * notify after publishing is indeterminate: poisons the session, no retry.
+ * NoSpace/Busy refuse before publishing. No firmware readiness is inferred. */
+AdrenoHfiStatus AdrenoHfiSend(AdrenoHfi *,unsigned id,const uint32_t *payload,
+    size_t payload_words,uint32_t *wire_header);
+/* Poll the response queue. As a6xx_hfi_wait_for_ack: the reply whose return
+ * header carries the pending command's sequence number completes it (error=0
+ * succeeds, otherwise FirmwareError); F2H error messages and replies to other
+ * sequence numbers are consumed, counted and skipped. payload_words reports
+ * actual returned words; output remains untouched on failure. Capacity must be
+ * >=16, the protocol's maximum ACK payload. Empty keeps the pending command.
+ * Malformed queues or packets poison the session; no success or queue reset is
+ * synthesized. Debug queue not drained. */
+AdrenoHfiStatus AdrenoHfiPoll(AdrenoHfi *,uint32_t *payload,size_t capacity,
+    size_t *payload_words,uint32_t *firmware_error);
+/* Serialized command + bounded response polling. Poll budget limits software
+ * iterations, not hardware elapsed microseconds. Optional wait callback must
+ * return promptly; an error poisons the session. Timeout also poisons it.
+ * This transport alone performs no power/firmware/performance-table startup. */
+AdrenoHfiStatus AdrenoHfiExchange(AdrenoHfi *,unsigned id,const uint32_t *,size_t,
+    unsigned poll_budget,int (*wait_once)(void *),uint32_t *,size_t,
+    size_t *,uint32_t *firmware_error);
+
+/* ---- AdrenoHfiStartup.h ---- */
+/* Modern A6xx/A7xx wire profile, plus the A8xx performance table (table_format 1: a8xx_hfi_send_perf_table, message
+ * HFI_H2F_MSG_TABLE type GPU_PERF with a dependency vote per GPU level). Legacy formats are excluded. */
+typedef struct {uint64_t hz;uint32_t vote;} AdrenoHfiPerformanceLevel;
+typedef struct {
+    unsigned gpu_count,gmu_count;
+    AdrenoHfiPerformanceLevel gpu[16],gmu[4];
+    unsigned bandwidth_count,cnoc_count,ddr_count;
+    uint32_t cnoc_wait_mask,ddr_wait_mask;
+    uint32_t cnoc_addresses[6],cnoc_data[2][6];
+    uint32_t ddr_addresses[8],ddr_data[16][8];
+    uint32_t acd_version,acd_enable_mask,acd_stride,acd_count,acd_data[32];
+    unsigned enable_ifpc;
+    /* Appended so a zeroed config stays the A7xx profile. 0: PERF_TABLE (message 4) with gpu_dependency all zero.
+     * 1: TABLE (message 15) with gpu_dependency[0]=0xffffffff (off) and a nonzero vote per active GPU level. */
+    unsigned table_format;
+    uint32_t gpu_dependency[16];
+} AdrenoHfiStartupConfig;
+typedef enum {
+    AdrenoHfiStageNone,AdrenoHfiStagePerformance,AdrenoHfiStageBandwidth,
+    AdrenoHfiStageAcdEnable,AdrenoHfiStageAcdTable,AdrenoHfiStageIfpc,
+    AdrenoHfiStageCoreStart,AdrenoHfiStageStart,AdrenoHfiStageComplete
+} AdrenoHfiStartupStage;
+typedef enum {
+    AdrenoHfiStartupSuccess,AdrenoHfiStartupInvalid,AdrenoHfiStartupBusy,
+    AdrenoHfiStartupPoisoned,AdrenoHfiStartupClockError,AdrenoHfiStartupWaitError,
+    AdrenoHfiStartupTimeout,AdrenoHfiStartupPlatformFault,AdrenoHfiStartupTransportError
+} AdrenoHfiStartupStatus;
+typedef struct {
+    void *cookie;
+    int (*now_us)(void *,uint64_t *);
+    int (*wait_us)(void *,unsigned);
+    int (*check_health)(void *); /* real platform fault/ownership checks */
+    unsigned polls_per_command,wait_interval_us;
+    uint64_t command_timeout_us,total_timeout_us;
+} AdrenoHfiStartupServices;
+typedef struct {unsigned attempted,poisoned,completed;} AdrenoHfiStartup;
+typedef struct {
+    AdrenoHfiStartupStage stage;
+    AdrenoHfiStatus transport_status;
+    uint32_t firmware_error,wire_header,acknowledged_stages;
+    unsigned published_commands,poll_reads,resources_must_retain;
+    uint64_t elapsed_us;
+} AdrenoHfiStartupResult;
+/* Validate every input before any queue publication. Frequencies include the
+ * zero/off entry, are strictly ascending, exactly representable in wire kHz.
+ * Votes and command-db addresses are trusted platform inputs, never guessed
+ * by this library. ACD entries are packed for each enabled GPU level; AOSS
+ * notification and IFPC power prerequisites must already be established.
+ * Unused fixed-capacity slots must be zero. This prevents silently ignoring
+ * unsupported or malformed configuration. No input is authenticated here. */
+AdrenoHfiStartupStatus AdrenoHfiStartupValidate(const AdrenoHfiStartupConfig *);
+AdrenoHfiStartupStatus AdrenoHfiStartupValidateServices(const AdrenoHfiStartupServices *);
+/* Payload excludes header. All output storage must be disjoint from inputs.
+ * Encodes one selected stage; unused optional stages refuse. Failure leaves
+ * payload/header outputs untouched except word_count=0. Capacity >=159. */
+AdrenoHfiStartupStatus AdrenoHfiStartupEncode(const AdrenoHfiStartupConfig *,
+    AdrenoHfiStartupStage,uint32_t *id,uint32_t *payload,size_t capacity,size_t *word_count);
+/* Single attempt, serialized, caller-owned zero-initialized state. Requires
+ * a real ready GMU, exclusive coherent HFI allocation and active native4K GMU
+ * mappings. Only matching actual ACKs advance the startup sequence. All
+ * commands and the whole sequence have monotonic-time AND iteration bounds.
+ * Callback operations must themselves be bounded. On any attempted-sequence
+ * failure the transport is poisoned; no replay, synthetic ACK or implicit
+ * stop occurs. Even success does not authorize resource release or prove GPU
+ * execution, power/coherence/SMMU readiness, shader submission or a desktop.
+ * Input, state, services, transport, result and shared queues must remain
+ * disjoint and pinned; config remains immutable throughout the sequence. */
+AdrenoHfiStartupStatus AdrenoHfiStartupRun(AdrenoHfiStartup *,AdrenoHfi *,
+    const AdrenoHfiStartupConfig *,const AdrenoHfiStartupServices *,AdrenoHfiStartupResult *);
+
+/* ---- AdrenoHfiVotes.h ---- */
+/* CPU-side generation only, no RPMh transaction or power transition.
+ * Input levels are from exact enabled OPPs (including off=0), not frequencies
+ * or voltages. Rail byte spans are original little-endian cmd-db aux data.
+ * Caller selects actual primary/secondary rails (including GMxC discovery).
+ * Rail profile: off at entry zero, ascending active levels (duplicates allowed),
+ * optional zero padding at the end. Other profiles explicitly refuse.
+ * Supports <=256 rail entries, <=16 OPPs; no truncation or guessed fallback.
+ * Output remains unchanged on failure. Inputs/outputs must be disjoint and
+ * immutable during calls. Successful arithmetic does not authenticate inputs. */
+AdrenoHfiStartupStatus AdrenoHfiArcVotes(const uint32_t *levels,size_t level_count,
+    const uint8_t *primary,size_t primary_bytes,const uint8_t *secondary,size_t secondary_bytes,
+    uint32_t *votes,size_t capacity);
+/* A8xx dependency (MX) votes, a6xx_gmu_rpmh_dep_votes_init: 0xffffffff for the off level, then for each active
+ * level (0x3fff << 14) | (index << 8) | 0xff, index the first MX rail entry at or above the level. Same level and rail
+ * profile rules as AdrenoHfiArcVotes; a level above the rail refuses. Output unchanged on failure. */
+AdrenoHfiStartupStatus AdrenoHfiDependencyVotes(const uint32_t *levels,size_t level_count,
+    const uint8_t *mx,size_t mx_bytes,uint32_t *votes,size_t capacity);
+typedef struct {
+    uint32_t address,unit;
+    uint16_t width,buswidth;
+    uint8_t vcd,fixed;
+    uint16_t perfmode;
+    uint32_t perfmode_kbps;
+    /* Appended: 1 votes a fixed BCM's perfmode on every nonzero bandwidth, as a6xx_gmu_rpmh_bw_votes_init does for
+     * every non-A7xx GPU (A8xx included); perfmode_kbps is then not used. 0 keeps the A7xx threshold rule. */
+    uint8_t perfmode_all;
+} AdrenoHfiBcm;
+/* Decode exactly eight bytes of BCM aux data; address/buswidth/fixed/perfmode
+ * are separately supplied source/platform policy and are preserved. */
+AdrenoHfiStartupStatus AdrenoHfiBcmAux(AdrenoHfiBcm *,const uint8_t *,size_t);
+/* A7xx BCM arithmetic and modern HFI bandwidth layout. Off=0, then strictly
+ * ascending KB/s OPP bandwidths, <=16. Up to three platform-ordered BCMs;
+ * CN0 address must come from command-db. No source fallback address exists.
+ * Unit/width come from BCM aux; buswidth/fixed/perfmode from target catalog.
+ * Fills only bandwidth-related config fields, preserving performance/features.
+ * Failure leaves the entire config unchanged. Success requires no HFI/device.
+ * Does not validate actual rail/BCM ownership, limits, speed bin or power. */
+AdrenoHfiStartupStatus AdrenoHfiBuildBandwidth(const uint32_t *kbps,size_t level_count,
+    const AdrenoHfiBcm *bcms,size_t bcm_count,uint32_t cn0_address,AdrenoHfiStartupConfig *);
+#endif /* SWEET_A810_HFI_H */
diff --git a/bsd/dev/sweet_a810_smmu.c b/bsd/dev/sweet_a810_smmu.c
new file mode 100644
index 0000000..d12bf7d
--- /dev/null
+++ b/bsd/dev/sweet_a810_smmu.c
@@ -0,0 +1,1001 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Nothing Phone (3a) "asteroids": the GMU's own SMMU context (Adreno 810 bring-up, mode 5). See sweet_a810_smmu.h.
+ *
+ * Ported from (MIT):
+ *   rootstockos ArmSmmu4K (Copyright (c) 2026 ArmSmmu4K contributors): ArmSmmu4KContext.c (EncodeContext,
+ *     ValidateContextReadback), ArmSmmu4KProgram.c (ProgramDisabledContext, ObserveOwnedContext, the TLB sync,
+ *     SynchronizeOwnedContext), ArmSmmu4KStreams.c (AttachStreams, ObserveStreams), ArmSmmu4KLive.c (layout, walk,
+ *     descriptor: the fixed native4K topology LivePrepare builds and LiveAudit checks), ArmSmmu4KMmio.c;
+ *   NativeAdreno, branch asteroids 60f16a6 (Copyright (c) 2026 NativeAdreno contributors): NativeAdrenoGmuContext.cpp
+ *     (bringUp: allocate, prepare, program, attach, VM attach, map, ready), NativeAdrenoGmuMemory.cpp (adopt: the payload
+ *     sizes, their order in the pool and their fixed GMU addresses; the map permissions), NativeAdrenoSmmuContext.cpp
+ *     (the context configuration: coherent walk, no stall, continue after fault), NativeAdrenoSmmuMemory.cpp.
+ * Differences from the originals, all mechanical: C instead of C++ classes, one region (lower, TTBR0) only, the
+ * NativeAdrenoVm map of the five payloads is one leaf-writing transaction (every leaf checked empty first, the whole
+ * graph audited after, then the ASID synchronised, as ArmSmmu4KLiveUpdateContextBatch does), the table pool is published
+ * with dsb sy (the pool is mapped Normal non-cacheable), and 64-bit registers are accessed as two 32-bit halves.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include "sweet_a810_smmu.h"
+
+#define PAGE_4K         UINT64_C(4096)
+#define PA_MASK         UINT64_C(0x0000fffffffff000)
+#define FSR_FAULT       UINT32_C(0xc00001fe)
+#define S2CR_FAULT      (UINT32_C(2) << 16)
+
+/* ArmSmmu4KStatus */
+enum {Ok = 0, Argument, BadRange, Overlap, Capacity, Budget, Unsupported, StateMismatch, IoError, Timeout, Busy, Fault};
+
+const char *
+a810_smmu_status_text(uint32_t status)
+{
+	static const char *const text[] = {"ok", "argument", "bad-range", "overlap", "capacity", "budget", "unsupported",
+		                           "state-mismatch", "io", "timeout", "busy", "fault"};
+	return status < sizeof text / sizeof text[0] ? text[status] : "?";
+}
+
+/* ---- MMIO (ArmSmmu4KMmio.c): volatile 32-bit accesses, each followed by dsb sy ---- */
+struct smmu_io {
+	volatile uint8_t *base;
+	size_t bytes;
+};
+static inline void
+dsb_sy(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+static int
+io_fits(const struct smmu_io *io, size_t at, size_t bytes)
+{
+	return io && io->base && !(at & 3) && at <= io->bytes && bytes <= io->bytes - at;
+}
+static int
+io_read32(const struct smmu_io *io, size_t at, uint32_t *out)
+{
+	if (!out || !io_fits(io, at, 4)) {
+		return 1;
+	}
+	*out = *(volatile uint32_t *)(uintptr_t)(io->base + at);
+	dsb_sy();
+	return 0;
+}
+static int
+io_write32(const struct smmu_io *io, size_t at, uint32_t value)
+{
+	if (!io_fits(io, at, 4)) {
+		return 1;
+	}
+	*(volatile uint32_t *)(uintptr_t)(io->base + at) = value;
+	dsb_sy();
+	return 0;
+}
+/* 64-bit registers (TTBRn) as two 32-bit halves, low word first. */
+static int
+io_read64(const struct smmu_io *io, size_t at, uint64_t *out)
+{
+	uint32_t lo, hi;
+	if (!out || (at & 7) || io_read32(io, at, &lo) || io_read32(io, at + 4, &hi)) {
+		return 1;
+	}
+	*out = (uint64_t)hi << 32 | lo;
+	return 0;
+}
+static int
+io_write64(const struct smmu_io *io, size_t at, uint64_t value)
+{
+	if (at & 7) {
+		return 1;
+	}
+	return io_write32(io, at, (uint32_t)value) || io_write32(io, at + 4, (uint32_t)(value >> 32));
+}
+static int
+io_barrier(const struct smmu_io *io)
+{
+	(void)io;
+	dsb_sy();
+	return 0;
+}
+
+/* ---- Tables (ArmSmmu4K.h types, ArmSmmu4KLive.c) ---- */
+struct tbl_config {
+	unsigned input_bits, output_bits;
+	uint64_t table_physical;
+	size_t leaf_budget;
+};
+struct tbl_result {
+	uint64_t root_physical, mair;
+	size_t table_pages, leaf_pages;
+	unsigned start_level, upper_region;
+};
+enum {PERM_READ = 1, PERM_WRITE = 2, PERM_EXECUTE = 4, PERM_PRIVILEGED = 8};
+struct tbl_range {
+	uint64_t iova, physical, bytes;
+	unsigned permissions, writeback, shareability;
+};
+struct live_arena {
+	struct tbl_config config;
+	uint64_t iova, bytes;
+	volatile uint64_t *mapping;            /* the pool's write-combined CPU mapping */
+	size_t capacity_pages;
+};
+
+static int
+output_width(unsigned bits)
+{
+	return bits == 32 || bits == 36 || bits == 40 || bits == 42 || bits == 44 || bits == 48;
+}
+/* ArmSmmu4KLive.c layout(), lower region only */
+static int
+live_layout(const struct live_arena *a, struct tbl_result *out)
+{
+	if (!a || !a->mapping || ((uintptr_t)a->mapping & 4095) || a->config.input_bits < 32 || a->config.input_bits > 48 ||
+	    !output_width(a->config.output_bits) || !a->config.leaf_budget || !a->capacity_pages ||
+	    a->capacity_pages > SIZE_MAX / 4096) {
+		return Argument;
+	}
+	uint64_t limit = UINT64_C(1) << a->config.input_bits;
+	uint64_t physical_limit = UINT64_C(1) << a->config.output_bits;
+	if (!a->bytes || ((a->iova | a->bytes | a->config.table_physical) & 4095) || a->iova >= limit ||
+	    a->bytes > limit - a->iova || a->config.table_physical >= physical_limit ||
+	    a->capacity_pages * PAGE_4K > physical_limit - a->config.table_physical) {
+		return BadRange;
+	}
+	if (a->bytes / PAGE_4K > a->config.leaf_budget) {
+		return Budget;
+	}
+	unsigned start = 4 - (a->config.input_bits - 12 + 8) / 9;
+	uint64_t low = a->iova, high = low + a->bytes - 1;
+	size_t pages = 1;
+	for (unsigned level = start; level < 3; ++level) {
+		unsigned shift = 39 - 9 * level;
+		pages += (size_t)((high >> shift) - (low >> shift) + 1);
+	}
+	if (pages > a->capacity_pages) {
+		return Capacity;
+	}
+	*out = (struct tbl_result){a->config.table_physical, 0xff44, pages, 0, start, 0};
+	return Ok;
+}
+/* ArmSmmu4KLive.c descriptor(): AF, nG, page, SH, AP[1] (unprivileged), AP[2] (read-only), XN, AttrIndx 1 (WB) or 0 (NC) */
+static uint64_t
+leaf_descriptor(const struct tbl_range *r, uint64_t iova)
+{
+	uint64_t attrs = (1u << 11) | (1u << 10) | 3u | ((uint64_t)r->shareability << 8);
+	if (!(r->permissions & PERM_EXECUTE)) {
+		attrs |= UINT64_C(3) << 53;
+	}
+	if (!(r->permissions & PERM_PRIVILEGED)) {
+		attrs |= 1u << 6;
+	}
+	if (!(r->permissions & PERM_WRITE)) {
+		attrs |= 1u << 7;
+	}
+	if (r->writeback) {
+		attrs |= 1u << 2;
+	}
+	return (r->physical + (iova - r->iova)) | attrs;
+}
+static const struct tbl_range *
+find_range(const struct tbl_range *ranges, size_t count, uint64_t iova)
+{
+	for (size_t i = 0; i < count; ++i) {
+		if (iova >= ranges[i].iova && iova - ranges[i].iova < ranges[i].bytes) {
+			return &ranges[i];
+		}
+	}
+	return NULL;
+}
+/* ArmSmmu4KLive.c walk(): build (zero leaves, every intermediate table preallocated in depth-first order) or verify
+ * (every descriptor equals what the topology and `ranges` give). Plain volatile 64-bit stores, never memset. */
+static int
+live_walk(const struct live_arena *a, const struct tbl_result *shape, unsigned level, size_t page, uint64_t prefix,
+    size_t *next, int build, const struct tbl_range *ranges, size_t count, uint32_t *leaves)
+{
+	uint64_t limit = UINT64_C(1) << a->config.input_bits;
+	uint64_t low = a->iova, high = low + a->bytes - 1;
+	unsigned shift = 39 - 9 * level;
+	unsigned width = level == shape->start_level ? a->config.input_bits - shift : 9;
+	(void)limit;
+	for (unsigned slot = 0; slot < 512; ++slot) {
+		uint64_t begin = prefix + ((uint64_t)slot << shift), value = 0;
+		int reserved = slot < (1u << width) && begin <= high && low < begin + (UINT64_C(1) << shift);
+		size_t child = 0;
+		if (level < 3 && reserved) {
+			child = (*next)++;
+			if (child >= shape->table_pages) {
+				return StateMismatch;
+			}
+			value = (a->config.table_physical + child * PAGE_4K) | 3u;
+		} else if (level == 3 && reserved && !build) {
+			const struct tbl_range *r = find_range(ranges, count, begin);
+			value = r ? leaf_descriptor(r, begin) : 0;
+			if (r && leaves) {
+				++*leaves;
+			}
+		}
+		size_t index = page * 512 + slot;
+		if (build) {
+			a->mapping[index] = value;
+		} else if (a->mapping[index] != value) {
+			return StateMismatch;
+		}
+		if (level < 3 && reserved) {
+			int status = live_walk(a, shape, level + 1, child, begin, next, build, ranges, count, leaves);
+			if (status != Ok) {
+				return status;
+			}
+		}
+	}
+	return Ok;
+}
+/* ArmSmmu4KLive.c leaf_index(): the level-3 slot of `va`, through the table path the descriptors give. */
+static int
+live_leaf_index(const struct live_arena *a, const struct tbl_result *shape, uint64_t va, size_t *index)
+{
+	size_t page = 0;
+	for (unsigned level = shape->start_level; level < 3; ++level) {
+		unsigned shift = 39 - 9 * level;
+		unsigned width = level == shape->start_level ? a->config.input_bits - shift : 9;
+		uint64_t entry = a->mapping[page * 512 + ((va >> shift) & ((1u << width) - 1))];
+		if ((entry & 3) != 3) {
+			return StateMismatch;
+		}
+		uint64_t pa = entry & PA_MASK;
+		if (pa < a->config.table_physical || (pa - a->config.table_physical) / PAGE_4K >= shape->table_pages) {
+			return StateMismatch;
+		}
+		page = (size_t)((pa - a->config.table_physical) / PAGE_4K);
+	}
+	*index = page * 512 + ((va >> 12) & 511);
+	return Ok;
+}
+
+/* ---- Context image (ArmSmmu4KContext.c) ---- */
+struct ctx_config {
+	const struct tbl_config *lower;
+	const struct tbl_result *lower_tables;
+	uint32_t id0, id2;
+	unsigned asid, coherent_walk, stall_on_fault, continue_after_fault;
+};
+static int
+width_code(unsigned bits)
+{
+	switch (bits) {
+	case 32: return 0;
+	case 36: return 1;
+	case 40: return 2;
+	case 42: return 3;
+	case 44: return 4;
+	case 48: return 5;
+	default: return -1;
+	}
+}
+static unsigned
+width_bits(unsigned code)
+{
+	static const unsigned bits[] = {32, 36, 40, 42, 44, 48};
+	return code < 6 ? bits[code] : 0;
+}
+static int
+region_valid(const struct tbl_config *c, const struct tbl_result *r)
+{
+	if (!c || !r) {
+		return 0;
+	}
+	if (c->input_bits < 32 || c->input_bits > 48 || width_code(c->output_bits) < 0 || (c->table_physical & 4095) ||
+	    r->root_physical != c->table_physical || r->mair != 0xff44 || r->upper_region || !r->table_pages ||
+	    r->leaf_pages > c->leaf_budget || r->start_level != 4 - (c->input_bits - 12 + 8) / 9) {
+		return 0;
+	}
+	uint64_t limit = UINT64_C(1) << c->output_bits;
+	return r->root_physical < limit && (uint64_t)r->table_pages * 4096 <= limit - r->root_physical;
+}
+static int
+encode_context(const struct ctx_config *c, struct a810_smmu_image *out)
+{
+	*out = (struct a810_smmu_image){0};
+	if (!c || !c->lower || c->asid > 65535 || c->coherent_walk > 1 || c->stall_on_fault > 1 ||
+	    c->continue_after_fault > 1 || !region_valid(c->lower, c->lower_tables)) {
+		return Argument;
+	}
+	unsigned va = width_bits((c->id2 >> 8) & 15), pa = width_bits((c->id2 >> 4) & 15);
+	if (!(c->id0 & (UINT32_C(1) << 30)) || !(c->id2 & (1u << 12)) || !va || !pa) {
+		return Unsupported;
+	}
+	if (c->lower->output_bits > pa || c->lower->input_bits > va) {
+		return Unsupported;
+	}
+	struct a810_smmu_image v = {0};
+	v.cbar = 0x1f300;                      /* stage 1 translation, stage 2 bypass; weakest bypass attributes */
+	v.cba2r = 1;                           /* AArch64 */
+	v.tcr = UINT32_C(2) << 30;             /* TG1 = 4K, TG0 = 4K */
+	v.tcr |= (c->coherent_walk ? 0x3500u : 0x2000u) | (64 - c->lower->input_bits);
+	v.tcr |= 1u << 23;                     /* EPD1: no upper region */
+	v.tcr2 = (7u << 15) | (1u << 4) | (unsigned)width_code(c->lower->output_bits);
+	v.ttbr0 = (uint64_t)c->asid << 48 | c->lower_tables->root_physical;
+	v.ttbr1 = (uint64_t)c->asid << 48;
+	v.mair0 = 0xff44;
+	v.mair1 = 0;
+	v.sctlr = 0x1067 | (c->stall_on_fault << 7) | (c->continue_after_fault << 8);
+	*out = v;
+	return Ok;
+}
+/* TCR2.TBI0/1 may read 1 for 0 and SCTLR.ASIDPNE 0 for 1 on the Adreno MMU-500 (ArmSmmu4KValidateContextReadback). */
+static int
+validate_readback(const struct ctx_config *c, const struct a810_smmu_image *observed)
+{
+	struct a810_smmu_image e;
+	int status = encode_context(c, &e);
+	if (status != Ok) {
+		return status;
+	}
+	const uint32_t tbi_set = observed->tcr2 & ~e.tcr2 & UINT32_C(0x60);
+	const uint32_t asidpne_clear = e.sctlr & ~observed->sctlr & UINT32_C(0x1000);
+	if (e.cbar != observed->cbar || e.cba2r != observed->cba2r || e.tcr != observed->tcr ||
+	    ((e.tcr2 ^ observed->tcr2) & ~tbi_set) || e.mair0 != observed->mair0 || e.mair1 != observed->mair1 ||
+	    ((e.sctlr ^ observed->sctlr) & ~asidpne_clear) || observed->reserved_zero || e.ttbr0 != observed->ttbr0 ||
+	    e.ttbr1 != observed->ttbr1) {
+		return StateMismatch;
+	}
+	return Ok;
+}
+
+/* ---- Context bank programming (ArmSmmu4KProgram.c) ---- */
+struct program_result {
+	uint64_t context_offset;
+	uint32_t id0, id1, id2, phase, writes, poll_reads, fault_status;
+	uint32_t readback_valid, enabled, tlb_synchronized;
+	struct a810_smmu_image readback;
+};
+static int
+read_image(const struct smmu_io *io, size_t gr1, size_t cb, unsigned bank, struct a810_smmu_image *v)
+{
+	v->reserved_zero = 0;
+	return io_read32(io, gr1 + bank * 4, &v->cbar) || io_read32(io, gr1 + 0x800 + bank * 4, &v->cba2r) ||
+	       io_read32(io, cb + 0x30, &v->tcr) || io_read32(io, cb + 0x10, &v->tcr2) || io_read64(io, cb + 0x20, &v->ttbr0) ||
+	       io_read64(io, cb + 0x28, &v->ttbr1) || io_read32(io, cb + 0x38, &v->mair0) ||
+	       io_read32(io, cb + 0x3c, &v->mair1) || io_read32(io, cb, &v->sctlr);
+}
+static int
+pw32(const struct smmu_io *io, size_t at, uint32_t value, struct program_result *r)
+{
+	++r->writes;
+	return io_write32(io, at, value);
+}
+static int
+pw64(const struct smmu_io *io, size_t at, uint64_t value, struct program_result *r)
+{
+	++r->writes;
+	return io_write64(io, at, value);
+}
+/* TLBIASID (+0x610) or TLBIALL (+0x618), then TLBSYNC (+0x7f0) and TLBSTATUS (+0x7f4) within `budget` reads. */
+static int
+sync_tlb(const struct smmu_io *io, size_t cb, unsigned asid, unsigned all, unsigned budget, struct program_result *r)
+{
+	r->tlb_synchronized = 0;
+	if (io_barrier(io) || pw32(io, cb + (all ? 0x618 : 0x610), all ? 0 : asid, r) || pw32(io, cb + 0x7f0, UINT32_MAX, r) ||
+	    io_barrier(io)) {
+		return IoError;
+	}
+	for (unsigned i = 0; i < budget; ++i) {
+		uint32_t status;
+		++r->poll_reads;
+		if (io_read32(io, cb + 0x7f4, &status)) {
+			return IoError;
+		}
+		if (!(status & 1)) {
+			io_barrier(io);
+			r->tlb_synchronized = 1;
+			return Ok;
+		}
+	}
+	return Timeout;
+}
+static int
+disable_sync(const struct smmu_io *io, size_t cb, unsigned asid, unsigned budget, struct program_result *r)
+{
+	uint32_t value;
+	if (pw32(io, cb, 0, r) || io_barrier(io) || io_read32(io, cb, &value)) {
+		return IoError;
+	}
+	if (value) {
+		return StateMismatch;
+	}
+	r->enabled = 0;
+	return sync_tlb(io, cb, asid, 0, budget, r);
+}
+static int
+program_prepare(const struct smmu_io *io, unsigned bank, const struct ctx_config *config, unsigned budget,
+    struct program_result *r, struct ctx_config *actual, struct a810_smmu_image *image, size_t *gr1)
+{
+	*r = (struct program_result){0};
+	if (!io || !config || io->bytes < 0x2c || !budget || budget > 1048576 || bank > 255) {
+		return Argument;
+	}
+	r->phase = 1;
+	if (io_read32(io, 0x20, &r->id0) || io_read32(io, 0x24, &r->id1) || io_read32(io, 0x28, &r->id2)) {
+		return IoError;
+	}
+	unsigned shift = (r->id1 >> 31) ? 16 : 12;
+	size_t pages = (size_t)1 << (((r->id1 >> 28) & 7) + 1);
+	size_t stride = (size_t)1 << shift;
+	unsigned banks = r->id1 & 255, s2 = (r->id1 >> 16) & 255;
+	if (!banks || banks > pages || s2 > banks || bank < s2 || bank >= banks || io->bytes < 2 * pages * stride) {
+		return Unsupported;
+	}
+	*gr1 = stride;
+	r->context_offset = (pages + bank) * stride;
+	if (r->context_offset > io->bytes || io->bytes - r->context_offset < 0x7f8 || *gr1 + 0x804 + bank * 4 > io->bytes) {
+		return BadRange;
+	}
+	*actual = *config;
+	actual->id0 = r->id0;
+	actual->id2 = r->id2;
+	return encode_context(actual, image);
+}
+/* ArmSmmu4KProgramDisabledContext: a disabled bank only; TCR2/TCR before the TTBRs; ASID invalidated and synchronised;
+ * the image read back and checked while SCTLR.M is 0; then enabled and checked again. On failure the bank is disabled. */
+static int
+program_disabled_context(const struct smmu_io *io, unsigned bank, const struct ctx_config *config, unsigned budget,
+    struct program_result *r)
+{
+	struct ctx_config actual;
+	struct a810_smmu_image image;
+	size_t gr1 = 0;
+	int status = program_prepare(io, bank, config, budget, r, &actual, &image, &gr1);
+	if (status != Ok) {
+		return status;
+	}
+	size_t cb = (size_t)r->context_offset;
+	uint32_t sctlr;
+	if (io_read32(io, cb, &sctlr)) {
+		return IoError;
+	}
+	if (sctlr & 1) {
+		r->enabled = 1;
+		return Busy;
+	}
+	r->phase = 2;
+	if (pw32(io, cb, 0, r) || io_barrier(io) || pw32(io, gr1 + 0x800 + bank * 4, image.cba2r, r) ||
+	    pw32(io, gr1 + bank * 4, image.cbar, r) || pw32(io, cb + 0x10, image.tcr2, r) || pw32(io, cb + 0x30, image.tcr, r) ||
+	    pw64(io, cb + 0x20, image.ttbr0, r) || pw64(io, cb + 0x28, image.ttbr1, r) || pw32(io, cb + 0x38, image.mair0, r) ||
+	    pw32(io, cb + 0x3c, image.mair1, r) || pw32(io, cb + 0x58, UINT32_MAX, r)) {
+		status = IoError;
+		goto failed;
+	}
+	status = sync_tlb(io, cb, actual.asid, 0, budget, r);
+	if (status != Ok) {
+		goto failed;
+	}
+	r->phase = 3;
+	if (read_image(io, gr1, cb, bank, &r->readback)) {
+		status = IoError;
+		goto failed;
+	}
+	r->readback_valid = 1;
+	sctlr = r->readback.sctlr;
+	r->readback.sctlr = image.sctlr;
+	status = validate_readback(&actual, &r->readback);
+	r->readback.sctlr = sctlr;
+	if (status != Ok || sctlr) {
+		status = StateMismatch;
+		goto failed;
+	}
+	r->readback_valid = 0;
+	if (io_barrier(io) || pw32(io, cb, image.sctlr, r) || io_barrier(io)) {
+		status = IoError;
+		goto failed;
+	}
+	r->phase = 4;
+	if (read_image(io, gr1, cb, bank, &r->readback)) {
+		status = IoError;
+		goto failed;
+	}
+	r->readback_valid = 1;
+	r->enabled = r->readback.sctlr & 1;
+	if (io_read32(io, cb + 0x58, &r->fault_status)) {
+		status = IoError;
+		goto failed;
+	}
+	status = validate_readback(&actual, &r->readback);
+	if (status != Ok) {
+		goto failed;
+	}
+	if (r->fault_status & FSR_FAULT) {
+		status = Fault;
+		goto failed;
+	}
+	r->phase = 5;
+	r->enabled = 1;
+	return Ok;
+failed:
+	r->readback_valid = 0;
+	(void)disable_sync(io, cb, actual.asid, budget, r);
+	r->phase = 6;
+	return status;
+}
+static int
+observe_owned_context(const struct smmu_io *io, unsigned bank, const struct ctx_config *config, struct program_result *r)
+{
+	struct ctx_config actual;
+	struct a810_smmu_image image;
+	size_t gr1 = 0;
+	int status = program_prepare(io, bank, config, 1, r, &actual, &image, &gr1);
+	if (status != Ok) {
+		return status;
+	}
+	if (read_image(io, gr1, (size_t)r->context_offset, bank, &r->readback)) {
+		return IoError;
+	}
+	r->readback_valid = 1;
+	r->enabled = r->readback.sctlr & 1;
+	status = validate_readback(&actual, &r->readback);
+	if (status != Ok) {
+		return status;
+	}
+	if (io_read32(io, (size_t)r->context_offset + 0x58, &r->fault_status)) {
+		return IoError;
+	}
+	if (r->fault_status & FSR_FAULT) {
+		return Fault;
+	}
+	r->phase = 8;
+	return Ok;
+}
+/* ArmSmmu4KSynchronizeOwnedContext: observe, TLBIASID + sync, observe again. */
+static int
+synchronize_owned_context(const struct smmu_io *io, unsigned bank, const struct ctx_config *config, unsigned budget,
+    struct program_result *r)
+{
+	int status = observe_owned_context(io, bank, config, r);
+	if (status != Ok) {
+		return status;
+	}
+	status = sync_tlb(io, (size_t)r->context_offset, config->asid, 0, budget, r);
+	if (status != Ok) {
+		return status;
+	}
+	struct program_result after;
+	status = observe_owned_context(io, bank, config, &after);
+	r->readback = after.readback;
+	r->fault_status = after.fault_status;
+	r->enabled = after.enabled;
+	if (status != Ok) {
+		return status;
+	}
+	if (r->id0 != after.id0 || r->id1 != after.id1 || r->id2 != after.id2 || r->context_offset != after.context_offset) {
+		return StateMismatch;
+	}
+	r->phase = 9;
+	return Ok;
+}
+
+/* ---- Stream routing (ArmSmmu4KStreams.c), legacy and EXIDS layouts ---- */
+struct stream {
+	unsigned slot;
+	uint16_t sid;
+};
+struct stream_state {
+	unsigned attempted, attached, poisoned, count, bank;
+	uint32_t id0, scr0;
+	struct stream streams[1];
+};
+struct stream_result {
+	unsigned phase, reads, writes, streams_verified, streams_faulted;
+	uint32_t id0, scr0, global_fault;
+	struct program_result context;
+};
+static int
+srd(const struct smmu_io *io, size_t at, uint32_t *v, struct stream_result *r)
+{
+	++r->reads;
+	return io_read32(io, at, v);
+}
+static int
+swr(const struct smmu_io *io, size_t at, uint32_t v, struct stream_result *r)
+{
+	++r->writes;
+	return io_write32(io, at, v);
+}
+static unsigned
+exids(uint32_t id)
+{
+	return (id >> 8) & 1;
+}
+static uint32_t
+valid_smr(uint32_t id)
+{
+	return exids(id) ? 0 : UINT32_C(1) << 31;
+}
+static uint32_t
+valid_s2cr(uint32_t id)
+{
+	return exids(id) ? 1u << 10 : 0;
+}
+static int
+route_valid(uint32_t id, uint32_t smr, uint32_t s2cr)
+{
+	return exids(id) ? !!(s2cr & (1u << 10)) : !!(smr & (UINT32_C(1) << 31));
+}
+/* Reads sCR0 only (never writes it): global enable, global fault reporting and unmatched streams faulting required. */
+static int
+streams_global(const struct smmu_io *io, struct stream_result *r)
+{
+	if (!io || io->bytes < 0xc04) {
+		return Argument;
+	}
+	if (srd(io, 0x20, &r->id0, r) || srd(io, 0, &r->scr0, r) || srd(io, 0x48, &r->global_fault, r)) {
+		return IoError;
+	}
+	if (!(r->id0 & (1u << 27)) || !(r->id0 & 255) || 0xc00u + 4 * (r->id0 & 255) > io->bytes) {
+		return Unsupported;
+	}
+	if ((r->scr0 & 0x407) != 0x406 || !!(r->scr0 & 8) != exids(r->id0)) {
+		return StateMismatch;
+	}
+	return r->global_fault ? Fault : Ok;
+}
+static int
+streams_scan(const struct smmu_io *io, const struct stream *s, unsigned n, unsigned bank, unsigned attached,
+    struct stream_result *r)
+{
+	unsigned slots = r->id0 & 255;
+	uint32_t sidmask = exids(r->id0) ? 0xffffu : (1u << ((r->id0 >> 9) & 15)) - 1;
+	for (unsigned i = 0; i < n; ++i) {
+		if (s[i].slot >= slots || (s[i].sid & ~sidmask)) {
+			return Argument;
+		}
+	}
+	r->streams_verified = 0;
+	for (unsigned slot = 0; slot < slots; ++slot) {
+		uint32_t smr, s2cr;
+		if (srd(io, 0x800 + 4 * slot, &smr, r) || srd(io, 0xc00 + 4 * slot, &s2cr, r)) {
+			return IoError;
+		}
+		unsigned own = n;
+		for (unsigned i = 0; i < n; ++i) {
+			if (s[i].slot == slot) {
+				own = i;
+				break;
+			}
+		}
+		if (own < n) {
+			unsigned live = route_valid(r->id0, smr, s2cr);
+			if (attached) {
+				if (smr != (valid_smr(r->id0) | s[own].sid) || s2cr != (bank | valid_s2cr(r->id0))) {
+					return StateMismatch;
+				}
+			} else if ((s2cr & ~valid_s2cr(r->id0)) != S2CR_FAULT || (live && smr != (valid_smr(r->id0) | s[own].sid))) {
+				return Busy;
+			}
+			++r->streams_verified;
+		} else if (route_valid(r->id0, smr, s2cr)) {
+			if (!(s2cr & (3u << 16)) && (s2cr & 255) == bank) {
+				return Busy;
+			}
+			uint32_t mask = (smr >> 16) & (exids(r->id0) ? 0xffffu : 0x7fffu), id = smr & 0xffff;
+			for (unsigned i = 0; i < n; ++i) {
+				if (!((s[i].sid ^ id) & ~mask & sidmask)) {
+					return Overlap;
+				}
+			}
+		}
+	}
+	return Ok;
+}
+static void
+streams_quarantine(const struct smmu_io *io, const struct stream_state *state, unsigned count, struct stream_result *r)
+{
+	r->streams_faulted = 0;
+	for (unsigned i = 0; i < count; ++i) {
+		size_t at = 0xc00 + 4 * state->streams[i].slot, smr = 0x800 + 4 * state->streams[i].slot;
+		uint32_t value, match = valid_smr(state->id0) | state->streams[i].sid;
+		if (swr(io, at, S2CR_FAULT, r) || srd(io, at, &value, r) || value != S2CR_FAULT ||
+		    swr(io, smr, match, r) || srd(io, smr, &value, r) || value != match ||
+		    swr(io, at, S2CR_FAULT | valid_s2cr(state->id0), r) || srd(io, at, &value, r) ||
+		    value != (S2CR_FAULT | valid_s2cr(state->id0))) {
+			continue;
+		}
+		++r->streams_faulted;
+	}
+}
+static int
+streams_observe(const struct smmu_io *io, const struct stream_state *s, const struct ctx_config *c, struct stream_result *r)
+{
+	int status = streams_global(io, r);
+	if (status) {
+		return status;
+	}
+	if (r->id0 != s->id0 || r->scr0 != s->scr0) {
+		return StateMismatch;
+	}
+	status = observe_owned_context(io, s->bank, c, &r->context);
+	if (status) {
+		return status;
+	}
+	return streams_scan(io, s->streams, s->count, s->bank, 1, r);
+}
+/* ArmSmmu4KAttachStreams: S2CR first, then the exact SMR, each read back; on failure the touched slot goes back to FAULT. */
+static int
+streams_attach(const struct smmu_io *io, struct stream_state *state, const struct stream *s, unsigned bank,
+    const struct ctx_config *c, struct stream_result *r)
+{
+	*r = (struct stream_result){0};
+	if (state->attempted || state->attached || state->poisoned) {
+		return Busy;
+	}
+	r->phase = 1;
+	int status = streams_global(io, r);
+	if (status) {
+		return status;
+	}
+	status = observe_owned_context(io, bank, c, &r->context);
+	if (status) {
+		return status;
+	}
+	status = streams_scan(io, s, 1, bank, 0, r);
+	if (status) {
+		return status;
+	}
+	state->attempted = 1;
+	state->id0 = r->id0;
+	state->scr0 = r->scr0;
+	state->count = 1;
+	state->bank = bank;
+	state->streams[0] = s[0];
+	r->phase = 2;
+	uint32_t value;
+	size_t smr = 0x800 + 4 * s[0].slot, s2cr = 0xc00 + 4 * s[0].slot;
+	if (swr(io, s2cr, bank, r) || srd(io, s2cr, &value, r)) {
+		status = IoError;
+		goto failed;
+	}
+	if (value != bank) {
+		status = StateMismatch;
+		goto failed;
+	}
+	if (swr(io, smr, valid_smr(r->id0) | s[0].sid, r) || srd(io, smr, &value, r)) {
+		status = IoError;
+		goto failed;
+	}
+	if (value != (valid_smr(r->id0) | s[0].sid)) {
+		status = StateMismatch;
+		goto failed;
+	}
+	if (exids(r->id0) && swr(io, s2cr, bank | valid_s2cr(r->id0), r)) {
+		status = IoError;
+		goto failed;
+	}
+	r->phase = 3;
+	status = streams_observe(io, state, c, r);
+	if (status) {
+		goto failed;
+	}
+	state->attached = 1;
+	r->phase = 4;
+	return Ok;
+failed:
+	state->poisoned = 1;
+	state->attached = 0;
+	r->phase = 5;
+	streams_quarantine(io, state, 1, r);
+	return status;
+}
+
+/* ---- The GMU context (NativeAdrenoGmuContext::bringUp, NativeAdrenoGmuAllocator::adopt) ---- */
+static struct {
+	int used, ready;
+	struct smmu_io io;
+	struct live_arena arena;
+	struct tbl_result tables;
+	struct tbl_config config_lower;
+	struct ctx_config config;
+	struct stream_state streams;
+	struct a810_gmu_payload payload[A810_PAYLOADS];
+} gmu_ctx;
+
+int
+a810_gmu_context_payloads(struct a810_gmu_payload out[A810_PAYLOADS])
+{
+	if (!out || !gmu_ctx.ready) {
+		return 1;
+	}
+	for (unsigned i = 0; i < A810_PAYLOADS; ++i) {
+		out[i] = gmu_ctx.payload[i];
+	}
+	return 0;
+}
+
+int
+a810_gmu_context_bringup(volatile uint8_t *smmu, size_t smmu_bytes, uint64_t pool_pa, volatile uint8_t *pool_va,
+    uint64_t pool_bytes, unsigned bank, unsigned asid, unsigned slot, unsigned sid, void (*progress)(uint32_t step),
+    struct a810_gmu_context_report *report)
+{
+	if (!report) {
+		return Argument;
+	}
+	*report = (struct a810_gmu_context_report){0};
+	if (gmu_ctx.used) {
+		return report->status = Busy;
+	}
+	if (!smmu || !smmu_bytes || ((uintptr_t)smmu & 7) || !pool_va || ((uintptr_t)pool_va & 4095) || (pool_pa & 4095) ||
+	    bank > 63 || !asid || asid > 0xffff || slot > 127 || sid > 0xffff) {
+		return report->status = Argument;
+	}
+	gmu_ctx.used = 1;
+	gmu_ctx.io = (struct smmu_io){smmu, smmu_bytes};
+	const struct smmu_io *io = &gmu_ctx.io;
+	int status = Ok;
+#define STEP(s) do {report->step = (s); if (progress) progress(s);} while (0)
+
+	STEP(A810_CTX_ALLOCATE);
+	/* Stage-1 output size is ID2.OAS (arm_smmu_init_domain_context uses smmu->ipa_size), capped at 40 bits. */
+	static const uint8_t oas_bits[16] = {32, 36, 40, 42, 44, 48};
+	if (io_read32(io, 0x28, &report->id2)) {
+		status = IoError;
+	} else {
+		unsigned code = (report->id2 >> 4) & 15;
+		report->output_bits = code < 6 ? oas_bits[code] : 0;
+		if (report->output_bits > 40) {
+			report->output_bits = 40;
+		}
+		if (!report->output_bits) {
+			status = Unsupported;
+		}
+	}
+	/* NativeAdrenoGmuDefaultSizes and adopt(): icache, dummy, debug, log, hfi, then the table pool, one after another in
+	 * the reserved pool; the GMU addresses are allocate()'s. */
+	static const uint64_t sizes[A810_PAYLOADS] = {0xffc000, 0x4000, 0x7000, 0x4000, 0x4000};
+	const uint64_t iovas[A810_PAYLOADS] = {A810_GMU_ICACHE_IOVA, A810_GMU_UNCACHED_IOVA, A810_GMU_DEBUG_IOVA,
+		                               A810_GMU_UNCACHED_IOVA + 0x4000, A810_GMU_UNCACHED_IOVA + 0x4000 + 0x4000};
+	uint64_t at = 0;
+	if (!status) {
+		uint64_t used = (uint64_t)A810_GMU_TABLE_PAGES * PAGE_4K;
+		for (unsigned i = 0; i < A810_PAYLOADS; ++i) {
+			used += sizes[i];
+		}
+		if (used > pool_bytes || pool_pa + used > (UINT64_C(1) << report->output_bits)) {
+			status = Capacity;
+		}
+	}
+	if (!status) {
+		for (unsigned i = 0; i < A810_PAYLOADS; ++i) {
+			gmu_ctx.payload[i] = (struct a810_gmu_payload){pool_pa + at, sizes[i], iovas[i],
+				                                       (volatile uint32_t *)(uintptr_t)(pool_va + at)};
+			at += sizes[i];
+		}
+	}
+	if (!status) {
+		STEP(A810_CTX_PREPARE);
+		gmu_ctx.config_lower = (struct tbl_config){32, report->output_bits, pool_pa + at, (size_t)1 << 19};
+		gmu_ctx.arena = (struct live_arena){gmu_ctx.config_lower, 0, A810_GMU_APERTURE,
+			                            (volatile uint64_t *)(uintptr_t)(pool_va + at), A810_GMU_TABLE_PAGES};
+		status = live_layout(&gmu_ctx.arena, &gmu_ctx.tables);
+		if (!status) {
+			size_t next = 1;
+			status = live_walk(&gmu_ctx.arena, &gmu_ctx.tables, gmu_ctx.tables.start_level, 0, 0, &next, 1, NULL, 0, NULL);
+			if (!status && next != gmu_ctx.tables.table_pages) {
+				status = StateMismatch;
+			}
+		}
+		dsb_sy();                      /* publish the tables (Normal non-cacheable pool) */
+		if (!status) {
+			size_t next = 1;
+			status = live_walk(&gmu_ctx.arena, &gmu_ctx.tables, gmu_ctx.tables.start_level, 0, 0, &next, 0, NULL, 0, NULL);
+			if (!status && next != gmu_ctx.tables.table_pages) {
+				status = StateMismatch;
+			}
+		}
+		/* The adreno SMMU node is dma-coherent, so walks are inner write-back (NativeAdrenoSmmuContext::prepare). */
+		gmu_ctx.config = (struct ctx_config){&gmu_ctx.config_lower, &gmu_ctx.tables, 0, 0, asid, 1, 0, 1};
+	}
+	struct program_result program = {0};
+	if (!status) {
+		STEP(A810_CTX_PROGRAM);
+		status = program_disabled_context(io, bank, &gmu_ctx.config, 1000, &program);
+		report->program_status = (uint32_t)status;
+		report->program_phase = program.phase;
+		report->program_writes = program.writes;
+		report->program_readback_valid = program.readback_valid;
+		report->program_enabled = program.enabled;
+		report->id1 = program.id1;
+		report->image = program.readback;
+		struct ctx_config actual = gmu_ctx.config;
+		struct a810_smmu_image want;
+		actual.id0 = program.id0;
+		actual.id2 = program.id2;
+		if (program.phase >= 3 && encode_context(&actual, &want) == Ok) {
+			const struct a810_smmu_image *got = &program.readback;
+			const uint32_t sctlr_want = program.enabled ? want.sctlr : 0;
+			report->mismatch = (got->cbar != want.cbar) | (got->cba2r != want.cba2r) << 1 | (got->tcr != want.tcr) << 2 |
+			    (got->tcr2 != want.tcr2) << 3 | (got->mair0 != want.mair0) << 4 | (got->mair1 != want.mair1) << 5 |
+			    (got->ttbr0 != want.ttbr0) << 6 | (got->ttbr1 != want.ttbr1) << 7 | (got->sctlr != sctlr_want) << 8;
+		}
+		if (!status) {
+			gmu_ctx.config.id0 = program.id0;
+			gmu_ctx.config.id2 = program.id2;
+		}
+	}
+	if (!status) {
+		STEP(A810_CTX_ATTACH);
+		const struct stream route = {slot, (uint16_t)sid};
+		struct stream_result routes;
+		status = streams_attach(io, &gmu_ctx.streams, &route, bank, &gmu_ctx.config, &routes);
+		report->route_status = (uint32_t)status;
+		report->route_phase = routes.phase;
+		report->route_writes = routes.writes;
+		report->routes_verified = routes.streams_verified;
+	}
+	if (!status) {
+		/* NativeAdrenoVm::attach observes the owned context and routes before the first map. */
+		STEP(A810_CTX_OBSERVE);
+		struct stream_result seen;
+		status = streams_observe(io, &gmu_ctx.streams, &gmu_ctx.config, &seen);
+	}
+	if (!status) {
+		/* NativeAdrenoGmuAllocator::mapInto: every payload read/write, Normal non-cacheable (AttrIndx 0), outer
+		 * shareable; only the icache, which the GMU executes, is executable and privileged. */
+		STEP(A810_CTX_MAP);
+		struct tbl_range ranges[A810_PAYLOADS];
+		/* sorted by GMU address: icache, dummy, log, hfi, debug */
+		static const unsigned order[A810_PAYLOADS] = {A810_PAYLOAD_ICACHE, A810_PAYLOAD_DUMMY, A810_PAYLOAD_LOG,
+			                                      A810_PAYLOAD_HFI, A810_PAYLOAD_DEBUG};
+		for (unsigned i = 0; i < A810_PAYLOADS; ++i) {
+			const struct a810_gmu_payload *p = &gmu_ctx.payload[order[i]];
+			ranges[i] = (struct tbl_range){p->iova, p->physical, p->bytes,
+				                       order[i] == A810_PAYLOAD_ICACHE ? 15u : 3u, 0, 2};
+		}
+		for (unsigned i = 0; i < A810_PAYLOADS && !status; ++i) {
+			for (uint64_t off = 0; off < ranges[i].bytes && !status; off += PAGE_4K) {
+				size_t index;
+				status = live_leaf_index(&gmu_ctx.arena, &gmu_ctx.tables, ranges[i].iova + off, &index);
+				if (!status && gmu_ctx.arena.mapping[index]) {
+					status = StateMismatch;          /* a map wants an entirely invalid range */
+				}
+			}
+		}
+		for (unsigned i = 0; i < A810_PAYLOADS && !status; ++i) {
+			for (uint64_t off = 0; off < ranges[i].bytes && !status; off += PAGE_4K) {
+				size_t index;
+				status = live_leaf_index(&gmu_ctx.arena, &gmu_ctx.tables, ranges[i].iova + off, &index);
+				if (!status) {
+					gmu_ctx.arena.mapping[index] = leaf_descriptor(&ranges[i], ranges[i].iova + off);
+				}
+			}
+		}
+		dsb_sy();
+		if (!status) {
+			size_t next = 1;
+			status = live_walk(&gmu_ctx.arena, &gmu_ctx.tables, gmu_ctx.tables.start_level, 0, 0, &next, 0, ranges,
+			    A810_PAYLOADS, &report->leaves);
+		}
+		if (!status) {
+			struct program_result sync;
+			status = synchronize_owned_context(io, bank, &gmu_ctx.config, 4000, &sync);
+			report->tlb_polls = sync.poll_reads;
+		}
+		report->map_status = (uint32_t)status;
+	}
+	if (!status) {
+		STEP(A810_CTX_READY);
+		gmu_ctx.ready = 1;
+	}
+#undef STEP
+	report->status = (uint32_t)status;
+	/* Registers the program step itself already read; skipped if it never ran. */
+	if (report->step >= A810_CTX_PROGRAM && program.context_offset && program.id1) {
+		const size_t page = (program.id1 & (1u << 31)) ? 0x10000 : 0x1000;
+		io_read32(io, 0x800 + 4 * slot, &report->smr);
+		io_read32(io, 0xc00 + 4 * slot, &report->s2cr);
+		io_read32(io, page + 4 * bank, &report->cbar);
+		io_read32(io, (size_t)program.context_offset, &report->sctlr);
+		io_read32(io, (size_t)program.context_offset + 0x58, &report->fsr);
+		io_read64(io, (size_t)program.context_offset + 0x20, &report->ttbr0);
+	}
+	io_read32(io, 0x48, &report->gfsr);
+	return status;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_a810_smmu.h b/bsd/dev/sweet_a810_smmu.h
new file mode 100644
index 0000000..5e0172c
--- /dev/null
+++ b/bsd/dev/sweet_a810_smmu.h
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Nothing Phone (3a) "asteroids": the GMU's own SMMU context on the GPU SMMU (Adreno 810 bring-up, mode 5).
+ *
+ * Ported from (MIT, Copyright (c) 2026 NativeAdreno contributors / ArmSmmu4K contributors):
+ *   rootstockos ArmSmmu4K: ArmSmmu4KContext.c, ArmSmmu4KProgram.c, ArmSmmu4KStreams.c, ArmSmmu4KLive.c (the fixed
+ *     native4K table topology of ArmSmmu4KLivePrepare and its leaf descriptor), ArmSmmu4KMmio.c;
+ *   NativeAdreno (branch asteroids, 60f16a6): NativeAdrenoGmuContext.cpp/.h, NativeAdrenoGmuMemory.cpp/.h,
+ *     NativeAdrenoSmmuContext.cpp, NativeAdrenoSmmuMemory.cpp (the bring-up order and the pool layout).
+ * C only, for this kernel: the payloads and the table pool are carved out of the reserved GMU pool, which the caller
+ * maps write-combined; every SMMU register access is a volatile 32-bit load/store followed by dsb sy (a 64-bit TTBR
+ * is two 32-bit halves, low then high), and no pool or table memory is ever cleared with memset/bzero.
+ */
+#ifndef SWEET_A810_SMMU_H
+#define SWEET_A810_SMMU_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* The GMU's address space (a6xx_gmu.c, A8xx): icache at 0x4000, dummy at 0x60000000, debug at 0x60400000, log and HFI
+ * after the dummy (NativeAdrenoGmuMemory.h); the context's lower (TTBR0) region covers 0..2 GiB. */
+#define A810_GMU_ICACHE_IOVA    0x4000ULL
+#define A810_GMU_UNCACHED_IOVA  0x60000000ULL
+#define A810_GMU_DEBUG_IOVA     0x60400000ULL
+#define A810_GMU_APERTURE       0x80000000ULL
+#define A810_GMU_TABLE_PAGES    1027u          /* 1 L1 + 2 L2 + 1024 L3 pages for 2 GiB with a 32-bit input */
+enum {A810_PAYLOAD_ICACHE, A810_PAYLOAD_DUMMY, A810_PAYLOAD_DEBUG, A810_PAYLOAD_LOG, A810_PAYLOAD_HFI, A810_PAYLOADS};
+
+struct a810_gmu_payload {
+	uint64_t physical, bytes, iova;
+	volatile uint32_t *cpu;                /* inside the caller's write-combined pool mapping */
+};
+
+/* NativeAdrenoGmuContext::Step */
+enum {A810_CTX_ALLOCATE = 1, A810_CTX_PREPARE, A810_CTX_PROGRAM, A810_CTX_ATTACH, A810_CTX_OBSERVE, A810_CTX_MAP,
+	  A810_CTX_READY};
+
+struct a810_smmu_image {
+	uint32_t cbar, cba2r, tcr, tcr2, mair0, mair1, sctlr, reserved_zero;
+	uint64_t ttbr0, ttbr1;
+};
+
+/* NativeAdrenoGmuContextReport, with the kit statuses as numbers (ArmSmmu4KStatus: 0 ok, 1 argument, 2 bad range,
+ * 3 overlap, 4 capacity, 5 budget, 6 unsupported, 7 state mismatch, 8 I/O, 9 timeout, 10 busy, 11 fault). */
+struct a810_gmu_context_report {
+	uint32_t step;                         /* last step started */
+	uint32_t status;                       /* ArmSmmu4KStatus of that step */
+	uint32_t program_phase, program_writes, program_readback_valid, program_enabled;
+	uint32_t route_phase, route_writes, routes_verified;
+	uint32_t id1, id2, output_bits, program_status, route_status, map_status;
+	uint32_t sctlr, cbar, smr, s2cr, fsr, gfsr;
+	uint64_t ttbr0;
+	uint32_t leaves, tlb_polls;
+	/* readback of the program step and its differences from the encoded image: bit 0 CBAR, 1 CBA2R, 2 TCR, 3 TCR2,
+	 * 4 MAIR0, 5 MAIR1, 6 TTBR0, 7 TTBR1, 8 SCTLR */
+	struct a810_smmu_image image;
+	uint32_t mismatch;
+};
+
+/*
+ * Build the GMU context: lay the payloads and the table pool out in the pool (pool_pa/pool_va/pool_bytes), prepare the
+ * fixed table topology, program and enable `bank` with `asid`, route `sid` through SMR/S2CR `slot`, observe, map the five
+ * payloads and synchronise the ASID. smmu/smmu_bytes: an uncached mapping of the whole SMMU (GR0, GR1 and the banks).
+ * progress (may be NULL) is called before each step. One attempt per boot. Returns 0 on success, else the kit status.
+ * Nothing is released on any outcome; the GMU stays in reset (nothing here starts it). sCR0 is only read.
+ */
+int a810_gmu_context_bringup(volatile uint8_t *smmu, size_t smmu_bytes, uint64_t pool_pa, volatile uint8_t *pool_va,
+    uint64_t pool_bytes, unsigned bank, unsigned asid, unsigned slot, unsigned sid, void (*progress)(uint32_t step),
+    struct a810_gmu_context_report *report);
+/* The five payloads of the context the bring-up built (icache, dummy, debug, log, hfi), only after it reached Ready. */
+int a810_gmu_context_payloads(struct a810_gmu_payload out[A810_PAYLOADS]);
+const char *a810_smmu_status_text(uint32_t status);
+#endif
