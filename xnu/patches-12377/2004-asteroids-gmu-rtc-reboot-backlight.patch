+        REG_GMU_GENERAL_8,REG_GMU_AHB_FENCE_RANGE_0,REG_GMU_SYS_BUS_CONFIG,
+        REG_GMU_ICACHE_CONFIG,REG_GMU_DCACHE_CONFIG};
+    const uint32_t config_values[]={0,2,(uint32_t)c->hfi.iova,1,0x4052,SHENG_GMU_FW_CHIP_ID,
+        (uint32_t)c->log.iova|3,SHENG_GMU_AHB_FENCE_RANGE,1,1,1};
+    for(unsigned i=0;i<sizeof(config_regs)/sizeof(config_regs[0]);++i) {
+        if(core_read(d,config_regs[i],&value,r)) {status=ShengGmuIoError;goto failed;}
+        if(value!=config_values[i]) {status=ShengGmuStateMismatch;goto failed;}
+    }
+    r->reset_verified=0;
+    if(core_write(d,REG_GMU_CM3_SYSRESET,0,r) || d->io.barrier(d->io.cookie)) {status=ShengGmuIoError;goto failed;}
+    r->phase=5;
+    status=poll(d,REG_GMU_CM3_FW_INIT_RESULT,mask,ready,c->poll_budget,&r->firmware_init_result,r);
+    if(status!=ShengGmuSuccess)goto failed;
+    r->firmware_ready_observed=1;
+    if(core_write(d,REG_GMU_HFI_CTRL_INIT,1,r) || d->io.barrier(d->io.cookie)) {status=ShengGmuIoError;goto failed;}
+    r->phase=6;
+    status=poll(d,REG_GMU_HFI_CTRL_STATUS,1,1,c->poll_budget,&r->hfi_status,r);
+    if(status!=ShengGmuSuccess)goto failed;
+    status=check_faults(d,r);if(status!=ShengGmuSuccess)goto failed;
+    if(d->io.barrier(d->io.cookie)) {status=ShengGmuIoError;goto failed;}
+    r->hfi_ready_observed=1;r->phase=7;return ShengGmuSuccess;
+failed:
+    reset_after_failure(d,r);return status;
+}
+typedef struct {
+    ShengGmuDevice *device;
+    ShengGmuStartupResult *result;
+} StartupContext;
+static int startup_now(void *cookie,uint64_t *value)
+{
+    ShengGmuDevice *d=((StartupContext *)cookie)->device;
+    return d->services.now_us(d->services.cookie,value);
+}
+static int startup_wait(void *cookie,unsigned us)
+{
+    ShengGmuDevice *d=((StartupContext *)cookie)->device;
+    return d->services.wait_us(d->services.cookie,us);
+}
+static int startup_health(void *cookie)
+{
+    StartupContext *c=cookie;ShengGmuDevice *d=c->device;
+    ShengGmuStartupResult *r=c->result;uint32_t reset,status;
+    r->health_status=check_faults(d,&r->load);
+    if(r->health_status!=ShengGmuSuccess)return 1;
+    if(core_read(d,REG_GMU_CM3_SYSRESET,&reset,&r->load) ||
+        core_read(d,REG_GMU_HFI_CTRL_STATUS,&status,&r->load))r->health_status=ShengGmuIoError;
+    else if(reset!=0 || !(status&1))r->health_status=ShengGmuStateMismatch;
+    return r->health_status!=ShengGmuSuccess;
+}
+ShengGmuStatus ShengGmuColdStart(ShengGmuDevice *d,const ShengGmuConfig *c,
+    const AdrenoHfiStartupConfig *config,const ShengGmuStartupLimits *limits,ShengGmuStartupResult *r)
+{
+    if(!r)return ShengGmuArgument;
+    *r=(ShengGmuStartupResult){0};r->load.resources_must_retain=r->protocol.resources_must_retain=1;
+    r->protocol_status=AdrenoHfiStartupInvalid; /* Not attempted until the load succeeds. */
+    if(!d || !c || !limits || AdrenoHfiStartupValidate(config)!=AdrenoHfiStartupSuccess)return ShengGmuArgument;
+#if SHENG_GMU_GENERATION>=8
+    /* a8xx_hfi_send_perf_table: the A8xx GPU_PERF table (AdrenoFirmware table_format 1); refuse an A7xx table. */
+    if(config->table_format!=1)return ShengGmuArgument;
+#endif
+    StartupContext context={d,r};
+    AdrenoHfiStartupServices services={&context,startup_now,startup_wait,startup_health,
+        limits->polls_per_command,limits->wait_interval_us,limits->command_timeout_us,limits->total_timeout_us};
+    if(AdrenoHfiStartupValidateServices(&services)!=AdrenoHfiStartupSuccess)return ShengGmuArgument;
+    if(d->poisoned || d->startup.poisoned)return ShengGmuPoisoned;
+    if(d->startup.attempted || d->startup.completed)return ShengGmuBusy;
+    ShengGmuStatus status=ShengGmuLoadAndStartHfi(d,c,&r->load);
+    if(status!=ShengGmuSuccess)return status;
+    r->protocol_status=AdrenoHfiStartupRun(&d->startup,&d->hfi,config,&services,&r->protocol);
+    if(r->protocol_status==AdrenoHfiStartupSuccess)return ShengGmuSuccess;
+    switch(r->protocol_status) {
+    case AdrenoHfiStartupClockError:case AdrenoHfiStartupWaitError:status=ShengGmuClockError;break;
+    case AdrenoHfiStartupTimeout:status=ShengGmuTimeout;break;
+    case AdrenoHfiStartupPlatformFault:status=r->health_status;break;
+    default:status=ShengGmuProtocolError;break;
+    }
+    reset_after_failure(d,&r->load);d->startup.poisoned=1;
+    return status;
+}
+static int fits(ShengGmuMmio *m,unsigned window,size_t at)
+{
+    if(!m || window>=ShengGmuWindows)return 0;
+    ShengGmuMmioWindow *w=m->windows+window;
+    return extent((uintptr_t)w->cpu,w->bytes) && !((uintptr_t)w->cpu&3) && !(at&3) &&
+        at<=w->bytes && w->bytes-at>=4;
+}
+static int mmio_read(void *cookie,unsigned window,size_t at,uint32_t *v)
+{ShengGmuMmio *m=cookie;if(!v || !fits(m,window,at))return 1;*v=*(volatile uint32_t *)(uintptr_t)(m->windows[window].cpu+at);return 0;}
+static int mmio_write(void *cookie,unsigned window,size_t at,uint32_t v)
+{ShengGmuMmio *m=cookie;if(!fits(m,window,at))return 1;*(volatile uint32_t *)(uintptr_t)(m->windows[window].cpu+at)=v;return 0;}
+static int mmio_barrier(void *cookie)
+{
+    (void)cookie;
+    __asm__ volatile("dsb sy":::"memory");
+    return 0;
+}
+ShengGmuStatus ShengGmuBindMmio(ShengGmuMmio *m,ShengGmuIo *out)
+{
+    if(!out)return ShengGmuArgument;
+    *out=(ShengGmuIo){0};
+    if(!m)return ShengGmuArgument;
+    for(unsigned i=0;i<ShengGmuWindows;++i) {
+        const ShengGmuMmioWindow *w=m->windows+i;
+        /* A window the board does not have (A8xx PDC) is pinned as size 0 and must be passed empty. */
+        if(!sheng_gmu_window_bytes[i]) {
+            if(w->cpu || w->physical || w->bytes)return ShengGmuArgument;
+            continue;
+        }
+        if(!fits(m,i,0) || w->physical!=sheng_gmu_window_physical[i] ||
+            w->bytes!=sheng_gmu_window_bytes[i])return ShengGmuArgument;
+        for(unsigned j=0;j<i;++j)if(overlap((uintptr_t)w->cpu,w->bytes,(uintptr_t)m->windows[j].cpu,m->windows[j].bytes))return ShengGmuArgument;
+    }
+    out->cookie=m;out->read32=mmio_read;out->write32=mmio_write;out->barrier=mmio_barrier;
+    for(unsigned i=0;i<ShengGmuWindows;++i)out->bytes[i]=m->windows[i].bytes;
+    return ShengGmuSuccess;
+}
+
+/* ---- ShengGmuCommandDb.c ---- */
+static uint16_t db_u16(const uint8_t *p){return (uint16_t)(p[0]|(uint16_t)p[1]<<8);}
+static uint32_t db_u32(const uint8_t *p){return db_u16(p)|(uint32_t)db_u16(p+2)<<16;}
+static int db_range(size_t at,size_t len,size_t size){return at<=size && len<=size-at;}
+static int db_overlaps(size_t a,size_t n,size_t b,size_t m){return n && m && a<b+m && b<a+n;}
+static int db_equal(const uint8_t *a,const char *b)
+{for(unsigned i=0;i<8;++i)if(a[i]!=(uint8_t)b[i])return 0;return 1;}
+ShengGmuDbStatus ShengGmuCommandDbInputs(const uint8_t *data,size_t bytes,uint32_t expected,ShengGmuVoteInputs *out)
+{
+    if(!data || !out || bytes!=SHENG_GMU_COMMAND_DB_BYTES || !expected)return ShengGmuDbArgument;
+    if(db_u32(data)!=expected)return ShengGmuDbVersion;
+    if(db_u32(data+4)!=0x0c0330db)return ShengGmuDbCorrupt;
+    /* cmd_db_get_header: the slave table ends at the first zero slv_id, and every slave type is searched (int-011:
+     * the sheng AOP database failed the earlier 3..5-only, no-gap rule). Only extents are checked for records that
+     * are not used here; the records used below get the full address/slave/aux checks. */
+    size_t heads[8]={0},sizes[8]={0},aux[8]={0};unsigned rows=0;
+    for(unsigned i=0;i<8;++i) {
+        const uint8_t *r=data+8+16*i;unsigned id=db_u16(r),count=db_u16(r+6);
+        if(!id)break;
+        heads[i]=144u+db_u16(r+2);sizes[i]=(size_t)count*24;aux[i]=144u+db_u16(r+4);
+        if(!db_range(heads[i],sizes[i],bytes) || !db_range(aux[i],0,bytes))return ShengGmuDbCorrupt;
+        ++rows;
+    }
+    static const char names[8][8]={{'g','f','x','.','l','v','l',0},{'m','x','.','l','v','l',0,0},
+        {'c','x','.','l','v','l',0,0},{'g','m','x','c','.','l','v','l'},
+        {'S','H','0',0,0,0,0,0},{'M','C','0',0,0,0,0,0},{'A','C','V',0,0,0,0,0},{'C','N','0',0,0,0,0,0}};
+    ShengGmuAux found[8]={{0}};uint32_t addresses[8]={0};unsigned seen=0;
+    for(unsigned i=0;i<rows;++i)for(size_t at=heads[i];at<heads[i]+sizes[i];at+=24) {
+        const uint8_t *e=data+at;uint32_t address=db_u32(e+16);size_t len=db_u16(e+20),offset=aux[i]+db_u16(e+22);
+        unsigned slave=db_u16(data+8+16*i);
+        for(unsigned name=0;name<8;++name)if(db_equal(e,names[name])) {
+            if(seen&(1u<<name))return ShengGmuDbDuplicate;
+            if(!address || (address&3) || ((address>>16)&7)!=slave || !db_range(offset,len,bytes))return ShengGmuDbCorrupt;
+            for(unsigned j=0;j<rows;++j)if(db_overlaps(offset,len,heads[j],sizes[j]))return ShengGmuDbCorrupt;
+            if(slave!=(name<4?3u:5u))return ShengGmuDbCorrupt;
+            seen|=1u<<name;found[name]=(ShengGmuAux){data+offset,len};addresses[name]=address;
+        }
+    }
+    if((seen&0xf7)!=0xf7)return ShengGmuDbMissing;
+    ShengGmuVoteInputs result=*out;
+    result.gfx=found[0];result.mx=found[1];result.cx=found[2];result.gmxc=found[3];result.gmxc_present=(seen>>3)&1;
+    result.sh0=(ShengGmuBcmInput){addresses[4],found[4]};result.mc0=(ShengGmuBcmInput){addresses[5],found[5]};
+    result.acv=(ShengGmuBcmInput){addresses[6],found[6]};result.cn0_address=addresses[7];
+    *out=result;return ShengGmuDbSuccess;
+}
+
+/* ---- ShengGmuVotes.c (UniXNU-asteroids) ---- */
+/* From UniXNU-sheng package/ShengGmuVotes.c (b0ccf61522383c5e4dda1091252c5534213aeba5), for the Adreno 810: SKU bins,
+ * the A8xx GPU_PERF table with MX dependency votes (a8xx_hfi_send_perf_table, a6xx_gmu_rpmh_dep_votes_init) and the
+ * A8xx fixed-BCM rule. */
+static const ShengGmuGpuBin *selected_bin;
+/* adreno_of_get_pwrlevels: the first bin, in device-tree order, listing the SoC code or 0 (which matches any). */
+static const ShengGmuGpuBin *bin_for(const ShengGmuVoteInputs *in)
+{
+    for(unsigned i=0;i<SHENG_GPU_BINS;++i)
+        for(unsigned j=0;j<sheng_gpu_bins[i].sku_count;++j) {
+            const uint32_t code=sheng_gpu_bins[i].skus[j];
+            if(!code || (in->sku_present && code==in->sku_code))return &sheng_gpu_bins[i];
+        }
+    return 0;
+}
+AdrenoHfiStartupStatus ShengGmuBuildStartup(const ShengGmuVoteInputs *in,AdrenoHfiStartupConfig *out)
+{
+    if(!in || !out || in->chip_id!=SHENG_GMU_VOTES_CHIP_ID || in->gmxc_present>1 ||
+        in->enable_acd || in->enable_ifpc>1 || in->sku_present>1 ||
+        (!in->gmxc_present && (in->gmxc.data || in->gmxc.bytes)))return AdrenoHfiStartupInvalid;
+    const ShengGmuGpuBin *bin=bin_for(in);
+    if(!bin)return AdrenoHfiStartupInvalid;
+    AdrenoHfiStartupConfig c={0};uint32_t votes[16],levels[16];
+    /* a6xx_gmu_rpmh_votes_init: GMxC, when cmd-db has it, is the secondary rail of the GX votes. */
+    const ShengGmuAux *gpu_secondary=in->gmxc_present?&in->gmxc:&in->mx;
+    for(unsigned i=0;i<bin->opp_count;++i)levels[i]=bin->opps[i].level;
+    if(AdrenoHfiArcVotes(levels,bin->opp_count,in->gfx.data,in->gfx.bytes,
+        gpu_secondary->data,gpu_secondary->bytes,votes,16))return AdrenoHfiStartupInvalid;
+    c.gpu_count=bin->opp_count;
+    for(unsigned i=0;i<c.gpu_count;++i)c.gpu[i]=(AdrenoHfiPerformanceLevel){bin->opps[i].hz,votes[i]};
+    if(AdrenoHfiDependencyVotes(levels,bin->opp_count,in->mx.data,in->mx.bytes,c.gpu_dependency,16))
+        return AdrenoHfiStartupInvalid;
+    c.table_format=1;
+    for(unsigned i=0;i<SHENG_GMU_OPPS;++i)levels[i]=sheng_gmu_opps[i].level;
+    if(AdrenoHfiArcVotes(levels,SHENG_GMU_OPPS,in->cx.data,in->cx.bytes,
+        in->mx.data,in->mx.bytes,votes,16))return AdrenoHfiStartupInvalid;
+    c.gmu_count=SHENG_GMU_OPPS;
+    for(unsigned i=0;i<c.gmu_count;++i)c.gmu[i]=(AdrenoHfiPerformanceLevel){sheng_gmu_opps[i].hz,votes[i]};
+    const ShengGmuBcmInput *inputs[]={&in->sh0,&in->mc0,&in->acv};AdrenoHfiBcm bcms[3];
+    for(unsigned i=0;i<3;++i) {
+        bcms[i]=sheng_bcm_policy[i];bcms[i].address=inputs[i]->address;
+        if(AdrenoHfiBcmAux(bcms+i,inputs[i]->aux.data,inputs[i]->aux.bytes))return AdrenoHfiStartupInvalid;
+    }
+    if(AdrenoHfiBuildBandwidth(bin->bandwidths,bin->bandwidth_count,bcms,3,in->cn0_address,&c))
+        return AdrenoHfiStartupInvalid;
+    c.enable_ifpc=in->enable_ifpc;
+    if(AdrenoHfiStartupValidate(&c))return AdrenoHfiStartupInvalid;
+    *out=c;selected_bin=bin;return AdrenoHfiStartupSuccess;
+}
+unsigned ShengGmuPerfVote(unsigned perf,unsigned *bandwidth)
+{
+    const ShengGmuGpuBin *bin=selected_bin;
+    if(!bin) {if(bandwidth)*bandwidth=0;return 0;}
+    if(perf<1)perf=1;
+    if(perf>=bin->opp_count)perf=bin->opp_count-1;
+    unsigned bw=1;
+    for(unsigned i=1;i<bin->bandwidth_count;++i)if(bin->bandwidths[i]==bin->opps[perf].kbps){bw=i;break;}
+    if(bandwidth)*bandwidth=bw;
+    return perf;
+}
+
+/* sweet: the generated pins the board code logs and maps. */
+uint64_t
+sweet_a810_gmu_window(unsigned window, size_t *bytes)
+{
+    if(window>=ShengGmuWindows) {if(bytes)*bytes=0;return 0;}
+    if(bytes)*bytes=sheng_gmu_window_bytes[window];
+    return sheng_gmu_window_physical[window];
+}
+const uint8_t *
+sweet_a810_gmu_firmware_pin(size_t *bytes,unsigned *blocks)
+{
+    if(bytes)*bytes=SHENG_GMU_FIRMWARE_BYTES;
+    if(blocks)*blocks=SHENG_GMU_FIRMWARE_BLOCKS;
+    return sheng_gmu_firmware_sha256;
+}
+uint32_t
+sweet_a810_gmu_chip_id(void)
+{
+    return SHENG_GMU_CHIP_ID;
+}
+uint64_t
+sweet_a810_cmd_db(size_t *bytes)
+{
+    if(bytes)*bytes=SHENG_GMU_COMMAND_DB_BYTES;
+    return SHENG_GMU_COMMAND_DB_BASE;
+}
+uint64_t
+sweet_a810_gpu_level_hz(unsigned perf)
+{
+    /* the bin the last successful ShengGmuBuildStartup selected */
+    return selected_bin && perf<selected_bin->opp_count?selected_bin->opps[perf].hz:0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
