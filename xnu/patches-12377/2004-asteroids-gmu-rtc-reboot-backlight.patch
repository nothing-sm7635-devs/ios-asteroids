new file mode 100644
index 0000000..080c8cd
--- /dev/null
+++ b/bsd/dev/sweet_rtc_asteroids.c
@@ -0,0 +1,502 @@
+/*
+ * Nothing Phone (3a) (asteroids) wall clock, the counterpart of the Poco F1's (sweet_spmi.c, patch 0245).
+ *
+ * The PMK8550 RTC (SPMI SID 0, peripheral 0x61, rtc@6100; Linux rtc-pm8xxx pmk8350 layout: CTRL 0x6146 bit 7
+ * enabled, seconds little-endian at 0x6148-0x614b) keeps counting through reboots, but the application processor
+ * may not set it (no "allow-set-time": the write registers at 0x6140 belong to another EE) and, unlike the Poco
+ * F1, nothing here writes any PMIC register: wall time is counter + an offset kept in a file on the root volume,
+ * SWEET_RTC_FILE. The kernel reads the file once the root is mounted, before launchd starts
+ * (sweet_rtc_asteroids_root_mounted from bsd_init), and stores it again whenever iOS sets the time
+ * (SweetPlatformExpert::setGMTTimeOfDay). Design credit: rootstockos (UniXNU-asteroids, BSD-2-Clause-Patent) keeps
+ * the same kind of offset in /private/var/db/unixnu-rtc-offset, restored by the kernel before launchd.
+ *
+ * The SPMI arbiter is v7 (core 0x0c400000, APID map at core + 0x2000, owners at cnfg 0x0c42d000, observer windows
+ * 0x20 apart at 0x0c440000), the same registers sweet_keys.c reads PON/GPIO through. Reads only: the sole MMIO
+ * write is the observer's EXT_READL command. Boot-arg sweetrtc=0 disables all of it (the old 1970 boot).
+ *
+ * File format: one line, a signed decimal int64 (counter + offset = Unix seconds), written as a fixed-size
+ * 21-byte record "+0000000001761500000\n" overwritten in place at offset 0 and fsynced (one sector, no rename).
+ * Any leading [+-]digits line is accepted on read, so the file can be written by hand.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/stat.h>
+#include <sys/vnode.h>
+#include <sys/kauth.h>
+#include <sys/mount.h>
+#include <sys/uio.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <libkern/version.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "sweet_board.h"
+#include "sweet_spmi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define SWEET_RTC_FILE  "/private/var/db/sweet-rtc-offset"
+#define SA_REC_LEN      21u             /* sign, 19 digits, newline */
+
+#define SA_CORE_PA      0x0c400000u
+#define SA_CORE_SIZE    0x3000u
+#define SA_CNFG_PA      0x0c42d000u
+#define SA_CNFG_SIZE    0x4000u
+#define SA_OBS_PA       0x0c440000u
+#define SA_OBS_SIZE     0x8000u
+#define SA_OBS_STRIDE   0x20u
+#define SA_MAP_OFF      0x2000u
+#define SA_MAX_APIDS    0x380u
+#define SA_NO_APID      0xffffu
+
+#define SA_RTC_PPID     0x061u          /* SID 0, peripheral 0x61 */
+#define SA_RTC_CTRL     0x46u           /* RTC_EN bit 7 */
+#define SA_RTC_READ     0x48u           /* RDATA0-3 */
+#define SA_EN           0x80u
+#define SA_T_MIN        1735689600ll    /* 2025-01-01: older is not a real wall clock */
+#define SA_T_MAX        4102444800ll    /* 2100-01-01 */
+
+LCK_GRP_DECLARE(sweet_rtc_grp, "sweet_rtc");
+LCK_MTX_DECLARE(sweet_rtc_mtx, &sweet_rtc_grp);
+
+static vm_offset_t sa_core, sa_cnfg, sa_obs;
+static uint16_t sa_apid = SA_NO_APID;
+static bool sa_tried, sa_failed;
+
+enum { SA_SRC_NONE, SA_SRC_FALLBACK, SA_SRC_FILE, SA_SRC_SET };
+static const char *const sa_src_name[] = { "none", "fallback", "file", "set" };
+static int sa_src;
+static int64_t sa_offset;
+static bool sa_restored, sa_dirty;
+static thread_call_t sa_write_tc;
+
+static uint32_t
+sa_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+int
+sweet_rtc_asteroids_enabled(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		int on = 1;
+		(void)PE_parse_boot_argn("sweetrtc", &on, sizeof(on));
+		cached = sweet_board_asteroids() && on != 0;
+		if (sweet_board_asteroids() && !on) {
+			printf("SWEET RTC: disabled (sweetrtc=0)\n");
+		}
+	}
+	return cached;
+}
+
+/* One-byte observer EXT_READL of the RTC peripheral (arbiter v7, as keys_read in sweet_keys.c). sa_mtx held. */
+static int
+sa_read(uint8_t reg, uint8_t *out)
+{
+	uint32_t off = SA_OBS_STRIDE * sa_apid, status = 0;
+	if (sa_failed) {
+		return -1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sa_obs + off) = (1u << 27) | ((uint32_t)reg << 4);      /* EXT_READL, one byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		status = sa_rd(sa_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				printf("SWEET RTC: read 0x61%02x failed, status %#x\n", reg, status);
+				return -1;
+			}
+			*out = (uint8_t)sa_rd(sa_obs, off + 0x18u);
+			return 0;
+		}
+		delay(1);
+	}
+	/* A late completion would confuse the next command on this channel: stop using it this boot. */
+	printf("SWEET RTC: read 0x61%02x timed out, status %#x; RTC off this boot\n", reg, status);
+	sa_failed = true;
+	return -1;
+}
+
+static int
+sa_init_locked(void)
+{
+	if (sa_tried) {
+		return sa_apid != SA_NO_APID && !sa_failed ? 0 : -1;
+	}
+	sa_tried = true;
+	sa_core = ml_io_map(SA_CORE_PA, SA_CORE_SIZE);
+	sa_cnfg = ml_io_map(SA_CNFG_PA, SA_CNFG_SIZE);
+	sa_obs = ml_io_map(SA_OBS_PA, SA_OBS_SIZE);
+	if (!sa_core || !sa_cnfg || !sa_obs) {
+		printf("SWEET RTC: SPMI mapping failed\n");
+		return -1;
+	}
+	uint32_t version = sa_rd(sa_core, 0), count = sa_rd(sa_core, 4) & 0x7ffu;
+	if (version < 0x70000000u || version >= 0x80000000u || !count || count > SA_MAX_APIDS) {
+		printf("SWEET RTC: unsupported SPMI arbiter version=%#x apids=%u\n", version, count);
+		return -1;
+	}
+	unsigned owner = 0;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = sa_rd(sa_core, SA_MAP_OFF + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != SA_RTC_PPID) {
+			continue;
+		}
+		unsigned o = sa_rd(sa_cnfg, 4u * i) & 7u;
+		if (sa_apid == SA_NO_APID || o == 0) {
+			sa_apid = (uint16_t)i;
+			owner = o;
+		}
+	}
+	if (sa_apid == SA_NO_APID || SA_OBS_STRIDE * sa_apid + 0x20u > SA_OBS_SIZE) {
+		printf("SWEET RTC: arb=%#x apids=%u: no usable APID for PPID 0x%03x\n", version, count, SA_RTC_PPID);
+		sa_apid = SA_NO_APID;
+		return -1;
+	}
+	uint8_t ctrl = 0;
+	int rc = sa_read(SA_RTC_CTRL, &ctrl);
+	printf("SWEET RTC: arb=%#x apids=%u PPID 0x%03x APID %u owner EE %u ctrl %#x%s\n", version, count,
+	    SA_RTC_PPID, sa_apid, owner, ctrl, rc ? " (unreadable)" : (ctrl & SA_EN) ? "" : " (RTC disabled)");
+	if (rc != 0 || !(ctrl & SA_EN)) {
+		sa_failed = true;
+		return -1;
+	}
+	return 0;
+}
+
+static int
+sa_read32(uint8_t reg, uint32_t *v)
+{
+	uint8_t b[4];
+	for (unsigned i = 0; i < 4; i++) {
+		if (sa_read((uint8_t)(reg + i), &b[i]) != 0) {
+			return -1;
+		}
+	}
+	*v = (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+	return 0;
+}
+
+/* RTC seconds, read twice over a byte-0 rollover (as rtc-pm8xxx). sa_mtx held. */
+static int
+sa_counter(uint32_t *raw)
+{
+	uint8_t b0 = 0;
+	if (sa_init_locked() != 0) {
+		return -1;
+	}
+	for (int t = 0; t < 2; t++) {
+		if (sa_read32(SA_RTC_READ, raw) != 0 || sa_read(SA_RTC_READ, &b0) != 0) {
+			return -1;
+		}
+		if (b0 == (uint8_t)*raw) {
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static bool
+sa_plausible(int64_t t)
+{
+	return t >= SA_T_MIN && t < SA_T_MAX;
+}
+
+/* Days since 1970-01-01 of a proleptic Gregorian date (H. Hinnant's days_from_civil). */
+static int64_t
+sa_days(int64_t y, int m, int d)
+{
+	y -= m <= 2;
+	int64_t era = (y >= 0 ? y : y - 399) / 400;
+	int64_t yoe = y - era * 400;
+	int64_t doy = (153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + d - 1;
+	int64_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+	return era * 146097 + doe - 719468;
+}
+
+/*
+ * The kernel's build time from version[] ("Darwin Kernel Version 25.0.0: Wed Oct 22 12:34:56 UTC 2026; root:...",
+ * date(1) in config/newvers.pl); the time zone is ignored. 0 when it does not parse.
+ */
+static int64_t
+sa_build_time(void)
+{
+	static const char months[] = "JanFebMarAprMayJunJulAugSepOctNovDec";
+	const char *s = version;
+	const char *tok[8];
+	unsigned len[8], n = 0;
+
+	while (*s && !(s[0] == ':' && s[1] == ' ')) {
+		s++;
+	}
+	if (!*s) {
+		return 0;
+	}
+	for (s += 2; *s && *s != ';' && n < 8;) {
+		while (*s == ' ') {
+			s++;
+		}
+		if (!*s || *s == ';') {
+			break;
+		}
+		tok[n] = s;
+		while (*s && *s != ' ' && *s != ';') {
+			s++;
+		}
+		len[n] = (unsigned)(s - tok[n]);
+		n++;
+	}
+	if (n < 5 || len[1] != 3 || len[3] != 8) {
+		return 0;
+	}
+	unsigned mon = 0, day = 0, hh, mm, ss, year = 0;
+	for (unsigned i = 0; i < 12; i++) {
+		if (strncmp(tok[1], months + 3 * i, 3) == 0) {
+			mon = i + 1;
+		}
+	}
+	for (unsigned i = 0; i < len[2]; i++) {
+		day = day * 10 + (unsigned)(tok[2][i] - '0');
+	}
+	const char *t = tok[3];
+	hh = (unsigned)((t[0] - '0') * 10 + (t[1] - '0'));
+	mm = (unsigned)((t[3] - '0') * 10 + (t[4] - '0'));
+	ss = (unsigned)((t[6] - '0') * 10 + (t[7] - '0'));
+	if (len[n - 1] != 4) {
+		return 0;
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		year = year * 10 + (unsigned)(tok[n - 1][i] - '0');
+	}
+	if (!mon || !day || day > 31 || hh > 23 || mm > 59 || ss > 60 || year < 2025 || year > 2099) {
+		return 0;
+	}
+	return sa_days(year, (int)mon, (int)day) * 86400 + (int64_t)(hh * 3600 + mm * 60 + ss);
+}
+
+/* No offset yet: the counter if it already is wall time, else the kernel's build time, else the counter as-is. */
+static void
+sa_fallback_locked(uint32_t raw)
+{
+	int64_t built = sa_build_time();
+	const char *why;
+	if (sa_plausible(raw)) {
+		sa_offset = 0;
+		why = "counter is wall time";
+	} else if (sa_plausible(built)) {
+		sa_offset = built - raw;
+		why = "kernel build time";
+	} else {
+		sa_offset = 0;
+		why = "counter as-is, not a Unix time";
+	}
+	sa_src = SA_SRC_FALLBACK;
+	printf("SWEET RTC: counter %u, no stored offset yet: %s, offset %lld\n", raw, why, sa_offset);
+}
+
+static int
+sa_file_read(int64_t *off)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	char buf[32];
+	int resid = 0, err;
+
+	if ((err = vnode_open(SWEET_RTC_FILE, FREAD | O_NOFOLLOW, 0, VNODE_LOOKUP_NOFOLLOW, &vp, ctx)) != 0) {
+		return err;
+	}
+	bzero(buf, sizeof(buf));
+	err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, sizeof(buf) - 1, 0, UIO_SYSSPACE, IO_NOAUTH,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	(void)vnode_close(vp, FREAD, ctx);
+	if (err != 0) {
+		return err;
+	}
+	const char *s = buf;
+	bool neg = false;
+	uint64_t v = 0;
+	unsigned digits = 0;
+	while (*s == ' ' || *s == '\t') {
+		s++;
+	}
+	if (*s == '+' || *s == '-') {
+		neg = *s++ == '-';
+	}
+	for (; *s >= '0' && *s <= '9'; s++, digits++) {
+		v = v * 10 + (uint64_t)(*s - '0');
+	}
+	if (digits == 0 || digits > 19 || v >= (uint64_t)SA_T_MAX || (*s != '\n' && *s != '\0' && *s != ' ' && *s != '\r')) {
+		return EINVAL;
+	}
+	*off = neg ? -(int64_t)v : (int64_t)v;
+	return 0;
+}
+
+/* Overwrite the fixed-size record in place and fsync it. */
+static int
+sa_file_write(int64_t off)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	char buf[SA_REC_LEN];
+	uint64_t v = off < 0 ? (uint64_t)-off : (uint64_t)off;
+	int resid = 0, err;
+
+	buf[0] = off < 0 ? '-' : '+';
+	for (unsigned i = SA_REC_LEN - 2; i >= 1; i--) {
+		buf[i] = (char)('0' + v % 10);
+		v /= 10;
+	}
+	buf[SA_REC_LEN - 1] = '\n';
+	if ((err = vnode_open(SWEET_RTC_FILE, O_CREAT | FWRITE | O_NOFOLLOW, S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH,
+	    VNODE_LOOKUP_NOFOLLOW, &vp, ctx)) != 0) {
+		return err;
+	}
+	err = vn_rdwr(UIO_WRITE, vp, (caddr_t)buf, SA_REC_LEN, 0, UIO_SYSSPACE, IO_NOAUTH | IO_SYNC | IO_UNIT,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	if (err == 0 && resid != 0) {
+		err = EIO;
+	}
+	if (err == 0) {
+		err = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	int cerr = vnode_close(vp, FWRITE, ctx);
+	return err ? err : cerr;
+}
+
+/* Thread call: file I/O stays out of clock_set_calendar_microtime (it holds settime_lock around setGMTTimeOfDay). */
+static void
+sa_write_call(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	lck_mtx_lock(&sweet_rtc_mtx);
+	bool dirty = sa_dirty;
+	int64_t off = sa_offset;
+	sa_dirty = false;
+	lck_mtx_unlock(&sweet_rtc_mtx);
+	if (!dirty) {
+		return;
+	}
+	int err = sa_file_write(off);
+	printf("SWEET RTC: offset %lld -> %s, error %d%s\n", off, SWEET_RTC_FILE, err,
+	    err ? " (kept for the next time set)" : "");
+	if (err != 0) {
+		lck_mtx_lock(&sweet_rtc_mtx);
+		sa_dirty = true;
+		lck_mtx_unlock(&sweet_rtc_mtx);
+	}
+}
+
+/* Thread context. Unix seconds (counter + offset); 0 when disabled or unreadable. */
+uint64_t
+sweet_rtc_asteroids_get(void)
+{
+	static bool told;
+	uint32_t raw;
+	int64_t t = 0;
+
+	if (!sweet_rtc_asteroids_enabled()) {
+		return 0;
+	}
+	lck_mtx_lock(&sweet_rtc_mtx);
+	if (sa_counter(&raw) == 0) {
+		if (sa_src == SA_SRC_NONE) {
+			sa_fallback_locked(raw);
+		}
+		t = (int64_t)raw + sa_offset;
+		if (!told) {
+			told = true;
+			printf("SWEET RTC: counter %u APID %u offset %lld (%s) -> %lld\n", raw, sa_apid, sa_offset,
+			    sa_src_name[sa_src], t);
+		}
+	}
+	lck_mtx_unlock(&sweet_rtc_mtx);
+	return t > 0 ? (uint64_t)t : 0;
+}
+
+/* Thread context (under settime_lock): new offset; written to the file asynchronously when it moved by over 2 s. */
+void
+sweet_rtc_asteroids_set(uint64_t unix_secs)
+{
+	uint32_t raw;
+
+	if (!sweet_rtc_asteroids_enabled() || !sa_plausible((int64_t)unix_secs)) {
+		return;
+	}
+	lck_mtx_lock(&sweet_rtc_mtx);
+	if (sa_counter(&raw) != 0) {
+		lck_mtx_unlock(&sweet_rtc_mtx);
+		return;
+	}
+	int64_t want = (int64_t)unix_secs - raw, old = sa_offset;
+	int64_t diff = want > old ? want - old : old - want;
+	bool moved = (sa_src != SA_SRC_FILE && sa_src != SA_SRC_SET) || diff > 2;
+	if (moved) {
+		sa_offset = want;
+		sa_src = SA_SRC_SET;
+		sa_dirty = true;
+	}
+	bool kick = sa_dirty && sa_restored && sa_write_tc != NULL;
+	lck_mtx_unlock(&sweet_rtc_mtx);
+	if (moved) {
+		printf("SWEET RTC: time set %llu, counter %u, offset %lld -> %lld%s\n", unix_secs, raw, old, want,
+		    sa_restored ? "" : " (root not mounted yet)");
+	}
+	if (kick) {
+		thread_call_enter(sa_write_tc);
+	}
+}
+
+/*
+ * bsd_init, root mounted and before launchd: load the stored offset and move the calendar to counter + offset
+ * (IOKitInitializeTime ran before the root, on the fallback).
+ */
+void
+sweet_rtc_asteroids_root_mounted(void)
+{
+	int64_t off = 0, t = 0;
+	uint32_t raw = 0;
+	bool apply = false, kick = false;
+
+	if (!sweet_rtc_asteroids_enabled()) {
+		return;
+	}
+	sa_write_tc = thread_call_allocate(sa_write_call, NULL);
+	int err = sa_file_read(&off);
+	lck_mtx_lock(&sweet_rtc_mtx);
+	sa_restored = true;
+	if (sa_counter(&raw) != 0) {
+		lck_mtx_unlock(&sweet_rtc_mtx);
+		printf("SWEET RTC: counter unreadable, %s not applied\n", SWEET_RTC_FILE);
+		return;
+	}
+	if (sa_src == SA_SRC_SET) {
+		kick = sa_dirty;        /* iOS set the time before the root: that wins over the file */
+	} else if (err == 0 && sa_plausible((int64_t)raw + off)) {
+		sa_offset = off;
+		sa_src = SA_SRC_FILE;
+		apply = true;
+	} else if (sa_src == SA_SRC_NONE) {
+		sa_fallback_locked(raw);
+	}
+	t = (int64_t)raw + sa_offset;
+	lck_mtx_unlock(&sweet_rtc_mtx);
+	printf("SWEET RTC: counter %u APID %u, %s: error %d offset %lld, offset source %s -> %lld\n", raw, sa_apid,
+	    SWEET_RTC_FILE, err, off, sa_src_name[sa_src], t);
+	if (apply) {
+		/* setGMTTimeOfDay comes back with the same offset: nothing is written. */
+		clock_set_calendar_microtime((clock_sec_t)t, 0);
+	}
+	if (kick && sa_write_tc != NULL) {
+		thread_call_enter(sa_write_tc);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_spmi.h b/bsd/dev/sweet_spmi.h
index 977edbe..59a9027 100644
--- a/bsd/dev/sweet_spmi.h
+++ b/bsd/dev/sweet_spmi.h
@@ -22,6 +22,14 @@ void sweet_spmi_atomic(void);
 /* Poco F1 wall clock from the PM8998 RTC (patch 0245). Thread context. get: Unix seconds, 0 none. */
 uint64_t sweet_rtc_get(void);
 void sweet_rtc_set(uint64_t unix_secs);
+/*
+ * Nothing Phone (3a) wall clock (sweet_rtc_asteroids.c): PMK8550 RTC counter + an offset file on the root.
