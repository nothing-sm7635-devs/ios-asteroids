  * (fBlOK cleared, the original value written back as well as possible) when
  * a write fails or does not read back: the caller blacks the screen out instead.
  */
+/*
+ * What iOS 26's CoreBrightness needs from the backlight service before it can build its display (asteroids, traced in
+ * the 23G90 shared cache): DisplayCreateWithCapabilitiesAndID reads "backlight-calibration-parameters" (a dictionary of
+ * 16.16 integers, CBBacklightNode getBacklightCalibration:). Without it, it takes a fallback that calls
+ * _DisplaySliderToLogicalBrightnessInternal before the marketing table is loaded and dereferences NULL: backboardd
+ * SIGSEGV, far 0, right after it matched the service (asteroids boot ast3; Bergamota 0249 on the Poco F1). Then it
+ * needs "backlight-marketing-table" (OSData of SInt32 16.16 nits at evenly spaced slider positions) or the display
+ * creation fails. The nits keys are optional. Values are synthetic but consistent with sweetfb_blnits (500 nits peak),
+ * which the brightness-nits mapping in setProperties assumes.
+ */
+static void
+sweet_backlight_calibration(IOService *bl, uint32_t peak)
+{
+#define SWEET_FX(x) ((int32_t)((x) * 65536))
+	OSDictionary *cal = OSDictionary::withCapacity(10);
+	if (cal == NULL) {
+		return;
+	}
+	static const struct {
+		const char *key;
+		int32_t value;
+	} keys[] = {
+		{ "current-for-max-backlight", SWEET_FX(20) }, { "current-for-mid-backlight", SWEET_FX(7) },
+		{ "hardware-max-current-limit", SWEET_FX(25) }, { "milliAmps2NitsScaleFactor", SWEET_FX(25) },
+		{ "lMidProduct", SWEET_FX(140) }, { "lMinProduct", SWEET_FX(2) },
+		{ "lMidPanel", SWEET_FX(140) }, { "lMinPanel", SWEET_FX(2) },
+	};
+	for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+		OSNumber *n = OSNumber::withNumber((uint32_t)keys[i].value, 32);
+		if (n != NULL) {
+			cal->setObject(keys[i].key, n);
+			n->release();
+		}
+	}
+	OSNumber *mx = OSNumber::withNumber((uint32_t)SWEET_FX(peak), 32), *mxp = OSNumber::withNumber((uint32_t)SWEET_FX(peak), 32);
+	if (mx != NULL && mxp != NULL) {
+		cal->setObject("lMaxProduct", mx);
+		cal->setObject("lMaxPanel", mxp);
+	}
+	OSSafeReleaseNULL(mx);
+	OSSafeReleaseNULL(mxp);
+	bl->setProperty("backlight-calibration-parameters", cal);
+	cal->release();
+	/* nits at slider 0, 1/16 .. 1: rising, the first equal to lMinPanel, the last the peak */
+	static const uint16_t curve[17] = { 2, 4, 7, 11, 17, 25, 35, 48, 64, 85, 110, 140, 180, 230, 300, 390, 500 };
+	int32_t mkt[17];
+	for (unsigned i = 0; i < 17; i++) {
+		mkt[i] = SWEET_FX((uint32_t)curve[i] * peak / 500u > 2u ? (uint32_t)curve[i] * peak / 500u : 2u);
+	}
+	bl->setProperty("backlight-marketing-table", (void *)mkt, sizeof(mkt));
+	int32_t v = SWEET_FX(2);
+	bl->setProperty("digital-dimming-min-nits", &v, sizeof(v));
+	bl->setProperty("aot-accessible-min-nits", &v, sizeof(v));
+	v = SWEET_FX(peak);
+	bl->setProperty("user-accessible-max-nits", &v, sizeof(v));
+#undef SWEET_FX
+}
