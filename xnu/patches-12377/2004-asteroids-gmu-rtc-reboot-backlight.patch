+	0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u,
+};
+static inline uint32_t
+a810_rotr(uint32_t v, unsigned n)
+{
+	return (v >> n) | (v << (32 - n));
+}
+static void
+a810_sha_block(uint32_t st[8], const uint8_t *b)
+{
+	uint32_t w[64];
+	for (unsigned i = 0; i < 16; ++i) {
+		w[i] = (uint32_t)b[i * 4] << 24 | (uint32_t)b[i * 4 + 1] << 16 | (uint32_t)b[i * 4 + 2] << 8 | b[i * 4 + 3];
+	}
+	for (unsigned i = 16; i < 64; ++i) {
+		uint32_t s0 = a810_rotr(w[i - 15], 7) ^ a810_rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+		uint32_t s1 = a810_rotr(w[i - 2], 17) ^ a810_rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+		w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+	}
+	uint32_t a = st[0], b2 = st[1], c = st[2], d = st[3], e = st[4], f = st[5], g = st[6], h = st[7];
+	for (unsigned i = 0; i < 64; ++i) {
+		uint32_t t1 = h + (a810_rotr(e, 6) ^ a810_rotr(e, 11) ^ a810_rotr(e, 25)) + ((e & f) ^ (~e & g)) + a810_sha_k[i] + w[i];
+		uint32_t t2 = (a810_rotr(a, 2) ^ a810_rotr(a, 13) ^ a810_rotr(a, 22)) + ((a & b2) ^ (a & c) ^ (b2 & c));
+		h = g; g = f; f = e; e = d + t1; d = c; c = b2; b2 = a; a = t1 + t2;
+	}
+	st[0] += a; st[1] += b2; st[2] += c; st[3] += d; st[4] += e; st[5] += f; st[6] += g; st[7] += h;
+}
+static void
+a810_sha256(const uint8_t *bytes, size_t length, uint8_t digest[32])
+{
+	uint32_t st[8] = {0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au, 0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u};
+	size_t at = 0;
+	uint8_t tail[64];
+	while (length - at >= 64) {
+		a810_sha_block(st, bytes + at);
+		at += 64;
+	}
+	size_t rest = length - at;
+	for (unsigned i = 0; i < 64; ++i) {
+		tail[i] = i < rest ? bytes[at + i] : 0;
+	}
+	tail[rest] = 0x80;
+	if (rest >= 56) {
+		a810_sha_block(st, tail);
+		for (unsigned i = 0; i < 64; ++i) {
+			tail[i] = 0;
+		}
+	}
+	uint64_t bits = (uint64_t)length * 8;
+	for (unsigned i = 0; i < 8; ++i) {
+		tail[63 - i] = (uint8_t)(bits >> (8 * i));
+	}
+	a810_sha_block(st, tail);
+	for (unsigned i = 0; i < 8; ++i) {
+		digest[i * 4] = (uint8_t)(st[i] >> 24);
+		digest[i * 4 + 1] = (uint8_t)(st[i] >> 16);
+		digest[i * 4 + 2] = (uint8_t)(st[i] >> 8);
+		digest[i * 4 + 3] = (uint8_t)st[i];
+	}
+}
