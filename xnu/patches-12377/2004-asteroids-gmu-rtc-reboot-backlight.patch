+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/*
+ * Nothing Phone (3a) "asteroids": the Adreno 810 GMU cold start (modes 6, 9 and 10 of sweet_a810.c).
+ *
+ * Ported from rootstockos UniXNU-sm7635-common kits/Sm7635Platform (c9e36f6; Copyright (c) 2026, UniXNU contributors.
+ * All rights reserved. BSD-2-Clause-Patent): ShengGmu.h, ShengGmuVotes.h, ShengGmuCommandDb.h, unchanged apart from
+ * being one header and ShengGmuConfig.any_firmware (the firmware pin made optional; the firmware now comes from the ADT).
+ */
+#ifndef SWEET_A810_GMU_H
+#define SWEET_A810_GMU_H
+#include "sweet_a810_hfi.h"
+
+/* ---- ShengGmu.h ---- */
+enum {ShengGmuCore,ShengGmuRscc,ShengGmuPdc,ShengGmuGpu,ShengGmuCxMisc,ShengGmuWindows};
+typedef enum {
+    ShengGmuSuccess,ShengGmuArgument,ShengGmuFirmware,ShengGmuBusy,
+    ShengGmuIoError,ShengGmuStateMismatch,ShengGmuTimeout,ShengGmuClockError,
+    ShengGmuPoisoned,ShengGmuFault,ShengGmuProtocolError
+} ShengGmuStatus;
+typedef struct {
+    void *cookie;
+    size_t bytes[ShengGmuWindows];
+    int (*read32)(void *,unsigned window,size_t byte_offset,uint32_t *);
+    int (*write32)(void *,unsigned window,size_t byte_offset,uint32_t);
+    int (*barrier)(void *);
+} ShengGmuIo;
+typedef struct {
+    void *cookie;
+    int (*sha256)(void *,const void *,size_t,uint8_t digest[32]);
+    int (*now_us)(void *,uint64_t *);
+    int (*wait_us)(void *,unsigned);
+} ShengGmuServices;
+typedef struct {volatile uint32_t *cpu;size_t bytes;uint64_t iova;} ShengGmuMemory;
+typedef struct {
+    uint32_t chip_id;
+    const uint8_t *firmware;size_t firmware_bytes;
+    ShengGmuMemory icache,dummy,debug,log,hfi;
+    unsigned poll_budget;
+    /* sweet: 0 requires the generated SHA-256/size/block-count pin; 1 accepts any image whose block records map
+     * into the ITCM, icache and DTCM regions (the SHA-256 is still computed and reported). */
+    unsigned any_firmware;
+} ShengGmuConfig;
+typedef struct {
+    ShengGmuIo io;ShengGmuServices services;AdrenoHfi hfi;
+    uint32_t poisoned,boot_attempted;
+    AdrenoHfiStartup startup;
+} ShengGmuDevice;
+typedef struct {
+    uint32_t phase,write_attempts,read_attempts,poll_reads;
+    uint32_t complete_hash_verified,memory_changed,reset_verified;
+    uint32_t firmware_init_result,hfi_status,firmware_ready_observed,hfi_ready_observed;
+    uint32_t ao_fault_status,cm3_fault_status;
+    uint32_t resources_must_retain;
+    uint8_t complete_sha256[32];
+} ShengGmuResult;
+
+/* Board-specific COLD start through firmware/HFI controller readiness.
+ * This is NOT a power/clock, SMMU ownership or production boot entry point.
+ * Caller must establish exclusive device/stream ownership; hold CX/GX,
+ * core/hub clocks at the verified A740 boot rates, RPMh/interconnect votes,
+ * fault interrupts and secure/platform prerequisites; install actual native4K
+ * GMU SMMU mappings; prove coherent CPU/GMU visibility and pin all storage.
+ * The GMU must already be held in reset and RSC idle, with retention cleared.
+ * This function verifies those readable states before mutating anything.
+ * It does not read silicon identity; chip_id must be from trusted discovery.
+ * It validates the complete pinned firmware hash before register writes,
+ * installs RSC/PDC setup and all payloads, verifies TCM payload readback,
+ * initializes HFI memory, configures/releases CM3 and polls fresh FW/HFI
+ * status with elapsed-time AND iteration bounds. No substituted ACK exists.
+ * The required hash/time/wait services must perform real operations.
+ * Memory extents are byte sizes, mapped with native4K pages, never 16K pages.
+ * Config/input/device/result/IO/services and all storage must be disjoint,
+ * immutable where applicable and retained for the device's lifetime.
+ * Virtual extent checks do not prove physical ownership or alias isolation;
+ * inspect actual CPU/GPU tables independently. A device allows one attempt.
+ * Use ColdStart below to also exchange the modern HFI startup messages.
+ * Debug draining, GPU submission and fault recovery are separate operations.
+ * Any failure after mutation attempts reset assertion and poisons the session.
+ * Even verified reset does NOT drain SMMU/bus traffic or authorize release;
+ * resources_must_retain stays true on all paths. No automatic retry is safe. */
+/* Result readiness fields are observations, never current-running assertions:
+ * a later failure may already have reasserted reset. */
+ShengGmuStatus ShengGmuLoadAndStartHfi(ShengGmuDevice *,const ShengGmuConfig *,ShengGmuResult *);
+
+typedef struct {
+    unsigned polls_per_command,wait_interval_us;
+    uint64_t command_timeout_us,total_timeout_us;
+} ShengGmuStartupLimits;
+typedef struct {
+    ShengGmuResult load;
+    AdrenoHfiStartupResult protocol;
+    AdrenoHfiStartupStatus protocol_status;
+    ShengGmuStatus health_status;
+} ShengGmuStartupResult;
+/* Full cold firmware/HFI startup sequence, under all LoadAndStartHfi platform
+ * preconditions above. Validate protocol/limits before any hardware mutation,
+ * then load firmware and exchange every required command with actual ACKs.
+ * Health checks reread reset/HFI status and fatal registers around commands.
+ * Supplied OPP/ARC/BCM/ACD data must be platform-derived; this function neither
+ * invents command-db values nor sets power, clocks, SMMU or AOSS policy.
+ * Any protocol failure after the load attempts reset and permanently poisons
+ * the device. A verified reset still does not authorize releasing mappings.
+ * Success covers firmware startup exchanges, NOT SQE/ZAP/GPU initialization,
+ * shader execution, submission, presentation or a complete hardware driver. */
+ShengGmuStatus ShengGmuColdStart(ShengGmuDevice *,const ShengGmuConfig *,
+    const AdrenoHfiStartupConfig *,const ShengGmuStartupLimits *,ShengGmuStartupResult *);
+
+typedef struct {volatile unsigned char *cpu;uint64_t physical;size_t bytes;} ShengGmuMmioWindow;
+typedef struct {ShengGmuMmioWindow windows[ShengGmuWindows];} ShengGmuMmio;
+/* Bind only already owned/powered Device mappings of exact pinned DT ranges.
+ * Uses direct AArch64 volatile 32-bit I/O + dsb sy. No map/allocation/power,
+ * pointer ownership proof or external-abort recovery is provided. */
+ShengGmuStatus ShengGmuBindMmio(ShengGmuMmio *,ShengGmuIo *);
+
+/* ---- ShengGmuVotes.h ---- */
+/* From UniXNU-sheng package/ShengGmuVotes.h (b0ccf61522383c5e4dda1091252c5534213aeba5), for the Adreno 810: the GPU
+ * levels come in SKU bins, so the inputs carry the SKU code (SHENG_GMU_VOTES_HAS_SKU tells callers the field exists). */
+typedef struct {const uint8_t *data;size_t bytes;} ShengGmuAux;
+typedef struct {uint32_t address;ShengGmuAux aux;} ShengGmuBcmInput;
+typedef struct {
+    uint32_t chip_id;
+    ShengGmuAux gfx,mx,cx,gmxc;
+    unsigned gmxc_present; /* 0=authoritatively absent, 1=present; unknown must refuse */
+    ShengGmuBcmInput sh0,mc0,acv;
+    uint32_t cn0_address;
+    unsigned enable_acd,enable_ifpc;
+    /* asteroids: the SoC code KGSL matches against each bin's qcom,sku-codes ((pcode << 16) | feature code, pcode
+     * only for internal parts). Bins are tried in device-tree order and a listed 0 matches any code, as KGSL's
+     * adreno_of_get_pwrlevels does; with sku_present 0 only such a bin can match. No other bin is guessed. */
+    uint32_t sku_code;
+    unsigned sku_present;
+} ShengGmuVoteInputs;
+#define SHENG_GMU_VOTES_HAS_SKU 1
+/* asteroids (A810): the bin listing sku_code, the A8xx GPU_PERF table (table_format 1) with MX dependency votes from
+ * the cmd-db mx.lvl rail, and the A8xx fixed-BCM rule from the generated policy. ACD is refused (the A810 catalog
+ * entry has none).
+ * Build only CPU-side configuration from pinned board OPP/catalog policy and
+ * actual cmd-db data supplied by the platform. No device read/write occurs.
+ * Missing GMxC data must not silently become absent: discovery errors defer
+ * this call. Caller authenticates chip/board/rail/resource ownership and must
+ * establish AOSS ACD/IFPC prerequisites before ColdStart, if requested here.
+ * Target pinned DT has no OPP speed-bin masks; every enabled OPP is retained.
+ * All input/aux/output storage is disjoint and immutable during the call.
+ * Failure leaves output unchanged. Software fixtures are not board evidence. */
+AdrenoHfiStartupStatus ShengGmuBuildStartup(const ShengGmuVoteInputs *,AdrenoHfiStartupConfig *);
+/* The HFI GX_BW_PERF_VOTE indices for GPU OPP `perf` (1 = lowest real level, clamped to the table): the OPP index and the
+ * bandwidth-table index of that OPP's opp-peak-kBps, the pairing a6xx_gmu.c votes. Returns the OPP index used.
+ * asteroids: of the bin selected by the last successful ShengGmuBuildStartup; 0 (no bin) before that. */
+unsigned ShengGmuPerfVote(unsigned perf,unsigned *bandwidth);
+
+/* ---- ShengGmuCommandDb.h ---- */
+typedef enum {ShengGmuDbSuccess,ShengGmuDbArgument,ShengGmuDbVersion,
+    ShengGmuDbCorrupt,ShengGmuDbDuplicate,ShengGmuDbMissing} ShengGmuDbStatus;
+/* Parse an immutable CPU-readable snapshot of the complete pinned DT command
+ * DB reservation. No mapping, MMIO or allocation. Caller must obtain/retain
+ * actual platform-owned bytes coherently and bind expected_version from an
+ * independently qualified platform policy; reading that word and passing it
+ * back is not version qualification. No version is guessed here.
+ * The format's checksum is unused by the source; this parser does NOT verify
+ * provenance/integrity/authenticity. All offsets/counts are checked, with a
+ * 4096-entry bound and unique target records. Missing GMxC is authoritative
+ * only after the complete structurally valid database has been scanned.
+ * Output contains aliases into input, must be disjoint and retained/immutable
+ * through startup configuration construction. Failure leaves output unchanged.
+ * Output must be initialized. Chip identity and optional features are caller
+ * policy; this sets
+ * only cmd-db fields and preserves those policy fields. No hardware readiness
+ * follows from parsing, and malformed data never permits a power operation. */
+ShengGmuDbStatus ShengGmuCommandDbInputs(const uint8_t *,size_t,uint32_t expected_version,ShengGmuVoteInputs *);
+
+/* ---- sweet: the generated pins (sweet_a810_gmu_source.h) ---- */
+/* physical base of ShengGmu window `window` (ShengGmuCore..ShengGmuCxMisc) and its size; 0/0 for the absent PDC */
+uint64_t sweet_a810_gmu_window(unsigned window, size_t *bytes);
+/* the pinned SHA-256 (32 bytes), size and block-record count of this phone's gen80300_gmu.bin */
+const uint8_t *sweet_a810_gmu_firmware_pin(size_t *bytes, unsigned *blocks);
+uint32_t sweet_a810_gmu_chip_id(void);
+/* the AOP command DB reservation */
+uint64_t sweet_a810_cmd_db(size_t *bytes);
+/* the frequency of GPU level `perf` in the bin ShengGmuBuildStartup selected; 0 before that */
+uint64_t sweet_a810_gpu_level_hz(unsigned perf);
+#endif /* SWEET_A810_GMU_H */
