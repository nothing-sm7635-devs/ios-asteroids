+	uint64_t db_pa = sweet_a810_cmd_db(&db_bytes);
+	printf("SWEET A810: next: read the command DB %#llx + %#zx\n", db_pa, db_bytes);
+	vm_offset_t db = ml_io_map(db_pa, db_bytes);
+	uint8_t *copy = kalloc_data(db_bytes, Z_WAITOK);   /* kept: the vote inputs point into it */
+	if (db == 0 || copy == NULL) {
+		printf("SWEET A810: stage 6 clocks %s, cmddb map/copy failed\n", a810_clocks.done ? "read" : "skipped");
+		return 1;                      /* rootstockos: only stage 10's gate needs the table */
+	}
+	for (size_t i = 0; i < db_bytes / 4; ++i) {
+		uint32_t w = ((const volatile uint32_t *)db)[i];
+		__asm__ volatile ("dsb sy" ::: "memory");
+		copy[4 * i] = (uint8_t)w;
+		copy[4 * i + 1] = (uint8_t)(w >> 8);
+		copy[4 * i + 2] = (uint8_t)(w >> 16);
+		copy[4 * i + 3] = (uint8_t)(w >> 24);
+	}
+	uint32_t version = gpb_le32(copy), magic = gpb_le32(copy + 4);
+	a810_votes = (ShengGmuVoteInputs){0};
+	a810_votes.chip_id = sweet_a810_gmu_chip_id();   /* A810; sku_present 0: the bin listing 0 (KGSL's rule) */
+	/* As rootstockos (and uke): the version passed is the word just read, so a pass shows the layout only. */
+	unsigned parse = ShengGmuCommandDbInputs(copy, db_bytes, version, &a810_votes);
+	unsigned build = ~0u;
+	if (parse == ShengGmuDbSuccess) {
+		build = ShengGmuBuildStartup(&a810_votes, &a810_startup);
+	}
+	a810_db_status[0] = version;
+	a810_db_status[1] = magic;
+	a810_db_status[2] = parse;
+	a810_db_status[3] = build;
+	const AdrenoHfiStartupConfig *c = &a810_startup;
+	printf("SWEET A810: stage 6 clocks %s pll0 %#x gmu_rcg %#x hub_rcg %#x; cmddb v %#x magic %#x parse %u %s build %d "
+	    "gmxc %u aux gfx %u cx %u mx %u sh0 %u mc0 %u acv %u cn0 %#x; hfi gpu %u gmu %u bw %u\n",
+	    a810_clocks.done ? "read" : "skipped", a810_clocks.pll0_mode, a810_clocks.gmu_cmd, a810_clocks.hub_cmd,
+	    version, magic, parse, parse < 6 ? db_text[parse] : "?", (int)build, a810_votes.gmxc_present,
+	    (unsigned)a810_votes.gfx.bytes, (unsigned)a810_votes.cx.bytes, (unsigned)a810_votes.mx.bytes,
+	    (unsigned)a810_votes.sh0.aux.bytes, (unsigned)a810_votes.mc0.aux.bytes, (unsigned)a810_votes.acv.aux.bytes,
+	    a810_votes.cn0_address, build == 0 ? c->gpu_count : 0, build == 0 ? c->gmu_count : 0,
+	    build == 0 ? c->bandwidth_count : 0);
+	if (parse != ShengGmuDbSuccess) {
+		/* the slave table (cmd_db_header.header[i], 16 bytes from offset 8: le16 slv_id, ..., le16 cnt at +6) */
+		for (unsigned i = 0; i < 8; ++i) {
+			uint32_t id = gpb_le16(copy + 8 + 16 * i), cnt = gpb_le16(copy + 8 + 16 * i + 6);
+			if (!id) {
+				break;
+			}
+			printf("SWEET A810: cmddb slave %u id %#x cnt %u\n", i, id, cnt);
+		}
+	} else if (build == 0) {
+		printf("SWEET A810: hfi table %u ifpc %u cnoc %u ddr %u\n", c->table_format, c->enable_ifpc, c->cnoc_count,
+		    c->ddr_count);
+		for (unsigned i = 0; i < c->gpu_count && i < 16; ++i) {
+			printf("SWEET A810: hfi gpu%u %llu kHz vote %#x dep %#x\n", i, c->gpu[i].hz / 1000, c->gpu[i].vote,
+			    c->gpu_dependency[i]);
+		}
+		for (unsigned i = 0; i < c->gmu_count && i < 4; ++i) {
+			printf("SWEET A810: hfi gmu%u %llu kHz vote %#x\n", i, c->gmu[i].hz / 1000, c->gmu[i].vote);
+		}
+	}
+	return 1;
+}
+
+/* ---- Stage 7: GMU clocks on (gmuClocksOn); the GMU stays in reset ---- */
+static struct gpb_gmu_clock_on a810_clock_on;
+
+static int
+a810_stage7(const struct gpb_result *r)
+{
+	static const char *const fail[] = {"ok", "refused", "timeout", "io"};
+	struct gpb_result scratch = *r;
+	struct gpb_gmu_clock_on *o = &a810_clock_on;
+	printf("SWEET A810: next: GMU clocks on: GPLL0 vote, PLL0 700 MHz, hub 200 MHz, gmu 350 MHz, gpu_cc_ahb\n");
+	a810_clocks_on = 1;
+	gpb_gmu_clocks_on(&a810_io, &scratch, &a810_clocks, o);
+	a810_clocks_on = 0;
+	printf("SWEET A810: stage 7 gmuclk on step %u %s writes %u running %u lock %u hub %u/%u gmu %u/%u vote %#x "
+	    "pll0 %#x/%#x/%#x hub %#x/%#x gmu %#x/%#x ahb %#x\n", o->step, o->failed < 4 ? fail[o->failed] : "?", o->writes,
+	    o->pll_was_running, o->lock_polls, o->hub_root_polls, o->hub_polls, o->gmu_root_polls, o->gmu_polls, o->vote,
+	    o->pll0_mode, o->pll0_opmode, o->pll0_user, o->hub_cmd, o->hub_cfg, o->gmu_cmd, o->gmu_cfg, o->ahb);
+	struct gpb_gmu_clocks after;
+	gpb_read_gmu_clocks(&a810_io, &scratch, &after);
+	if (after.done) {
+		a810_log_clocks("after", &after, scratch.io_error);
+	}
+	if (o->step != 8 || o->failed) {
+		a810_gate_failed(8, "GMU clocks not on (stage 7)");
+		return 0;
+	}
+	return 1;
+}
+
+/* ---- Stage 8: GMU and RSCC state (gmuState); reads only ---- */
+static struct gpb_gmu_state a810_gmu_state;
+
+static int
+a810_stage8(const struct gpb_result *r)
+{
+	for (unsigned w = GPB_WINDOWS; w < GPB_ALL_WINDOWS; ++w) {
+		a810_win[w] = ml_io_map(a810_win_pa[w], a810_win_size[w]);
+	}
+	if (!a810_win[GPB_WIN_GMU] || !a810_win[GPB_WIN_RSCC]) {
+		printf("SWEET A810: gmu map failed gmu %d rscc %d\n", a810_win[GPB_WIN_GMU] != 0, a810_win[GPB_WIN_RSCC] != 0);
+		a810_gate_failed(8, "GMU/RSCC map failed");
+		return 0;
+	}
+	struct gpb_result scratch = *r;
+	struct gpb_gmu_state *g = &a810_gmu_state;
+	gpb_read_gmu_state(&a810_io, &scratch, 1, g);
+	const uint32_t *v = g->v;
+	printf("SWEET A810: stage 8 gmu gate %s reset %#x hfi %#x ao %#x cm3 %#x rscc %#x io %d\n",
+	    gpb_gmu_state_text(g->gate), v[0], v[1], v[2], v[3], g->rscc_busy, g->io_error);
+	if (g->done && !g->io_error) {
+		printf("SWEET A810: gmu init %#x boot %#x cfg %#x gen8 %#x gen9 %#x gen10 %#x fence %#x\n", v[4], v[5], v[6],
+		    v[7], v[8], v[9], v[10]);
+		printf("SWEET A810: gmu itcm0 %#x dtcm_ver %#x ao %#x:%#x then %#x (+%u)\n", v[11], v[12], v[14], v[13], v[15],
+		    v[15] - v[13]);
+	}
+	return 1;
+}
+
+/* ---- Stages 9-10: GMU firmware load to HFI ready, the whole cold start (gmuColdStart) ---- */
+static ShengGmuMmio a810_cold_mmio;     /* the cold start's windows and device; stage 11 keeps using them */
+static ShengGmuDevice a810_cold;
+static ShengGmuConfig a810_cold_config;
+static ShengGmuStartupResult a810_cold_result;
+static int a810_gmu_started;
+
+static int
+a810_svc_sha256(void *cookie, const void *bytes, size_t length, uint8_t digest[32])
+{
+	(void)cookie;
+	a810_sha256(bytes, length, digest);
+	return 0;
+}
+static int
+a810_svc_now_us(void *cookie, uint64_t *out)
+{
+	uint64_t ns = 0;
+	(void)cookie;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	*out = ns / 1000;
+	return 0;
+}
+static int
+a810_svc_wait_us(void *cookie, unsigned us)
+{
+	(void)cookie;
+	delay(us);
+	return 0;
+}
+
+/* /sweet-gpu property `name`, copied into an aligned kalloc buffer that lives for the boot. */
+static const uint8_t *
+a810_adt_blob(const char *name, size_t *bytes)
+{
+	DTEntry node;
+	const void *data = NULL;
+	unsigned int size = 0;
+	*bytes = 0;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, name, &data, &size) != kSuccess || size == 0 || size > A810_FW_MAX) {
+		return NULL;
+	}
+	uint8_t *copy = kalloc_data(size, Z_WAITOK);
+	if (!copy) {
+		return NULL;
+	}
+	for (unsigned i = 0; i < size; ++i) {
+		copy[i] = ((const uint8_t *)data)[i];
+	}
+	*bytes = size;
+	return copy;
+}
+
+/* The size of /sweet-gpu property `name`, 0 when absent (the SQE and zap images are only reported until stage 12). */
+static size_t
+a810_adt_size(const char *name)
+{
+	DTEntry node;
+	const void *data = NULL;
+	unsigned int size = 0;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, name, &data, &size) != kSuccess) {
+		return 0;
+	}
+	return size;
+}
+
+static void
+a810_gmu_reset(const char *why)
+{
+	ShengGmuIo *io = &a810_cold.io;
+	uint32_t v = ~0u;
+	if (!io->write32 || !a810_gmu_started) {
+		return;
+	}
+	int bad = io->write32(io->cookie, ShengGmuCore, GPB_GMU_CM3_SYSRESET, 1) || io->barrier(io->cookie) ||
+	    io->read32(io->cookie, ShengGmuCore, GPB_GMU_CM3_SYSRESET, &v);
+	printf("SWEET A810: %s: GMU back in reset: CM3_SYSRESET %#x%s\n", why, v, bad || v != 1 ? " (NOT verified)" : "");
+}
+
+static int
+a810_stage9(void)
+{
+	static const char *const sheng_text[] = {"ok", "argument", "firmware", "busy", "io", "state-mismatch", "timeout",
+		                                 "clock", "poisoned", "fault", "protocol"};
+	const struct gpb_gmu_state *g = &a810_gmu_state;
+	const int table = a810_db_status[1] == 0x0c0330dbu && a810_db_status[2] == 0 && a810_db_status[3] == 0;
+	if (!g->done || g->gate) {
+		a810_gate_failed(9, g->done ? gpb_gmu_state_text(g->gate) : "GMU state not read");
+		return 0;
+	}
+	if (!a810_ctx_ready) {
+		a810_gate_failed(9, "GMU SMMU context not ready (stage 5)");
+		return 0;
+	}
+	if (a810_mode >= 10 && !table) {
+		a810_gate_failed(10, "no HFI startup table (stage 6 command DB)");
+		return 0;
+	}
+
+	/* The firmware from the ADT, checked before anything is written. */
+	size_t fw_bytes = 0, pin_bytes = 0;
+	unsigned pin_blocks = 0, any = 0, pin = 1;
+	const uint8_t *fw = a810_adt_blob("gmu-firmware", &fw_bytes);
+	printf("SWEET A810: ADT /sweet-gpu gmu-firmware %zu bytes, sqe-firmware %zu, zap-mbn %zu\n", fw_bytes,
+	    a810_adt_size("sqe-firmware"), a810_adt_size("zap-mbn"));
+	if (!fw) {
+		a810_gate_failed(9, "no gmu-firmware in the ADT (/sweet-gpu)");
+		return 0;
+	}
+	PE_parse_boot_argn("sweeta810fwpin", &pin, sizeof(pin));
+	any = pin ? 0 : 1;
+	uint8_t digest[32];
+	a810_sha256(fw, fw_bytes, digest);
+	const uint8_t *want = sweet_a810_gmu_firmware_pin(&pin_bytes, &pin_blocks);
+	int pinned = fw_bytes == pin_bytes;
+	for (unsigned i = 0; i < 32; ++i) {
+		pinned &= digest[i] == want[i];
+	}
+	const AdrenoFirmwareRegion regions[] = {{0, 0x4000, 1}, {0x4000, 0xffc000, 2}, {0x10004000, 0x4000, 3}};
+	AdrenoFirmwareBlock blocks[32];
+	size_t count = 0;
+	AdrenoFirmwareResult plan = AdrenoFirmwarePlanGmu(fw, fw_bytes, regions, 3, blocks, 32, &count);
+	printf("SWEET A810: gmu firmware sha256 %02x%02x%02x%02x%02x%02x%02x%02x... %s pin, plan %u, %zu blocks (pin %u)\n",
+	    digest[0], digest[1], digest[2], digest[3], digest[4], digest[5], digest[6], digest[7],
+	    pinned ? "matches the" : "differs from the", plan, count, pin_blocks);
+	if (plan != AdrenoFirmwareSuccess) {
+		a810_gate_failed(9, "gmu-firmware block records do not map into ITCM/icache/DTCM");
+		return 0;
+	}
+	if (!pinned && !any) {
+		a810_gate_failed(9, "gmu-firmware is not the pinned image (boot-arg sweeta810fwpin=0 accepts it)");
+		return 0;
+	}
+
+	/* GMU, RSCC (stage 8's maps), no PDC on A8xx, the GPU block (GBIF) and CX_MISC, in ShengGmu window order. */
+	ShengGmuMmio *mmio = &a810_cold_mmio;
+	const unsigned extra[2] = {ShengGmuGpu, ShengGmuCxMisc};
+	for (unsigned i = 0; i < 2; ++i) {
+		size_t bytes;
+		uint64_t pa = sweet_a810_gmu_window(extra[i], &bytes);
+		vm_offset_t va = ml_io_map(pa, bytes);
+		if (!va) {
+			printf("SWEET A810: gmuboot map of window %u failed\n", extra[i]);
+			a810_gate_failed(9, "window map failed");
+			return 0;
+		}
+		mmio->windows[extra[i]] = (ShengGmuMmioWindow){(volatile unsigned char *)va, pa, bytes};
+	}
+	mmio->windows[ShengGmuCore] = (ShengGmuMmioWindow){(volatile unsigned char *)a810_win[GPB_WIN_GMU], GPB_GMU_BASE,
+		                                           (size_t)GPB_GMU_SIZE};
+	mmio->windows[ShengGmuRscc] = (ShengGmuMmioWindow){(volatile unsigned char *)a810_win[GPB_WIN_RSCC], GPB_RSCC_BASE,
+		                                           (size_t)GPB_RSCC_SIZE};
+	ShengGmuStatus bind = ShengGmuBindMmio(mmio, &a810_cold.io);
+	if (bind != ShengGmuSuccess) {
+		printf("SWEET A810: gmuboot bind refused (%u)\n", bind);
+		a810_gate_failed(9, "MMIO bind refused");
+		return 0;
+	}
+	/* The payloads, in the pool's write-combined mapping (Normal non-cacheable, like the GMU's MAIR index 0). */
+	struct a810_gmu_payload p[A810_PAYLOADS];
+	if (a810_gmu_context_payloads(p)) {
+		a810_gate_failed(9, "no payloads");
+		return 0;
+	}
+	ShengGmuConfig *c = &a810_cold_config;
+	ShengGmuMemory *memory[A810_PAYLOADS] = {&c->icache, &c->dummy, &c->debug, &c->log, &c->hfi};
+	for (unsigned i = 0; i < A810_PAYLOADS; ++i) {
+		*memory[i] = (ShengGmuMemory){p[i].cpu, (size_t)p[i].bytes, p[i].iova};
+	}
+	c->chip_id = sweet_a810_gmu_chip_id();
+	c->firmware = fw;
+	c->firmware_bytes = fw_bytes;
+	c->poll_budget = 100;                  /* ShengGmu's poll: 100 us apart and at most 10 ms in all */
+	c->any_firmware = any;
+	a810_cold.services = (ShengGmuServices){NULL, a810_svc_sha256, a810_svc_now_us, a810_svc_wait_us};
+	ShengGmuStartupResult *s = &a810_cold_result;
+	ShengGmuStatus status;
+	printf("SWEET A810: next: %s: firmware %zu bytes, hfi@%#llx log@%#llx\n",
+	    a810_mode >= 10 ? "GMU cold start with the HFI startup" : "GMU load to HFI ready", fw_bytes, c->hfi.iova,
+	    c->log.iova);
+	a810_gmu_started = 1;                  /* from here a failure puts the GMU back in reset */
+	if (a810_mode >= 10) {
+		const ShengGmuStartupLimits limits = {1000, 100, 100000, 1000000};   /* 100 ms per command, 1 s in all */
+		status = ShengGmuColdStart(&a810_cold, c, &a810_startup, &limits, s);
+	} else {
+		*s = (ShengGmuStartupResult){0};
+		status = ShengGmuLoadAndStartHfi(&a810_cold, c, &s->load);
+	}
+	const ShengGmuResult *l = &s->load;
+	printf("SWEET A810: stage 9 gmuboot %s phase %u hash %u reset_ok %u fw_ready %u hfi_ready %u init %#x hfi %#x "
+	    "writes %u reads %u polls %u ao %#x cm3 %#x\n", status < 11 ? sheng_text[status] : "?", l->phase,
+	    l->complete_hash_verified, l->reset_verified, l->firmware_ready_observed, l->hfi_ready_observed,
+	    l->firmware_init_result, l->hfi_status, l->write_attempts, l->read_attempts, l->poll_reads, l->ao_fault_status,
+	    l->cm3_fault_status);
+	if (a810_mode >= 10) {
+		const AdrenoHfiStartupResult *q = &s->protocol;
+		printf("SWEET A810: stage 10 hfi startup %u stage %u acked %#x sent %u polls %u fw_err %#x hdr %#x t %lluus "
+		    "health %u skipped %u (%#x)\n", s->protocol_status, q->stage, q->acknowledged_stages, q->published_commands,
+		    q->poll_reads, q->firmware_error, q->wire_header, q->elapsed_us, s->health_status, a810_cold.hfi.skipped,
+		    a810_cold.hfi.skipped_header);
+	}
+	/* The GMU's own view afterwards: reset, FW_INIT_RESULT, HFI status, its always-on counter and its log's first words. */
+	uint32_t after[4] = {0};
+	const uint32_t regs[4] = {GPB_GMU_CM3_SYSRESET, GPB_GMU_CM3_FW_INIT_RESULT, GPB_GMU_HFI_CTRL_STATUS, GPB_GMU_AO_COUNTER_L};
+	for (unsigned i = 0; i < 4; ++i) {
+		a810_cold.io.read32(a810_cold.io.cookie, ShengGmuCore, regs[i], &after[i]);
+	}
+	printf("SWEET A810: gmuboot after reset %#x init %#x hfi %#x ao %#x log %#x %#x %#x %#x\n", after[0], after[1],
+	    after[2], after[3], c->log.cpu[0], c->log.cpu[1], c->log.cpu[2], c->log.cpu[3]);
+	if (status != ShengGmuSuccess) {
+		/* ShengGmu reasserted reset itself on any failure after its first write; say whether that held. */
+		printf("SWEET A810: stage %u failed (%s); ShengGmu reset_verified %u\n", a810_mode >= 10 ? 10u : 9u,
+		    status < 11 ? sheng_text[status] : "?", l->reset_verified);
+		if (!l->reset_verified && l->write_attempts) {
+			a810_gmu_reset("cold start failed");
+		}
+		return 0;
+	}
+	if (a810_mode == 9) {
+		printf("SWEET A810: GMU running at HFI ready (no startup messages in mode 9)\n");
+	}
+	return 1;
+}
+
+/* ---- Stage 11: GX on (gpuGx), through the cold start's MMIO adapter; no GPU-block writes ---- */
+static struct gpb_gx a810_gx;
+
+static int
+a810_gx_read(void *cookie, unsigned w, uint32_t off, uint32_t *out)
+{
+	ShengGmuIo *io = &a810_cold.io;
+	(void)cookie;
+	if (w != GPB_WIN_GMU && w != GPB_WIN_GPU) {
+		return 1;
+	}
+	return io->read32(io->cookie, w == GPB_WIN_GMU ? ShengGmuCore : ShengGmuGpu, off, out);
+}
+static int
+a810_gx_write(void *cookie, unsigned w, uint32_t off, uint32_t value)
+{
+	ShengGmuIo *io = &a810_cold.io;
+	(void)cookie;
+	if (w != GPB_WIN_GMU) {
+		return 1;                      /* the GPU block is written only from stage 13 (hw_init) */
+	}
+	return io->write32(io->cookie, ShengGmuCore, off, value) || io->barrier(io->cookie);
+}
+static int
+a810_hfi_wait_once(void *cookie)
+{
+	(void)cookie;
+	delay(100);
+	return 0;
+}
+static int
+a810_gx_vote(void *cookie, uint32_t perf, uint32_t bw, uint32_t *firmware_error)
+{
+	const uint32_t vote[3] = {1, perf, bw};   /* a6xx_hfi_gx_bw_perf_vote_cmd: ack_type 1 (blocking), freq, bw */
+	uint32_t out[16];
+	size_t count = 0;
+	(void)cookie;
+	return AdrenoHfiExchange(&a810_cold.hfi, 30, vote, 3, 1000, a810_hfi_wait_once, out, 16, &count, firmware_error);
+}
+
+static int
+a810_stage11(void)
+{
+	static const char *const fail[] = {"ok", "vote", "no-ack", "io", "gx-off"};
+	unsigned level = 6, bw = 0;
+	PE_parse_boot_argn("sweeta810level", &level, sizeof(level));
+	const unsigned perf = ShengGmuPerfVote(level, &bw);
+	printf("SWEET A810: next: GX: HFI vote perf %u bw %u (%llu kHz, sweeta810level=%u), then OOB GPU_SET\n", perf, bw,
+	    sweet_a810_gpu_level_hz(perf) / 1000, level);
+	const struct gpb_gx_io io = {NULL, a810_gx_read, a810_gx_write, a810_gx_vote, a810_delay_us};
+	struct gpb_gx *x = &a810_gx;
+	gpb_gx_on(&io, perf, bw, x);
+	uint32_t gdscr = 0;
+	a810_read32(NULL, GPB_WIN_GPUCC, GPB_CC_GX_GDSCR, &gdscr);
+	printf("SWEET A810: stage 11 gx %s step %u vote %u fw %#x oob %u info %#x pwr_clk %#x>%#x later %#x rbbm %#x gfx %#x "
