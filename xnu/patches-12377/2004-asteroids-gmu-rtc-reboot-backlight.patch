diff --git a/bsd/dev/sweet_reboot.c b/bsd/dev/sweet_reboot.c
index 50daaba..ae879f9 100644
--- a/bsd/dev/sweet_reboot.c
+++ b/bsd/dev/sweet_reboot.c
@@ -196,6 +196,164 @@ sr_pon_set_reason(unsigned magic)
 	printf("SWEET REBOOT: PON_SOFT_RB_SPARE 0x88f 0x%02x -> 0x%02x (read back 0x%02x)\n", old, upd, back);
 }
 
+/*
+ * Nothing Phone (3a) (asteroids): reboot into the bootloader's fastboot, never into Android (a plain reset boots the
+ * boot partition = Android, whose fstab formats userdata, the iOS root). As Android's `reboot bootloader` does on this
+ * phone (live DT reboot_reason -> nvmem cell restart@48 bits <1 7> of PMK8550 sdam@7100; drivers/power/reset/
+ * qcom-reboot-reason.c: bootloader = 0x02; qcom-spmi-sdam.c: register = peripheral base + offset): write reason 2 into
+ * bits [7:1] of SID 0 register 0x7148, then PSCI SYSTEM_RESET (psci_sys_reset; no IMEM cookie, no PS_HOLD here).
+ * Through SPMI arbiter v7 (spmi-pmic-arb.c): APID of PPID 0x071 from the map at core + 0x2000 + 4n (owner = cnfg + 4n,
+ * & 7, must be EE 0), reads through the observer (0x0c440000 + 0x20 * apid), the write through the EE's channel
+ * (0x0c500000 + 0x1000 * apid: WDATA0 +0x10, then CMD +0x00 = EXT_WRITEL (opcode 0) | addr << 4 | (bytes - 1),
+ * STATUS +0x08: bit 0 done, bits 1-3 failure/denied/dropped).
+ * The reset happens only after the write completed cleanly and reads back as reason 2; otherwise nothing resets.
+ */
+#define SA_CORE_PA      0x0c400000u
+#define SA_CNFG_PA      0x0c42d000u
+#define SA_OBS_PA       0x0c440000u
+#define SA_CHNLS_PA     0x0c500000u
+#define SA_PPID_SDAM71  0x071u
+#define SA_REASON_REG   0x48u           /* in peripheral 0x71: 0x7148 */
+#define SA_REASON_BOOTLOADER 0x02u
+
+static volatile uint32_t *sa_obs, *sa_chnl;
+static int sa_apid = -1;
+static bool sa_ready;
+
+/* ml_io_map works on whole kernel pages (16 KiB here): map the page holding pa and point into it. */
+static volatile uint32_t *
+sa_map(uint32_t pa)
+{
+	vm_offset_t base = ml_io_map(pa & ~(uint32_t)PAGE_MASK, PAGE_SIZE);
+	return base ? (volatile uint32_t *)(base + (pa & PAGE_MASK)) : NULL;
+}
+
+static bool
+sa_wait(volatile uint32_t *ch, uint32_t *status)
+{
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t st = ch[0x08 / 4];
+		if (st & 1u) {
+			*status = st;
+			return (st & 0x0eu) == 0;
+		}
+		delay(10);
+	}
+	*status = 0xffffffffu;
+	return false;
+}
+
+static bool
+sa_read(uint8_t *out)
+{
+	uint32_t st;
+
+	sa_obs[0x00 / 4] = (1u << 27) | (SA_REASON_REG << 4);     /* EXT_READL, one byte */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (!sa_wait(sa_obs, &st)) {
+		return false;
+	}
+	*out = (uint8_t)sa_obs[0x18 / 4];
+	return true;
+}
+
+/* Boot time, read only: find and map what the reboot needs, and say what the reason byte holds now. */
+void
+sweet_reboot_asteroids_init(void)
+{
+	volatile uint32_t *core = (volatile uint32_t *)ml_io_map(SA_CORE_PA, 0x3000);
+	volatile uint32_t *cnfg = (volatile uint32_t *)ml_io_map(SA_CNFG_PA, 0x4000);
+	uint32_t ver, count, map, owner = 0;
+	uint8_t reason = 0;
+
+	if (!sweet_board_asteroids() || core == NULL || cnfg == NULL) {
+		return;
+	}
+	ver = core[0];
+	count = core[1] & 0x7ffu;
+	if (ver < 0x70000000u || ver >= 0x80000000u || count > 0x380u) {
+		printf("SWEET REBOOT: asteroids: arbiter version %#x / %u APIDs not v7: no reboot to fastboot
+", ver, count);
+		return;
+	}
+	for (uint32_t n = 0; n < count; n++) {
+		map = core[(0x2000u + 4u * n) / 4];
+		if (map == 0 || ((map >> 8) & 0xfffu) != SA_PPID_SDAM71) {
+			continue;
+		}
+		owner = cnfg[(4u * n) / 4] & 7u;
+		printf("SWEET REBOOT: asteroids: PPID 0x071 (SDAM 0x7100) APID %u, written by EE %u
+", n, owner);
+		if (owner == 0 && sa_apid < 0) {
+			sa_apid = (int)n;
+		}
+	}
+	if (sa_apid < 0 || (uint32_t)sa_apid * 0x20u + 0x20u > 0x8000u) {
+		printf("SWEET REBOOT: asteroids: no EE 0 channel for the reboot reason: restart stops instead of resetting
+");
+		return;
+	}
+	sa_obs = sa_map(SA_OBS_PA + 0x20u * (uint32_t)sa_apid);
+	sa_chnl = sa_map(SA_CHNLS_PA + 0x1000u * (uint32_t)sa_apid);
+	if (sa_obs == NULL || sa_chnl == NULL || !sa_read(&reason)) {
+		printf("SWEET REBOOT: asteroids: reason register not readable: restart stops instead of resetting
+");
+		return;
+	}
+	sa_ready = true;
+	printf("SWEET REBOOT: asteroids: 0x7148 = 0x%02x (reason %u); restart and power off go to fastboot
+",
+	    reason, reason >> 1);
+}
+
+/* Returns only if it did not reset (nothing was reset, the reason may or may not be stored). */
+static void
+sa_reboot_bootloader(void)
+{
+	uint8_t old = 0, back = 0, upd;
+	uint32_t st;
+
+	if (!sa_ready || !sa_read(&old)) {
+		printf("SWEET REBOOT: asteroids: reason register not ready, no reset
+");
+		return;
+	}
+	upd = (uint8_t)((old & 0x01u) | (SA_REASON_BOOTLOADER << 1));
+	if (upd != old) {
+		sa_chnl[0x10 / 4] = upd;                                    /* WDATA0 */
+		__asm__ volatile ("dsb sy" ::: "memory");
+		sa_chnl[0x00 / 4] = (0u << 27) | (SA_REASON_REG << 4);       /* EXT_WRITEL, one byte */
+		__asm__ volatile ("dsb sy" ::: "memory");
+		if (!sa_wait(sa_chnl, &st)) {
+			printf("SWEET REBOOT: asteroids: reason write 0x%02x -> 0x%02x failed (status %#x), no reset
+", old, upd, st);
+			return;
+		}
+	}
+	if (!sa_read(&back) || (back >> 1) != SA_REASON_BOOTLOADER) {
+		printf("SWEET REBOOT: asteroids: reason reads back 0x%02x, not bootloader, no reset
+", back);
+		return;
+	}
+	printf("SWEET REBOOT: asteroids: 0x7148 0x%02x -> 0x%02x (bootloader), PSCI SYSTEM_RESET
+", old, back);
+	delay(100 * 1000);
+	sr_psci_system_reset();
+	delay(2000 * 1000);
+	printf("SWEET REBOOT: asteroids: PSCI SYSTEM_RESET returned
+");
+}
+
+/* SweetPlatformExpert: power off on asteroids also goes to fastboot (a later power-on would boot Android). */
+void
+sweet_reboot_asteroids_halt(void)
+{
+	(void)sweet_ufs_flush_final();
+	sa_reboot_bootloader();
+	panic("SWEET: iOS asked to power off and the reboot to fastboot did not happen. On the Nothing Phone (3a) a "
+	    "power cycle boots Android, which formats the iOS root: hold Power + Volume down for fastboot instead");
+}
+
 /* Called by SweetPlatformExpert::haltRestart for panic notifications. */
