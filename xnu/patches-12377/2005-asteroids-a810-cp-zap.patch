+	static const uint64_t iovas[A810_PAYLOADS] = {A810_GMU_ICACHE_IOVA, A810_GMU_UNCACHED_IOVA, A810_GMU_DEBUG_IOVA,
+		                                      A810_GMU_UNCACHED_IOVA + 0x4000, A810_GMU_UNCACHED_IOVA + 0x8000};
+	static const unsigned perms[A810_PAYLOADS] = {15u, 3u, 3u, 3u, 3u};
+	return ctx_bringup(&gmu_ctx, smmu, smmu_bytes, pool_pa, pool_va, pool_bytes, A810_PAYLOADS, sizes, iovas, perms, bank,
+	           asid, slot, sid, progress, report);
+}
+
+int
+a810_gmu_context_payloads(struct a810_gmu_payload out[A810_PAYLOADS])
+{
+	if (!out || !gmu_ctx.ready) {
+		return 1;
+	}
+	for (unsigned i = 0; i < A810_PAYLOADS; ++i) {
+		out[i] = gmu_ctx.payload[i];
+	}
+	return 0;
+}
+
+uint64_t
+a810_gmu_context_pool_used(void)
+{
+	return gmu_ctx.ready ? gmu_ctx.pool_used : 0;
+}
+
+int
+a810_gpu_context_bringup(volatile uint8_t *smmu, size_t smmu_bytes, uint64_t pool_pa, volatile uint8_t *pool_va,
+    uint64_t pool_bytes, unsigned bank, unsigned asid, unsigned slot, unsigned sid, void (*progress)(uint32_t step),
+    struct a810_gmu_context_report *report)
+{
+	/* NativeAdrenoGpuContext.h: sqe 128 KiB R+X (adreno_fw_create_bo maps it read-only, without NOEXEC), ring 32 KiB,
+	 * memptrs, pwrup and scratch one page each, read/write. */
+	static const uint64_t sizes[A810_GPU_BUFFERS] = {0x20000, 0x8000, 0x1000, 0x1000, 0x1000};
+	static const uint64_t iovas[A810_GPU_BUFFERS] = {A810_GPU_SQE_IOVA, A810_GPU_RING_IOVA, A810_GPU_MEMPTRS_IOVA,
+		                                         A810_GPU_PWRUP_IOVA, A810_GPU_SCRATCH_IOVA};
+	static const unsigned perms[A810_GPU_BUFFERS] = {5u, 3u, 3u, 3u, 3u};
+	return ctx_bringup(&gpu_ctx, smmu, smmu_bytes, pool_pa, pool_va, pool_bytes, A810_GPU_BUFFERS, sizes, iovas, perms,
+	           bank, asid, slot, sid, progress, report);
+}
+
+int
+a810_gpu_context_buffers(struct a810_gmu_payload out[A810_GPU_BUFFERS], uint64_t *pool_used)
+{
+	if (!out || !gpu_ctx.ready) {
+		return 1;
+	}
+	for (unsigned i = 0; i < A810_GPU_BUFFERS; ++i) {
+		out[i] = gpu_ctx.payload[i];
+	}
+	if (pool_used) {
+		*pool_used = gpu_ctx.pool_used;
+	}
+	return 0;
+}
+
+/* Map or unmap one physically contiguous run in the GPU context, then TLBIASID + TLBSYNC on its bank (a map changes only
+ * invalid leaves, but the sync costs one register round trip and keeps the rule simple). Callers serialise. */
+static int
+gpu_update(uint64_t iova, uint64_t pa, uint64_t bytes, unsigned prot, int map)
+{
+	if (!gpu_ctx.ready) {
+		return Busy;
+	}
+	unsigned perms = PERM_READ | ((prot & A810_GPU_PROT_WRITE) ? PERM_WRITE : 0u) |
+	    ((prot & A810_GPU_PROT_EXEC) ? PERM_EXECUTE : 0u);
+	const struct tbl_range range = {iova, pa, bytes, perms, 0, 2};
+	int status = ctx_write_leaves(&gpu_ctx, &range, 1, map);
+	if (status) {
+		return status;
+	}
+	struct program_result r = {0};
+	return sync_tlb(&gpu_ctx.io, (size_t)gpu_ctx.context_offset, gpu_ctx.asid, 0, 4000, &r);
+}
+
+int
+a810_gpu_map(uint64_t iova, uint64_t pa, uint64_t bytes, unsigned prot)
+{
+	return gpu_update(iova, pa, bytes, prot, 1);
+}
+
+int
+a810_gpu_unmap(uint64_t iova, uint64_t bytes)
+{
+	return gpu_update(iova, 0, bytes, 0, 0);
+}
+
+/* The GPU bank's fault registers for the logs: FSR, FAR (lo, hi), FSYNR0, ACTLR. */
+void
+a810_gpu_context_faults(uint32_t out[5])
+{
+	for (unsigned i = 0; i < 5; ++i) {
+		out[i] = 0;
+	}
+	if (!gpu_ctx.used || !gpu_ctx.context_offset) {
+		return;
+	}
+	static const unsigned regs[5] = {0x58, 0x60, 0x64, 0x68, 0x4};
+	for (unsigned i = 0; i < 5; ++i) {
+		io_read32(&gpu_ctx.io, (size_t)gpu_ctx.context_offset + regs[i], &out[i]);
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
