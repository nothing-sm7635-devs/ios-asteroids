+/* ---- Stage 12: survey, the GPU's SMMU context, the SQE copy (gpuSurvey) ---- */
+static void
+a810_gpuctx_progress(uint32_t step)
+{
+	static const char *const names[] = {"-", "allocate", "prepare", "program", "attach", "observe", "map", "ready"};
+	A810_LOG("SWEET A810: gpuctx step %u %s\n", step, step < 8 ? names[step] : "?");
+}
+
+static int
+a810_stage12(const struct gpb_result *r)
+{
+	const struct gpb_gx_io gio = {NULL, a810_gx_read, a810_gx_write, a810_gx_vote, a810_delay_us};
+	struct gpb_survey *v = &a810_survey;
+	A810_LOG("SWEET A810: next: survey: CX_MISC SW fuse, then CP and RBBM registers\n");
+	gpb_gpu_survey(&gio, v);
+	A810_LOG("SWEET A810: stage 12 survey done %d fuse %#x freq %#x rbbm %#x int %#x fuse_int %#x halt %#x/%#x tsb %#x "
+	    "sqe cntl %#x base %#x%08x rb %#x rptr %#x wptr %#x aperture %#x cp_int %#x\n", v->done, v->fuse, v->freq_limit,
+	    v->gpu[0], v->gpu[1], v->gpu[2], v->gpu[3], v->gpu[4], v->gpu[5], v->gpu[6], v->gpu[8], v->gpu[7], v->gpu[9],
+	    v->gpu[10], v->gpu[11], v->gpu[12], v->gpu[13]);
+	if (!v->done) {
+		a810_fail(12, "survey read failed");
+		return 0;
+	}
+	if (!a810_smmu_va) {
+		a810_fail(12, "no SMMU map");
+		return 0;
+	}
+	/* ACTLR before the bank is programmed and enabled, as arm-smmu-qcom and pandora's level 9 set it. */
+	a810_cb0 = gpb_smmu_cb_offset(r->id1, 0);
+	uint32_t actlr = a810_smmu_read(a810_cb0 + GPB_SMMU_CB_ACTLR);
+	*(volatile uint32_t *)(a810_smmu_va + a810_cb0 + GPB_SMMU_CB_ACTLR) = GPB_GPU_ACTLR;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	A810_LOG("SWEET A810: gpuctx actlr %#x -> %#x\n", actlr, a810_smmu_read(a810_cb0 + GPB_SMMU_CB_ACTLR));
+
+	/* The GPU pool: outside XNU's window, reserved by the firmware; 64 MiB of it mapped write-combined and checked. */
+	A810_LOG("SWEET A810: next: GPU pool %#llx, mapping and checking %llu MiB\n", GPB_GPU_POOL_BASE, A810_GPU_POOL_MAPPED >> 20);
+	a810_gpool_va = ml_io_map_wcomb(GPB_GPU_POOL_BASE, A810_GPU_POOL_MAPPED);
+	if (!a810_gpool_va) {
+		a810_fail(12, "GPU pool map failed");
+		return 0;
+	}
+	struct gpb_pool_result pool = {0};
+	gpb_pool_test((volatile uint64_t *)a810_gpool_va, A810_GPU_POOL_MAPPED, &pool);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	A810_LOG("SWEET A810: GPU pool %llu words, pattern bad %llu, zero bad %llu, first bad %#llx\n", pool.words,
+	    pool.pattern_bad, pool.zero_bad, pool.first_bad);
+	if (pool.words != A810_GPU_POOL_MAPPED / 8 || pool.pattern_bad || pool.zero_bad) {
+		a810_fail(12, "GPU pool round trip failed");
+		return 0;
+	}
+
+	/* bank 0 (arm-smmu-qcom gives the GPU bank 0), ASID 2, the DT's SID 0 alone on SMR slot 0 (the hypervisor aborts an
+	 * SMR write for SID 1 and the secure SID 2). Stage 5's GMU context keeps bank 1 and slot 2. */
+	A810_LOG("SWEET A810: next: GPU SMMU context bank 0 asid 2, sid 0 on slot 0\n");
+	struct a810_gmu_context_report q;
+	int status = a810_gpu_context_bringup((volatile uint8_t *)a810_smmu_va, GPB_SMMU_WINDOW, GPB_GPU_POOL_BASE,
+	    (volatile uint8_t *)a810_gpool_va, A810_GPU_POOL_MAPPED, 0, 2, 0, 0, a810_gpuctx_progress, &q);
+	A810_LOG("SWEET A810: stage 12 gpuctx %s step %u: oas %u program %s p%u w%u route %s p%u w%u v%u map %s leaves %u "
+	    "mismatch %#x ttbr0 %#llx sctlr %#x cbar %#x smr %#x s2cr %#x gfsr %#x fsr %#x\n", a810_smmu_status_text(q.status),
+	    q.step, q.output_bits, a810_smmu_status_text(q.program_status), q.program_phase, q.program_writes,
+	    a810_smmu_status_text(q.route_status), q.route_phase, q.route_writes, q.routes_verified,
+	    a810_smmu_status_text(q.map_status), q.leaves, q.mismatch, q.ttbr0, q.sctlr, q.cbar, q.smr, q.s2cr, q.gfsr, q.fsr);
+	if (status || a810_gpu_context_buffers(a810_gbuf, &a810_gpool_used)) {
+		a810_fail(12, "GPU SMMU context not ready");
+		return 0;
+	}
+	a810_gpool_used = (a810_gpool_used + 0xfffULL) & ~0xfffULL;
+	A810_LOG("SWEET A810: gpuctx sqe %#llx+%#llx@%#llx ring %#llx@%#llx memptrs %#llx@%#llx (pool used %#llx)\n",
+	    a810_gbuf[0].physical, a810_gbuf[0].bytes, a810_gbuf[0].iova, a810_gbuf[1].physical, a810_gbuf[1].iova,
+	    a810_gbuf[2].physical, a810_gbuf[2].iova, a810_gpool_used);
+
+	/* The SQE microcode without its first dword, as adreno_fw_create_bo copies it. */
+	size_t sqe_bytes = 0;
+	const uint8_t *sqe = a810_adt_blob("sqe-firmware", &sqe_bytes);
+	if (!sqe || sqe_bytes < 8 || (sqe_bytes & 3) || sqe_bytes - 4 > a810_gbuf[A810_GPU_SQE].bytes) {
+		A810_LOG("SWEET A810: sqe-firmware %zu bytes\n", sqe_bytes);
+		a810_fail(12, "no usable sqe-firmware in the ADT (/sweet-gpu)");
+		return 0;
+	}
+	volatile uint32_t *dst = a810_gbuf[A810_GPU_SQE].cpu;
+	for (size_t i = 4; i < sqe_bytes; i += 4) {
+		dst[(i - 4) / 4] = gpb_le32(sqe + i);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	size_t bad = 0;
+	for (size_t i = 4; i < sqe_bytes; i += 4) {
+		bad += dst[(i - 4) / 4] != gpb_le32(sqe + i);
+	}
+	uint8_t digest[32];
+	a810_sha256(sqe, sqe_bytes, digest);
+	A810_LOG("SWEET A810: stage 12 sqe copied %zu bytes (sha256 %02x%02x%02x%02x...), %zu words differ, words %#x %#x %#x\n",
+	    sqe_bytes - 4, digest[0], digest[1], digest[2], digest[3], bad, dst[0], dst[1], dst[2]);
+	if (bad) {
+		a810_fail(12, "SQE copy did not read back");
+		return 0;
+	}
+	return 1;
+}
+
+/* ---- Stage 13: a8xx hw_init's register writes (gpuHwInit) ---- */
+static int
+a810_stage13(void)
+{
+	A810_LOG("SWEET A810: next: hw_init: a8xx register writes up to the SQE base\n");
+	a810_gpu_writes = 1;
+	const struct gpb_gx_io gio = {NULL, a810_gx_read, a810_gx_write, a810_gx_vote, a810_delay_us};
+	struct gpb_hw *h = &a810_hw;
+	gpb_hw_init(&gio, h);
+	A810_LOG("SWEET A810: stage 13 hw_init %s step %u writes %u aperture %u protect %u nonctxt %u mismatches %u halt %#x/%#x "
+	    "rbbm %#x int %#x cp_int %#x xoclk0 %#x\n", h->failed ? "io" : "ok", h->step, h->writes, h->aperture_writes,
+	    h->protect_writes, h->nonctxt_writes, h->mismatches, h->gbif_halt, h->rbbm_gbif_halt, h->rbbm, h->int_status,
+	    h->cp_global, h->xoclk0);
+	A810_LOG("SWEET A810: hw_init check %#x %#x %#x %#x %#x %#x %#x %#x\n", h->check[0], h->check[1], h->check[2], h->check[3],
+	    h->check[4], h->check[5], h->check[6], h->check[7]);
+	if (h->failed || h->step != 9) {
+		a810_fail(13, "hw_init did not finish");
+		return 0;
+	}
+	return 1;
+}
+
+/* ---- Stage 14: SQE base, ring, SQE_CNTL, CP_ME_INIT, a first CP_MEM_WRITE, the power-up list (cpStart) ---- */
+static int
+a810_mem_write(uint64_t at, const uint32_t *prefix, unsigned prefix_words, uint32_t value, uint32_t *fence, uint32_t *seen,
+    int *st, int *wait)
+{
+	uint32_t words[8] = {0};
+	unsigned n = 0;
+	for (unsigned i = 0; i < prefix_words; ++i) {
+		words[n++] = prefix[i];
+	}
+	if (a810_pm4_type7(GPB_CP_MEM_WRITE, 3, &words[n])) {
+		return 0;
+	}
+	words[n + 1] = (uint32_t)at;
+	words[n + 2] = (uint32_t)(at >> 32);
+	words[n + 3] = value;
+	n += 4;
+	*wait = -1;
+	*st = a810_ring_submit(&a810_ring, words, n, fence);
+	if (!*st) {
+		*wait = a810_ring_wait(&a810_ring, *fence, a810_now, a810_idle, A810_FENCE_TIMEOUT_US, seen);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 1;
+}
+
+static int
+a810_stage14(void)
+{
+	const uint64_t sqe = a810_gbuf[A810_GPU_SQE].iova, bv_rptr = a810_gbuf[A810_GPU_MEMPTRS].iova + 8;   /* rbmemptr(bv_rptr) */
+	A810_LOG("SWEET A810: next: cp: SQE base %#llx, ring %#llx, then SQE_CNTL and CP_ME_INIT\n", sqe,
+	    a810_gbuf[A810_GPU_RING].iova);
+	if (a810_reg_write(NULL, A810_CP_SQE_INSTR_BASE, (uint32_t)sqe) ||
+	    a810_reg_write(NULL, A810_CP_SQE_INSTR_BASE + 1, (uint32_t)(sqe >> 32))) {
+		a810_fail(14, "SQE base write");
+		return 0;
+	}
+	int st = a810_ring_attach(&a810_ring, &a810_cp_io, a810_gbuf[A810_GPU_RING].cpu, (size_t)a810_gbuf[A810_GPU_RING].bytes,
+	    a810_gbuf[A810_GPU_RING].iova, a810_gbuf[A810_GPU_MEMPTRS].cpu, (size_t)a810_gbuf[A810_GPU_MEMPTRS].bytes,
+	    a810_gbuf[A810_GPU_MEMPTRS].iova);
+	uint32_t cntl = 0;
+	a810_reg_read(NULL, A810_CP_RB_CNTL, &cntl);
+	A810_LOG("SWEET A810: cp ring attach %d rb_cntl %#x\n", st, cntl);
+	if (st || a810_reg_write(NULL, A810_CP_RB_RPTR_ADDR_BV, (uint32_t)bv_rptr) ||
+	    a810_reg_write(NULL, A810_CP_RB_RPTR_ADDR_BV + 1, (uint32_t)(bv_rptr >> 32))) {
+		a810_fail(14, "ring attach");
+		return 0;
+	}
+	a810_cp_state("before");
+	a810_cp_started = 1;                   /* from the SQE_CNTL write on, a failure stops the CP */
+	if (a810_reg_write(NULL, A810_CP_SQE_CNTL, A810_INIT_CP_SQE_CNTL)) {
+		a810_fail(14, "SQE_CNTL write");
+		return 0;
+	}
+	uint32_t fence = 0, seen = 0;
+	int init = a810_cp_init(&a810_ring, sqe, a810_gbuf[A810_GPU_PWRUP].iova, &fence), wait = -1;
+	if (!init) {
+		wait = a810_ring_wait(&a810_ring, fence, a810_now, a810_idle, A810_FENCE_TIMEOUT_US, &seen);
+	}
+	A810_LOG("SWEET A810: stage 14 cp init st %d fence %u %s seen %u\n", init, fence,
+	    wait < 0 ? "-" : a810_fence_text[wait & 3], seen);
+	a810_cp_state("init");
+	if (init || wait) {
+		a810_fail(14, "CP_ME_INIT fence");
+		return 0;
+	}
+	volatile uint32_t *scratch = a810_gbuf[A810_GPU_SCRATCH].cpu;
+	scratch[0] = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	int wst = 0;
+	if (!a810_mem_write(a810_gbuf[A810_GPU_SCRATCH].iova, NULL, 0, 0x5e9a810, &fence, &seen, &wst, &wait)) {
+		a810_fail(14, "pm4 refused");
+		return 0;
+	}
+	const uint32_t word = scratch[0];
+	const int ok = !wst && !wait && word == 0x5e9a810;
+	A810_LOG("SWEET A810: stage 14 cp write st %d fence %u %s seen %u scratch %#x %s\n", wst, fence,
+	    wait < 0 ? "-" : a810_fence_text[wait & 3], seen, word, ok ? "ok" : "miss");
+	a810_cp_state("write");
+	if (!ok) {
+		a810_fail(14, "first CP_MEM_WRITE");
+		return 0;
+	}
+	size_t written = 0;
+	st = a810_pwrup_build(&a810_cp_io, a810_gbuf[A810_GPU_PWRUP].cpu, (size_t)a810_gbuf[A810_GPU_PWRUP].bytes, &written);
+	A810_LOG("SWEET A810: cp pwrup st %d bytes %zu\n", st, written);
+	if (st) {
+		a810_fail(14, "power-up list");
+		return 0;
+	}
+	return 1;
+}
+
+/* ---- Stage 15: the zap shader through SCM PAS 13, then CP_SET_SECURE_MODE 0 (zapStart) ---- */
+struct a810_scm_reply {
+	uint64_t status, value;
+	unsigned again;
+};
+static void
+a810_smc(uint64_t r[8])
+{
+	register uint64_t x0 __asm__("x0") = r[0];
+	register uint64_t x1 __asm__("x1") = r[1];
+	register uint64_t x2 __asm__("x2") = r[2];
+	register uint64_t x3 __asm__("x3") = r[3];
+	register uint64_t x4 __asm__("x4") = r[4];
+	register uint64_t x5 __asm__("x5") = r[5];
+	register uint64_t x6 __asm__("x6") = r[6];
+	register uint64_t x7 __asm__("x7") = r[7];
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7) : :
+	    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	r[0] = x0; r[1] = x1; r[2] = x2; r[3] = x3; r[4] = x4; r[5] = x5; r[6] = x6; r[7] = x7;
+}
+/* GpuPowerProbe scmCall: SMC64 SiP yielding call; x0 = 1 (interrupted) is resumed with x0 = 1, the original x1..x5 and
+ * the returned x6, at most 1000 times. Status in x0, the first result in x1. */
+static struct a810_scm_reply
+a810_scm(const char *what, uint32_t svc, uint32_t cmd, uint32_t arginfo, uint64_t a0, uint64_t a1, uint64_t a2)
+{
+	A810_LOG("SWEET A810: zap scm %s (%#x %#x %#llx %#llx %#llx)\n", what, gpb_scm_fn(svc, cmd), arginfo, a0, a1, a2);
+	uint64_t r[8] = {gpb_scm_fn(svc, cmd), arginfo, a0, a1, a2, 0, 0, 0};
+	struct a810_scm_reply out = {0, 0, 0};
+	for (;;) {
+		uint64_t x[8] = {r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7]};
+		a810_smc(x);
+		if (x[0] != GPB_SCM_INTERRUPTED || out.again >= 1000) {
+			out.status = x[0];
+			out.value = x[1];
+			break;
+		}
+		++out.again;
+		r[0] = GPB_SCM_INTERRUPTED;
+		r[6] = x[6];
+	}
+	A810_LOG("SWEET A810: zap scm %s -> status %#llx value %#llx again %u\n", what, out.status, out.value, out.again);
+	return out;
+}
+
+/* One 4 KiB page below 4 GiB for the PAS metadata, physically contiguous and cleaned to memory: kmem_alloc_contig with a
+ * max page number (a 16 KiB kernel page, cacheable, cleaned by VA), else the GMU pool's spare space (below 4 GiB,
+ * write-combined, so ordering only). Never freed: the monitor may read it until auth_and_reset. */
+static int
+a810_zap_metadata(const uint8_t *img, const struct gpb_mdt *m, uint64_t *pa)
+{
+	vm_offset_t kva = 0;
+	kern_return_t kr = kmem_alloc_contig(kernel_map, &kva, PAGE_SIZE, PAGE_MASK, (ppnum_t)(atop_64(0x100000000ULL) - 1), 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT | KMA_NOPAGEWAIT, VM_KERN_MEMORY_IOKIT);
+	ppnum_t pn = kr == KERN_SUCCESS ? pmap_find_phys(kernel_pmap, (addr64_t)kva) : 0;
+	if (pn && ptoa_64(pn) + PAGE_SIZE <= 0x100000000ULL) {
+		gpb_mdt_metadata(img, m, (uint8_t *)kva);
+		sweet_dma_sync_va((const void *)kva, PAGE_SIZE);
+		*pa = ptoa_64(pn);
+		A810_LOG("SWEET A810: zap metadata page from kmem_alloc_contig at %#llx\n", *pa);
+		return 0;
+	}
+	uint64_t off = (a810_gmu_context_pool_used() + 0xfffULL) & ~0xfffULL;
+	if (!a810_pool_va || !off || off + 0x1000 > GPB_GMU_POOL_BYTES) {
+		return 1;
+	}
+	volatile uint32_t *page = (volatile uint32_t *)(a810_pool_va + off);
+	static uint32_t tmp[0x1000 / 4];
+	for (unsigned i = 0; i < 0x1000 / 4; ++i) {
+		tmp[i] = 0;
+	}
+	gpb_mdt_metadata(img, m, (uint8_t *)tmp);
+	for (unsigned i = 0; i < 0x1000 / 4; ++i) {
+		page[i] = tmp[i];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*pa = GPB_GMU_POOL_BASE + off;
+	A810_LOG("SWEET A810: zap metadata page from the GMU pool's spare space at %#llx (kmem_alloc_contig %d, pn %#x)\n", *pa,
+	    kr, pn);
+	return 0;
+}
+
+static int
+a810_stage15(void)
+{
+	uint32_t trust = 0;
+	a810_reg_read(NULL, A810_RBBM_SECVID_TRUST_CNTL, &trust);
+	A810_LOG("SWEET A810: next: zap: PAS %u into %#llx+%#x, then CP_SET_SECURE_MODE 0; trust_cntl %#x\n", GPB_ZAP_PAS,
+	    GPB_ZAP_REGION, GPB_ZAP_REGION_BYTES, trust);
+	size_t zap_bytes = 0;
+	const uint8_t *zap = a810_adt_blob("zap-mbn", &zap_bytes);
+	if (!zap) {
+		a810_fail(15, "no zap-mbn in the ADT (/sweet-gpu)");
+		return 0;
+	}
+	struct gpb_mdt m;
+	unsigned rule = gpb_mdt_parse(zap, (uint32_t)zap_bytes, GPB_ZAP_REGION_BYTES, &m);
+	A810_LOG("SWEET A810: zap mbn %zu bytes rule %u header %#x hash %#x+%#x meta %#x loads %u reloc %u span %#x-%#x\n",
+	    zap_bytes, rule, m.header_bytes, m.hash_offset, m.hash_bytes, m.meta_bytes, m.loads, m.relocatable, m.min_addr,
+	    m.max_addr);
+	if (rule || m.meta_bytes > 0x1000) {
+		a810_fail(15, "zap-mbn not usable");
+		return 0;
+	}
+	struct a810_scm_reply q = a810_scm("is_call_avail", GPB_SCM_SVC_INFO, GPB_SCM_INFO_IS_CALL_AVAIL, GPB_SCM_ARGS_1,
+	    gpb_scm_query(GPB_SCM_SVC_PIL, GPB_SCM_PAS_IS_SUPPORTED), 0, 0);
+	if (q.status || !q.value) {
+		a810_fail(15, "PAS_IS_SUPPORTED not available");
+		return 0;
+	}
+	q = a810_scm("is_supported", GPB_SCM_SVC_PIL, GPB_SCM_PAS_IS_SUPPORTED, GPB_SCM_ARGS_1, GPB_ZAP_PAS, 0, 0);
+	if (q.status || !q.value) {
+		a810_fail(15, "PAS 13 not supported");
+		return 0;
+	}
+	uint64_t meta_pa = 0;
+	if (a810_zap_metadata(zap, &m, &meta_pa)) {
+		a810_fail(15, "no metadata page below 4 GiB");
+		return 0;
+	}
+	q = a810_scm("init_image", GPB_SCM_SVC_PIL, GPB_SCM_PAS_INIT_IMAGE, GPB_SCM_ARGS_INIT_IMAGE, GPB_ZAP_PAS, meta_pa, 0);
+	if (q.status || q.value) {
+		a810_fail(15, "init_image");
+		return 0;
+	}
+	q = a810_scm("mem_setup", GPB_SCM_SVC_PIL, GPB_SCM_PAS_MEM_SETUP, GPB_SCM_ARGS_3, GPB_ZAP_PAS, GPB_ZAP_REGION,
+	    m.max_addr - m.min_addr);
+	if (q.status || q.value) {
+		a810_fail(15, "mem_setup");
+		return 0;
+	}
+	A810_LOG("SWEET A810: zap writing %#x bytes into the region\n", m.max_addr - m.min_addr);
+	vm_offset_t region = ml_io_map_wcomb(GPB_ZAP_REGION, GPB_ZAP_REGION_BYTES);
+	if (!region) {
+		a810_fail(15, "zap region map failed");
+		return 0;
+	}
+	gpb_mdt_place(zap, &m, (volatile uint8_t *)region);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	q = a810_scm("auth_and_reset", GPB_SCM_SVC_PIL, GPB_SCM_PAS_AUTH_AND_RESET, GPB_SCM_ARGS_1, GPB_ZAP_PAS, 0, 0);
+	if (q.status || q.value) {
+		a810_fail(15, "auth_and_reset");
+		return 0;
+	}
+	volatile uint32_t *scratch = a810_gbuf[A810_GPU_SCRATCH].cpu;
+	scratch[1] = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t secure[2] = {0, 0}, fence = 0, seen = 0;
+	int st = 0, wait = -1;
+	if (a810_pm4_type7(GPB_CP_SET_SECURE_MODE, 1, &secure[0]) ||
+	    !a810_mem_write(a810_gbuf[A810_GPU_SCRATCH].iova + 4, secure, 2, 0x05ec0ff1, &fence, &seen, &st, &wait)) {
+		a810_fail(15, "pm4 refused");
+		return 0;
+	}
+	const uint32_t word = scratch[1];
+	uint32_t after = 0;
+	a810_reg_read(NULL, A810_RBBM_SECVID_TRUST_CNTL, &after);
+	const int ok = !st && !wait && word == 0x05ec0ff1;
+	A810_LOG("SWEET A810: stage 15 zap secure off st %d fence %u %s seen %u scratch %#x trust_cntl %#x -> %#x %s\n", st, fence,
+	    wait < 0 ? "-" : a810_fence_text[wait & 3], seen, word, trust, after, ok ? "ok" : "miss");
+	a810_cp_state("zap");
+	if (!ok) {
+		a810_fail(15, "CP_SET_SECURE_MODE 0 / CP_MEM_WRITE");
+		return 0;
+	}
+	return 1;
+}
+
+/* ---- Stage 16: a one-packet IB, then a band the GPU writes into the framebuffer (barStart) ---- */
+#define A810_FB_PA              0xE3940000ULL   /* the 3a's UEFI framebuffer: 1080 x 2392, 4320 bytes a row, x8r8g8b8 */
+#define A810_FB_WIDTH           1080u
+#define A810_FB_HEIGHT          2392u
+#define A810_FB_STRIDE          4320u
+#define A810_BAR_Y0             160u            /* near the top, below the status area */
+#define A810_BAR_ROWS           160u
+
+static int
+a810_ib(uint64_t iova, uint32_t dwords, uint32_t *fence, uint32_t *seen, int *st, int *wait)
+{
+	uint32_t words[4];
+	if (a810_pm4_type7(GPB_CP_INDIRECT_BUFFER, 3, &words[0])) {
+		return 0;
+	}
+	words[1] = (uint32_t)iova;
+	words[2] = (uint32_t)(iova >> 32);
+	words[3] = dwords;
+	*wait = -1;
+	*st = a810_ring_submit(&a810_ring, words, 4, fence);
+	if (!*st) {
+		*wait = a810_ring_wait(&a810_ring, *fence, a810_now, a810_idle, A810_FENCE_TIMEOUT_US, seen);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 1;
+}
+
+static int
+a810_stage16(void)
+{
+	uint32_t fence = 0, seen = 0;
+	int st = 0, wait = -1;
+	uint64_t pa = 0;
+	A810_LOG("SWEET A810: next: ib: CP_INDIRECT_BUFFER at %#llx with one CP_MEM_WRITE into scratch+8\n", GPB_IB_IOVA);
+	volatile uint32_t *ib = a810_gpool_take(0x1000, &pa);
+	const uint64_t at = a810_gbuf[A810_GPU_SCRATCH].iova + 8;
+	uint32_t header = 0;
+	if (!ib || a810_pm4_type7(GPB_CP_MEM_WRITE, 3, &header)) {
+		a810_fail(16, "IB page");
+		return 0;
+	}
+	ib[0] = header;
+	ib[1] = (uint32_t)at;
+	ib[2] = (uint32_t)(at >> 32);
+	ib[3] = 0x1b810014;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	int mst = a810_gpu_map(GPB_IB_IOVA, pa, 0x1000, A810_GPU_PROT_READ);
+	if (mst) {
+		A810_LOG("SWEET A810: ib map %s\n", a810_smmu_status_text((uint32_t)mst));
+		a810_fail(16, "IB map");
+		return 0;
+	}
+	volatile uint32_t *scratch = a810_gbuf[A810_GPU_SCRATCH].cpu;
+	scratch[2] = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a810_ib(GPB_IB_IOVA, 4, &fence, &seen, &st, &wait);
+	uint32_t word = scratch[2];
+	int ok = !st && !wait && word == 0x1b810014;
+	A810_LOG("SWEET A810: stage 16 ib st %d fence %u %s seen %u scratch %#x %s\n", st, fence,
+	    wait < 0 ? "-" : a810_fence_text[wait & 3], seen, word, ok ? "ok" : "miss");
+	a810_cp_state("ib");
+	if (!ok) {
+		a810_fail(16, "first IB");
+		return 0;
+	}
+
+	/* The framebuffer: the console's, when it is the 3a's 32-bit panel framebuffer; else the board's own facts. */
+	PE_Video video;
+	uint64_t fb = A810_FB_PA;
+	uint32_t width = A810_FB_WIDTH, height = A810_FB_HEIGHT, stride = A810_FB_STRIDE;
+	if (PE_current_console(&video) == 0) {
+		A810_LOG("SWEET A810: bar: console %#lx %lux%lu row %lu depth %lu\n", video.v_baseAddr, video.v_width,
+		    video.v_height, video.v_rowBytes, video.v_depth);
+		if (video.v_depth == 32 && video.v_baseAddr == A810_FB_PA && video.v_width >= 3 && video.v_width <= 16381 &&
+		    video.v_height >= 3 * A810_BAR_ROWS && video.v_rowBytes >= video.v_width * 4) {
+			width = (uint32_t)video.v_width;
+			height = (uint32_t)video.v_height;
+			stride = (uint32_t)video.v_rowBytes;
+		}
+	}
+	struct gpb_bar b;
+	b.y0 = A810_BAR_Y0;
+	b.rows = A810_BAR_ROWS;
+	b.width = width;
+	b.row_bytes = stride;
+	const uint64_t first = fb + (uint64_t)b.y0 * stride, end = first + (uint64_t)(b.rows - 1) * stride + width * 4u;
+	b.page = first & ~0xfffULL;
+	b.bytes = ((end + 0xfffULL) & ~0xfffULL) - b.page;
+	b.offset = first - b.page;
+	b.ib_dwords = b.rows * (3u + width);
+	b.ib_bytes = (b.ib_dwords * 4u + 0xfffu) & ~0xfffu;
+	A810_LOG("SWEET A810: bar: fb %#llx %ux%u row %u; rows %u-%u span %#llx+%#llx at %#llx, ib %u dwords\n", fb, width, height,
+	    stride, b.y0, b.y0 + b.rows - 1, b.page, b.bytes, b.offset, b.ib_dwords);
+	if (b.y0 + b.rows > height || b.bytes > GPB_FB_MAX || b.ib_bytes > GPB_BAR_IB_MAX) {
+		a810_fail(16, "bar plan");
+		return 0;
+	}
+	mst = a810_gpu_map(GPB_FB_IOVA, b.page, b.bytes, A810_GPU_PROT_READ | A810_GPU_PROT_WRITE);
+	if (mst) {
+		A810_LOG("SWEET A810: bar fb map %s\n", a810_smmu_status_text((uint32_t)mst));
+		a810_fail(16, "framebuffer map");
+		return 0;
+	}
+	volatile uint32_t *bar_ib = a810_gpool_take(b.ib_bytes, &pa);
+	if (!bar_ib || a810_pm4_type7(GPB_CP_MEM_WRITE, b.width + 2, &header)) {
+		a810_fail(16, "bar IB");
+		return 0;
+	}
+	/* gpb_bar_fill, written straight into the write-combined IB with 32-bit stores */
+	uint32_t k = 0;
+	for (uint32_t row = 0; row < b.rows; ++row) {
+		const uint64_t to = GPB_FB_IOVA + b.offset + (uint64_t)row * b.row_bytes;
+		bar_ib[k++] = header;
+		bar_ib[k++] = (uint32_t)to;
+		bar_ib[k++] = (uint32_t)(to >> 32);
+		for (uint32_t x = 0; x < b.width; ++x) {
+			bar_ib[k++] = gpb_bar_pixel(&b, x, row);
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	mst = a810_gpu_map(GPB_BAR_IB_IOVA, pa, b.ib_bytes, A810_GPU_PROT_READ);
+	if (mst) {
+		A810_LOG("SWEET A810: bar ib map %s\n", a810_smmu_status_text((uint32_t)mst));
+		a810_fail(16, "bar IB map");
+		return 0;
+	}
+	A810_LOG("SWEET A810: next: bar: drawing once from the IB at %#llx\n", GPB_BAR_IB_IOVA);
+	a810_ib(GPB_BAR_IB_IOVA, b.ib_dwords, &fence, &seen, &st, &wait);
+	uint32_t px[3] = {0, 0, 0};
+	vm_offset_t view = ml_io_map_wcomb(b.page, b.bytes);
+	if (view) {
+		const volatile uint32_t *mid = (const volatile uint32_t *)(view + b.offset + (size_t)(b.rows / 2) * b.row_bytes);
+		px[0] = mid[b.width / 6];
+		px[1] = mid[b.width / 2];
+		px[2] = mid[b.width * 5 / 6];
+	}
+	ok = !st && !wait;
+	const int same = px[0] == 0x00ff0000u && px[1] == 0x0000ff00u && px[2] == 0x000000ffu;
+	A810_LOG("SWEET A810: stage 16 bar st %d fence %u %s seen %u pixels %#x %#x %#x %s\n", st, fence,
+	    wait < 0 ? "-" : a810_fence_text[wait & 3], seen, px[0], px[1], px[2], ok && same ? "ok" : "miss");
+	a810_cp_state("bar");
+	if (!ok) {
+		a810_fail(16, "bar IB fence");
+		return 0;
+	}
+	a810_ring_request_reset(&a810_ring);   /* the first user submission carries the context entry */
+	a810_ready = 1;
+	A810_LOG("SWEET A810: the GPU is up (sweet_a810_ready); the band stays for 10 s unless the console scrolls over it\n");
+	delay_for_interval(10, NSEC_PER_SEC);
+	return 1;
+}
+
+/* ---- sweet_a810_api.h ---- */
+bool
+sweet_a810_ready(void)
+{
+	return a810_ready && !a810_ring.poisoned;
+}
+
+int
+sweet_a810_submit_ib(uint64_t iova, uint32_t dwords, uint32_t *seqno)
+{
+	uint32_t words[4];
+	if (!seqno) {
+		return EINVAL;
+	}
+	*seqno = 0;
+	if (!dwords || dwords > 0xfffff || (iova & 3) || iova < SWEET_A810_VA_START || iova >= SWEET_A810_VA_END ||
+	    (uint64_t)dwords * 4 > SWEET_A810_VA_END - iova || a810_pm4_type7(GPB_CP_INDIRECT_BUFFER, 3, &words[0])) {
+		return EINVAL;
+	}
+	words[1] = (uint32_t)iova;
+	words[2] = (uint32_t)(iova >> 32);
+	words[3] = dwords;
+	lck_mtx_lock(&a810_lck);
+	int st = sweet_a810_ready() ? a810_ring_submit_framed(&a810_ring, words, 4, seqno) : A810_RING_NOT_READY;
+	lck_mtx_unlock(&a810_lck);
+	switch (st) {
+	case A810_RING_OK: return 0;
+	case A810_RING_NO_SPACE: return ENOSPC;
+	case A810_RING_ARGUMENT: return EINVAL;
+	case A810_RING_IO: return EIO;
+	default: return ENXIO;
+	}
+}
+
+bool
+sweet_a810_fence_passed(uint32_t seqno)
+{
+	if (!a810_ready) {
+		return false;
+	}
+	return (int32_t)(a810_ring_observed(&a810_ring) - seqno) >= 0;
+}
+
+static int
+a810_vm_errno(int st, int map)
+{
+	/* ArmSmmu4KStatus: 0 ok, 2 bad range, 7 state mismatch, 8 I/O, 9 timeout, 10 busy */
+	switch (st) {
+	case 0: return 0;
+	case 1: case 2: case 3: return EINVAL;
+	case 7: return map ? EEXIST : ENOENT;
+	case 10: return ENXIO;
+	default: return EIO;
+	}
+}
+
+int
+sweet_a810_vm_map(uint64_t iova, uint64_t pa, uint64_t bytes, unsigned prot)
+{
+	if (!bytes || ((iova | pa | bytes) & 0xfff) || !(prot & SWEET_A810_PROT_READ) || (prot & ~7u) ||
+	    iova < SWEET_A810_VA_START || iova >= SWEET_A810_VA_END || bytes > SWEET_A810_VA_END - iova) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&a810_lck);
+	int st = sweet_a810_ready() ? a810_gpu_map(iova, pa, bytes, prot) : 10;
+	lck_mtx_unlock(&a810_lck);
+	return a810_vm_errno(st, 1);
+}
+
+int
+sweet_a810_vm_unmap(uint64_t iova, uint64_t bytes)
+{
+	if (!bytes || ((iova | bytes) & 0xfff) || iova < SWEET_A810_VA_START || iova >= SWEET_A810_VA_END ||
+	    bytes > SWEET_A810_VA_END - iova) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&a810_lck);
+	int st = sweet_a810_ready() ? a810_gpu_unmap(iova, bytes) : 10;
+	lck_mtx_unlock(&a810_lck);
+	return a810_vm_errno(st, 0);
+}
