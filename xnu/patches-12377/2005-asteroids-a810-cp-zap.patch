+/* GpuPowerProbe cpState: the CP's pointers and status, BR's fault and interrupt status through the aperture, the
+ * memptrs, the GPU bank's fault registers and the WPTR write statistics. */
+static void
+a810_cp_state(const char *when)
+{
+	uint32_t v[7] = {0}, fault = 0, status = 0, f[5];
+	const uint32_t regs[7] = {A810_CP_RB_RPTR, A810_CP_RB_WPTR, A810_RBBM_STATUS, A810_RBBM_INT_0_STATUS,
+		                  A810_CP_INTERRUPT_STATUS_GLOBAL, A810_CP_SQE_CNTL, A810_CP_APERTURE_CNTL_HOST};
+	for (unsigned i = 0; i < 7; ++i) {
+		a810_reg_read(NULL, regs[i], &v[i]);
+	}
+	if (a810_gpu_writes) {
+		a810_reg_write(NULL, A810_CP_APERTURE_CNTL_HOST, A810_PIPE_BR << A810_CP_APERTURE_CNTL_HOST_PIPEID_SHIFT);
+		a810_reg_read(NULL, A810_CP_HW_FAULT_STATUS_PIPE, &fault);
+		a810_reg_read(NULL, A810_CP_INTERRUPT_STATUS_PIPE, &status);
+		a810_reg_write(NULL, A810_CP_APERTURE_CNTL_HOST, 0);
+	}
+	const volatile uint32_t *m = a810_gbuf[A810_GPU_MEMPTRS].cpu;
+	a810_gpu_context_faults(f);
+	A810_LOG("SWEET A810: cp %s rptr %#x wptr %#x rbbm %#x int %#x cp_int %#x sqe %#x ap %#x br_fault %#x br_int %#x\n", when,
+	    v[0], v[1], v[2], v[3], v[4], v[5], v[6], fault, status);
+	A810_LOG("SWEET A810: cp %s memptrs %#x %#x %#x %#x smmu fsr %#x far %#x%08x fsynr0 %#x actlr %#x wptr writes %u "
+	    "retries %u dropped %u fence %#x\n", when, m ? m[0] : 0, m ? m[1] : 0, m ? m[2] : 0, m ? m[3] : 0, f[0], f[2], f[1],
+	    f[3], f[4], a810_wptr_writes, a810_wptr_retries, a810_wptr_dropped, a810_wptr_fence);
+}
+
+/* Any failure after the GMU started: the CP stopped first (CP_SQE_CNTL 0) if it was started, then the GMU in reset. */
+static void
+a810_fail(unsigned stage, const char *why)
+{
+	A810_LOG("SWEET A810: stage %u failed: %s\n", stage, why);
+	if (a810_cp_started) {
+		ShengGmuIo *io = &a810_cold.io;
+		uint32_t v = ~0u;
+		io->write32(io->cookie, ShengGmuGpu, (size_t)A810_CP_SQE_CNTL * 4, 0);
+		io->barrier(io->cookie);
+		io->read32(io->cookie, ShengGmuGpu, (size_t)A810_CP_SQE_CNTL * 4, &v);
+		A810_LOG("SWEET A810: CP stopped: CP_SQE_CNTL %#x\n", v);
+		a810_cp_started = 0;
+	}
+	a810_ready = 0;
+	a810_gmu_reset("stage failed");
+}
+
+/* A page-aligned run of the mapped GPU pool after what is in use; NULL when it does not fit. Never freed. */
+static volatile uint32_t *
+a810_gpool_take(uint64_t bytes, uint64_t *pa)
+{
+	bytes = (bytes + 0xfffULL) & ~0xfffULL;
+	if (a810_gpool_used + bytes > A810_GPU_POOL_MAPPED) {
+		return NULL;
+	}
+	volatile uint32_t *cpu = (volatile uint32_t *)(a810_gpool_va + a810_gpool_used);
+	*pa = GPB_GPU_POOL_BASE + a810_gpool_used;
+	a810_gpool_used += bytes;
+	for (uint64_t i = 0; i < bytes / 4; ++i) {
+		cpu[i] = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return cpu;
+}
