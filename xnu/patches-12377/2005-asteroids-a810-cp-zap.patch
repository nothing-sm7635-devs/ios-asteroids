+/* ---- Stages 12-16: register access for the CP (GpuPowerProbe ringWrite/ringRead/ringBarrier) ---- */
+static uint32_t a810_wptr_writes, a810_wptr_retries, a810_wptr_dropped, a810_wptr_fence;
+
+static int
+a810_reg_read(void *cookie, uint32_t reg, uint32_t *value)
+{
+	ShengGmuIo *io = &a810_cold.io;
+	(void)cookie;
+	return io->read32(io->cookie, ShengGmuGpu, (size_t)reg * 4, value);
+}
+/* CP_RB_WPTR goes out as Linux's fenced write: GMU_AHB_FENCE_STATUS bit 0 means the GMU's AHB fence dropped it, so it is
+ * written again, up to 200 times 10 us apart. Every other register is a plain write; all need stage 13's permission. */
+static int
+a810_reg_write(void *cookie, uint32_t reg, uint32_t value)
+{
+	ShengGmuIo *io = &a810_cold.io;
+	(void)cookie;
+	if (!a810_gpu_writes) {
+		return 1;
+	}
+	if (reg != A810_CP_RB_WPTR) {
+		return io->write32(io->cookie, ShengGmuGpu, (size_t)reg * 4, value) || io->barrier(io->cookie);
+	}
+	++a810_wptr_writes;
+	for (unsigned tries = 0; tries < 200; ++tries) {
+		if (io->write32(io->cookie, ShengGmuGpu, (size_t)reg * 4, value) || io->barrier(io->cookie) ||
+		    io->read32(io->cookie, ShengGmuCore, GPB_GMU_AHB_FENCE_STATUS, &a810_wptr_fence)) {
+			return 1;
+		}
+		if (!(a810_wptr_fence & 1)) {
+			return 0;
+		}
+		++a810_wptr_retries;
+		delay(10);
+	}
+	++a810_wptr_dropped;
+	return 1;
+}
+static int
+a810_reg_barrier(void *cookie)
+{
+	(void)cookie;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 0;
+}
+static const struct a810_cp_io a810_cp_io = {NULL, a810_reg_write, a810_reg_read, a810_reg_barrier};
+
+static uint64_t
+a810_now(void)
+{
+	uint64_t us = 0;
+	a810_svc_now_us(NULL, &us);
+	return us;
+}
+static void
+a810_idle(void)
+{
+	delay(20);
+}
