diff --git a/bsd/dev/sweet_a810_api.h b/bsd/dev/sweet_a810_api.h
new file mode 100644
index 0000000..8960071
--- /dev/null
+++ b/bsd/dev/sweet_a810_api.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Nothing Phone (3a) "asteroids": the Adreno 810 kernel interface left behind by sweeta810=16 (sweet_a810.c), for the
+ * next integration step (an IOKit/IOGPU front end). Nothing calls it yet.
+ *
+ * Every call refuses (false / nonzero) unless stages 1-16 all passed in this boot. The GPU context is the one stage 12
+ * built: bank 0, ASID 2, a 2 GiB lower (TTBR0) GPU address space with 4 KiB pages, Normal non-cacheable (the CPU must
+ * use a matching write-combined or uncached view of anything it shares with the GPU). GPU addresses below
+ * SWEET_A810_VA_START hold the kernel's own buffers (SQE, ring, memptrs, power-up list, scratch, the bring-up IBs and the
+ * framebuffer band), so maps and IBs must lie in [SWEET_A810_VA_START, SWEET_A810_VA_END).
+ * All calls are serialised by one mutex; none may be called from interrupt context. Modelled on NativeAdreno's
+ * NativeAdrenoVm::map/unmap and NativeAdrenoRing::submitFramed/observeFence (MIT, Copyright (c) 2026 NativeAdreno
+ * contributors), which UniXNU's user client uses.
+ */
+#ifndef SWEET_A810_API_H
+#define SWEET_A810_API_H
+#include <stdint.h>
+#include <stdbool.h>
+
+#define SWEET_A810_VA_START     0x20000000ULL   /* GPB_CLIENT_VA_START */
+#define SWEET_A810_VA_END       0x80000000ULL   /* the end of the 2 GiB aperture */
+#define SWEET_A810_PROT_READ    1u
+#define SWEET_A810_PROT_WRITE   2u
+#define SWEET_A810_PROT_EXEC    4u
+
+/* Errors: 0 success, else one of these (errno values). */
+/*   ENXIO   the GPU is not up (sweeta810 < 16 or a stage failed) or went down (ring poisoned)
+ *   EINVAL  unaligned or out-of-window address/size, zero size, size over the ring
+ *   EEXIST  a map over a page already mapped (nothing changed)
+ *   ENOENT  an unmap of a page not mapped (nothing changed)
+ *   ENOSPC  the ring has no room now (retry after a fence passes)
+ *   EIO     an SMMU or register access failed */
+
+/* Stages 1-16 passed: GX on, CP running out of secure mode, the GPU context ready. */
+bool sweet_a810_ready(void);
+/* One CP_INDIRECT_BUFFER of `dwords` (1..0xfffff) at `iova`, with the A7XX/A8XX BR/BV framing and a ring timestamp
+ * fence (the first call after the bring-up also carries the context-reset entry). *seqno receives the fence number. */
+int sweet_a810_submit_ib(uint64_t iova, uint32_t dwords, uint32_t *seqno);
+/* True once the CP wrote a timestamp >= seqno (wrap-safe for 2^31 submissions). Never blocks. */
+bool sweet_a810_fence_passed(uint32_t seqno);
+/* Map `bytes` (4 KiB multiple) of physically contiguous memory at `pa` to `iova` (both 4 KiB aligned) with
+ * SWEET_A810_PROT_* (READ required); unmap the same range. Each is one TLBIASID + TLBSYNC on success. The caller keeps the
+ * pages alive until the unmap returned and every submission that used them passed its fence. */
+int sweet_a810_vm_map(uint64_t iova, uint64_t pa, uint64_t bytes, unsigned prot);
+int sweet_a810_vm_unmap(uint64_t iova, uint64_t bytes);
+#endif
diff --git a/bsd/dev/sweet_a810_cp.c b/bsd/dev/sweet_a810_cp.c
new file mode 100644
index 0000000..ccd4402
--- /dev/null
+++ b/bsd/dev/sweet_a810_cp.c
@@ -0,0 +1,503 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Nothing Phone (3a) "asteroids": the Adreno 810 command processor ring, CP init, power-up list and PM4 headers.
+ * See sweet_a810_cp.h for what is ported from where (NativeAdreno NativeAdrenoRing/CpInit/Pwrup/Registers, MIT;
+ * rootstockos AdrenoPM4, MIT). The packet values and their sources are NativeAdrenoRing.cpp's, unchanged:
+ * registers/adreno/a6xx.xml and adreno_pm4.xml at the pinned Linux tree, a7xx_submit/a6xx_set_pagetable/a7xx_cp_init in
+ * a6xx_gpu.c (a8xx uses a7xx_submit; a8xx_cp_init sends the same two packets).
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include "sweet_a810_cp.h"
+#include "NativeAdrenoA810HwInit.h"
+
+/* ---- AdrenoPM4.c ---- */
+static uint32_t
+odd_bit(uint32_t field)
+{
+	uint32_t parity = 1;
+	while (field) {
+		parity ^= 1;
+		field &= field - 1;
+	}
+	return parity;
+}
+int
+a810_pm4_type4(uint32_t reg, uint32_t count, uint32_t *header)
+{
+	if (!header || reg > 0x3ffff || !count || count > 127 || count - 1 > 0x3ffff - reg) {
+		return 1;
+	}
+	*header = 0x40000000u | count | (odd_bit(count) << 7) | (reg << 8) | (odd_bit(reg) << 27);
+	return 0;
+}
+int
+a810_pm4_type7(uint32_t opcode, uint32_t count, uint32_t *header)
+{
+	if (!header || opcode > 127 || count > 0x3fff) {
+		return 1;
+	}
+	*header = 0x70000000u | count | (odd_bit(count) << 15) | (opcode << 16) | (odd_bit(opcode) << 23);
+	return 0;
+}
+
+/* ---- NativeAdrenoRing.cpp (gen8 table of NativeAdrenoRegisters.h) ---- */
+enum {
+	RingFenceOpcode = 0x46,        /* CP_EVENT_WRITE7 */
+	RingFenceEvent = 0x31,         /* CACHE_CLEAN */
+	RingFenceEnable = 1u << 27,
+	RingFenceIrq = 1u << 31,
+	RingBlockBytes = 32,
+	RingThreadControl = 0x17,
+	RingThreadBr = 1,
+	RingThreadBv = 2,
+	RingThreadBoth = 3,
+	RingSyncThreads = 1u << 31,
+	RingSetMarker = 0x65,
+	RingWaitTimestamp = 0x14,
+	RingCcuInvalidateDepth = 0x18,
+	RingCcuInvalidateColor = 0x19,
+	RingCacheFlush7 = 0x32,
+	RingCacheInvalidate7 = 0x33,
+	RingWaitForIdle = 0x26,
+	RingPrologueWords = 11,
+	RingResetContextState = 0x1f,
+	RingResetAll = 0xf,
+	RingLrzFlushInvalidate = 0x26,
+	RingCacheInvalidate = 0x31,
+	RingWaitRegMem = 0x3c,
+	RingWaitWriteEq = 3,
+	RingResetWords = 26 + 2,       /* gen7's 26 plus RBBM_SLICE_PERFCTR_SRAM_INIT_CMD on gen8 */
+	RingFenceWords = 7,
+	RingFramedFenceWords = 31,
+	RingBvFenceOffset = 12,
+};
+#define RING_SCRATCH            A810_CP_SCRATCH_GLOBAL(2)
+
+static uint32_t
+ilog2_size(size_t value)
+{
+	uint32_t result = 0;
+	while (value > 1) {
+		value >>= 1;
+		++result;
+	}
+	return result;
+}
+static int
+ring_poison(struct a810_ring *r)
+{
+	r->poisoned = 1;
+	return A810_RING_IO;
+}
+static int
+ring_write_wptr(struct a810_ring *r, uint32_t value)
+{
+	++r->wptr_writes;      /* the board's write32 repeats a write the GMU AHB fence dropped (GpuPowerProbe ringWrite) */
+	return r->io.write32(r->io.cookie, A810_CP_RB_WPTR, value) ? ring_poison(r) : A810_RING_OK;
+}
+static int
+ring_read_rptr(struct a810_ring *r, uint32_t *value)
+{
+	uint32_t rptr = 0;
+	if (r->io.read32(r->io.cookie, A810_CP_RB_RPTR, &rptr) || rptr >= r->ring_bytes / 4) {
+		return ring_poison(r);
+	}
+	*value = rptr;
+	r->rptr_shadow = rptr;
+	return A810_RING_OK;
+}
+/* One TYPE7 packet into words; the next free index, or 0 when the header cannot be built. */
+static size_t
+packet(uint32_t *words, size_t at, uint32_t opcode, const uint32_t *payload, uint32_t count)
+{
+	if (a810_pm4_type7(opcode, count, &words[at])) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < count; ++i) {
+		words[at + 1 + i] = payload[i];
+	}
+	return at + 1 + count;
+}
+static int
+emit_prologue(struct a810_ring *r, uint32_t at, int reset, uint32_t *end)
+{
+	const uint32_t mask = (uint32_t)(r->ring_bytes / 4 - 1);
+	uint32_t words[RingPrologueWords + RingResetWords] = {0};
+	const uint32_t br = RingSyncThreads | RingThreadBr, sync_both = RingSyncThreads | RingThreadBoth, both = RingThreadBoth;
+	const uint32_t marker = 0x101;
+	const uint32_t count = RingPrologueWords + (reset ? (uint32_t)RingResetWords : 0u);
+	size_t n = packet(words, 0, RingThreadControl, &br, 1);
+	if (reset) {
+		const uint64_t at4 = r->fence_iova + 4;
+		const uint32_t wait[4] = {0, (uint32_t)at4, (uint32_t)(at4 >> 32), r->seqno}, all = RingResetAll;
+		const uint32_t lrz = RingLrzFlushInvalidate, invalidate = RingCacheInvalidate;
+		if (n) n = packet(words, n, RingWaitTimestamp, wait, 4);
+		if (n) n = packet(words, n, RingThreadControl, &sync_both, 1);
+		if (n) n = packet(words, n, RingResetContextState, &all, 1);
+		if (n) n = packet(words, n, RingThreadControl, &sync_both, 1);
+		if (n) n = packet(words, n, RingFenceOpcode, &lrz, 1);
+		if (n) n = packet(words, n, RingThreadControl, &br, 1);
+		if (n && !a810_pm4_type4(A810_RBBM_PERFCTR_SRAM_INIT_CMD, 1, &words[n])) {
+			words[n + 1] = 1;
+			n += 2;
+		} else {
+			n = 0;
+		}
+		if (n && !a810_pm4_type4(A810_RBBM_SLICE_PERFCTR_SRAM_INIT_CMD, 1, &words[n])) {
+			words[n + 1] = 1;
+			n += 2;
+		} else {
+			n = 0;
+		}
+		if (n) n = packet(words, n, RingFenceOpcode, &invalidate, 1);
+		const uint32_t sram[6] = {RingWaitWriteEq, A810_RBBM_PERFCTR_SRAM_INIT_STATUS, 0, 1, 1, 0};
+		if (n) n = packet(words, n, RingWaitRegMem, sram, 6);
+	}
+	const uint32_t flush = RingCacheFlush7, invalidate7 = RingCacheInvalidate7;
+	if (n) n = packet(words, n, RingFenceOpcode, &flush, 1);
+	if (n) n = packet(words, n, RingFenceOpcode, &invalidate7, 1);
+	if (n) n = packet(words, n, RingWaitForIdle, NULL, 0);
+	if (n) n = packet(words, n, RingThreadControl, &both, 1);
+	if (n) n = packet(words, n, RingSetMarker, &marker, 1);
+	if (n != count) {
+		return ring_poison(r);
+	}
+	for (uint32_t i = 0; i < count; ++i) {
+		r->ring[(at + i) & mask] = words[i];
+	}
+	*end = (at + count) & mask;
+	return A810_RING_OK;
+}
+static int
+emit_fence(struct a810_ring *r, uint32_t at, uint32_t seqno, uint32_t *end)
+{
+	const uint32_t mask = (uint32_t)(r->ring_bytes / 4 - 1);
+	uint32_t words[RingFenceWords] = {0};
+	if (a810_pm4_type4(RING_SCRATCH, 1, &words[0]) || a810_pm4_type7(RingFenceOpcode, 4, &words[2])) {
+		return ring_poison(r);
+	}
+	words[1] = seqno;
+	words[3] = RingFenceEvent | RingFenceEnable | RingFenceIrq;
+	const uint64_t at4 = r->fence_iova + 4;  /* msm_rbmemptrs.fence; +0 is the CP's RPTR shadow */
+	words[4] = (uint32_t)at4;
+	words[5] = (uint32_t)(at4 >> 32);
+	words[6] = seqno;
+	for (uint32_t i = 0; i < RingFenceWords; ++i) {
+		r->ring[(at + i) & mask] = words[i];
+	}
+	*end = (at + RingFenceWords) & mask;
+	return A810_RING_OK;
+}
+static int
+emit_framed_fence(struct a810_ring *r, uint32_t at, uint32_t seqno, uint32_t *end)
+{
+	const uint32_t mask = (uint32_t)(r->ring_bytes / 4 - 1);
+	uint32_t words[RingFramedFenceWords] = {0};
+	if (a810_pm4_type4(RING_SCRATCH, 1, &words[0])) {
+		return ring_poison(r);
+	}
+	words[1] = seqno;
+	const uint64_t at4 = r->fence_iova + 4, bv = r->fence_iova + RingBvFenceOffset;
+	const uint32_t br = RingThreadBr, bv_thread = RingThreadBv, both = RingThreadBoth, depth = RingCcuInvalidateDepth;
+	const uint32_t color = RingCcuInvalidateColor, marker = 0x100;
+	const uint32_t bv_write[4] = {RingFenceEvent | RingFenceEnable, (uint32_t)bv, (uint32_t)(bv >> 32), seqno};
+	const uint32_t bv_wait[4] = {0, (uint32_t)bv, (uint32_t)(bv >> 32), seqno};
+	const uint32_t fence[4] = {RingFenceEvent | RingFenceEnable | RingFenceIrq, (uint32_t)at4, (uint32_t)(at4 >> 32), seqno};
+	size_t n = packet(words, 2, RingThreadControl, &br, 1);
+	if (n) n = packet(words, n, RingFenceOpcode, &depth, 1);
+	if (n) n = packet(words, n, RingFenceOpcode, &color, 1);
+	if (n) n = packet(words, n, RingThreadControl, &bv_thread, 1);
+	if (n) n = packet(words, n, RingFenceOpcode, bv_write, 4);
+	if (n) n = packet(words, n, RingThreadControl, &br, 1);
+	if (n) n = packet(words, n, RingWaitTimestamp, bv_wait, 4);
+	if (n) n = packet(words, n, RingFenceOpcode, fence, 4);
+	if (n) n = packet(words, n, RingThreadControl, &both, 1);
+	if (n) n = packet(words, n, RingSetMarker, &marker, 1);
+	if (n != RingFramedFenceWords) {
+		return ring_poison(r);
+	}
+	for (uint32_t i = 0; i < RingFramedFenceWords; ++i) {
+		r->ring[(at + i) & mask] = words[i];
+	}
+	*end = (at + RingFramedFenceWords) & mask;
+	return A810_RING_OK;
+}
+int
+a810_ring_attach(struct a810_ring *r, const struct a810_cp_io *io, volatile void *ring, size_t ring_bytes, uint64_t ring_iova,
+    volatile void *fence, size_t fence_bytes, uint64_t fence_iova)
+{
+	if (!r || r->attached || r->poisoned) {
+		return A810_RING_BUSY;
+	}
+	if (!io || !io->write32 || !io->read32 || !io->barrier || !ring || !fence || ring_bytes < 8192 ||
+	    ring_bytes > (1u << 20) || (ring_bytes & (ring_bytes - 1)) || ((ring_iova | ring_bytes) & (ring_bytes - 1)) ||
+	    (ring_iova & 4095) || fence_bytes < 64 || (fence_iova & 7) || fence_bytes >= (1u << 24)) {
+		return A810_RING_ARGUMENT;
+	}
+	r->io = *io;
+	r->ring = (volatile uint32_t *)ring;
+	r->ring_bytes = ring_bytes;
+	r->ring_iova = ring_iova;
+	r->fence = (volatile uint32_t *)fence;
+	r->fence_bytes = fence_bytes;
+	r->fence_iova = fence_iova;
+	for (size_t i = 0; i < fence_bytes / 4; ++i) {
+		r->fence[i] = 0;
+	}
+	const uint32_t control = (ilog2_size(ring_bytes / 8) & 0x3f) | (ilog2_size(RingBlockBytes / 8) << 8);
+	const uint32_t writes[] = {A810_CP_RB_BASE, (uint32_t)ring_iova, A810_CP_RB_BASE + 1, (uint32_t)(ring_iova >> 32),
+		                   A810_CP_RB_CNTL, control, A810_CP_RB_RPTR_ADDR, (uint32_t)fence_iova, A810_CP_RB_RPTR_ADDR + 1,
+		                   (uint32_t)(fence_iova >> 32), A810_CP_RB_WPTR, 0, RING_SCRATCH, 0};
+	for (size_t i = 0; i < sizeof writes / sizeof writes[0]; i += 2) {
+		if (r->io.write32(r->io.cookie, writes[i], writes[i + 1])) {
+			return ring_poison(r);
+		}
+	}
+	uint32_t rptr = 0;
+	int status = ring_read_rptr(r, &rptr);
+	if (status) {
+		return status;
+	}
+	r->next = rptr;
+	r->seqno = r->completed = r->submissions = 0;
+	r->attached = 1;
+	return A810_RING_OK;
+}
+void
+a810_ring_request_reset(struct a810_ring *r)
+{
+	r->reset_pending = 1;
+}
+static int
+ring_submit_words(struct a810_ring *r, const uint32_t *words, size_t count, uint32_t *fence, int framed)
+{
+	if (!fence) {
+		return A810_RING_ARGUMENT;
+	}
+	*fence = 0;
+	if (!r->attached || r->poisoned) {
+		return A810_RING_NOT_READY;
+	}
+	if (!words || !count) {
+		return A810_RING_ARGUMENT;
+	}
+	const uint32_t size_words = (uint32_t)(r->ring_bytes / 4), mask = size_words - 1;
+	const int reset = framed && r->reset_pending;
+	const uint32_t extra = framed ? RingPrologueWords + (reset ? (uint32_t)RingResetWords : 0u) + RingFramedFenceWords :
+	    (uint32_t)RingFenceWords;
+	if (count > size_words - extra - 8) {
+		return A810_RING_NO_SPACE;
+	}
+	uint32_t rptr = 0;
+	int status = ring_read_rptr(r, &rptr);
+	if (status) {
+		return status;
+	}
+	const uint32_t used = (r->next - rptr) & mask;
+	if (count + extra + 8 > size_words - used) {
+		return A810_RING_NO_SPACE;
+	}
+	uint32_t at = r->next;
+	if (framed) {
+		status = emit_prologue(r, at, reset, &at);
+		if (status) {
+			return status;
+		}
+	}
+	for (size_t i = 0; i < count; ++i) {
+		r->ring[(at + i) & mask] = words[i];
+	}
+	at = (at + (uint32_t)count) & mask;
+	uint32_t end = 0;
+	status = framed ? emit_framed_fence(r, at, r->seqno + 1, &end) : emit_fence(r, at, r->seqno + 1, &end);
+	if (status) {
+		return status;
+	}
+	if (r->io.barrier(r->io.cookie)) {       /* the ring is Normal non-cacheable: ordering only */
+		return ring_poison(r);
+	}
+	status = ring_write_wptr(r, end);
+	if (status) {
+		return status;
+	}
+	r->next = end;
+	*fence = ++r->seqno;
+	++r->submissions;
+	if (reset) {
+		r->reset_pending = 0;
+	}
+	return A810_RING_OK;
+}
+int
+a810_ring_submit(struct a810_ring *r, const uint32_t *words, size_t count, uint32_t *fence)
+{
+	return ring_submit_words(r, words, count, fence, 0);
+}
+int
+a810_ring_submit_framed(struct a810_ring *r, const uint32_t *words, size_t count, uint32_t *fence)
+{
+	return ring_submit_words(r, words, count, fence, 1);
+}
+uint32_t
+a810_ring_observed(const struct a810_ring *r)
+{
+	if (!r->attached) {
+		return 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return r->fence[1];
+}
+int
+a810_ring_wait(struct a810_ring *r, uint32_t fence, uint64_t (*now_us)(void), void (*idle)(void), uint32_t timeout_us,
+    uint32_t *observed)
+{
+	if (observed) {
+		*observed = 0;
+	}
+	if (!r->attached || r->poisoned) {
+		return A810_FENCE_POISONED;
+	}
+	if (!fence || fence > r->seqno) {
+		return A810_FENCE_ARGUMENT;
+	}
+	uint64_t start = now_us ? now_us() : 0;
+	for (;;) {
+		__asm__ volatile ("dsb sy" ::: "memory");
+		const uint32_t value = r->fence[1];
+		if (observed) {
+			*observed = value;
+		}
+		if (value >= fence) {
+			if (value > r->seqno) {
+				ring_poison(r);
+				return A810_FENCE_POISONED;
+			}
+			if (value > r->completed) {
+				r->completed = value;
+			}
+			return A810_FENCE_DONE;
+		}
+		if (!now_us || now_us() - start >= timeout_us) {
+			return A810_FENCE_TIMEOUT;
+		}
+		if (idle) {
+			idle();
+		}
+	}
+}
+int
+a810_ring_kick(struct a810_ring *r)
+{
+	if (!r->attached || r->poisoned) {
+		return A810_RING_NOT_READY;
+	}
+	if (r->io.barrier(r->io.cookie)) {
+		return ring_poison(r);
+	}
+	return ring_write_wptr(r, r->next);
+}
+
+/* ---- NativeAdrenoCpInit.cpp ---- */
+int
+a810_cp_init(struct a810_ring *r, uint64_t sqe_iova, uint64_t pwrup_iova, uint32_t *fence)
+{
+	if (!fence) {
+		return A810_RING_ARGUMENT;
+	}
+	*fence = 0;
+	if (!r || r->poisoned || !sqe_iova || (sqe_iova & 4095) || !pwrup_iova || (pwrup_iova & 3)) {
+		return A810_RING_ARGUMENT;
+	}
+	uint32_t lo = 0, hi = 0;
+	if (r->io.read32(r->io.cookie, A810_CP_SQE_INSTR_BASE, &lo) || r->io.read32(r->io.cookie, A810_CP_SQE_INSTR_BASE + 1, &hi) ||
+	    (((uint64_t)hi << 32) | lo) != sqe_iova) {
+		return A810_RING_IO;
+	}
+	uint32_t words[10] = {0};
+	if (a810_pm4_type7(0x17, 1, &words[0]) || a810_pm4_type7(0x48, 7, &words[2])) {
+		return A810_RING_IO;
+	}
+	words[1] = 1u << 27;                   /* CP_THREAD_CONTROL: CONCURRENT_BIN_DISABLE */
+	words[3] = (1u << 0) | (1u << 1) | (1u << 3) | (1u << 6) | (1u << 8);
+	words[4] = 0x00000003;                 /* hardware contexts */
+	words[5] = 0x20000000;                 /* error detection */
+	words[6] = 0x00000002;                 /* operation mode */
+	words[7] = (uint32_t)pwrup_iova;
+	words[8] = (uint32_t)(pwrup_iova >> 32);
+	words[9] = 1u << 31;                   /* read registers from the list */
+	return a810_ring_submit(r, words, 10, fence);
+}
+
+/* ---- NativeAdrenoPwrup.cpp buildA810 ---- */
+int
+a810_pwrup_build(const struct a810_cp_io *io, volatile uint32_t *out, size_t capacity, size_t *written)
+{
+	if (!io || !out || !written) {
+		return A810_RING_ARGUMENT;
+	}
+	*written = 0;
+	uint32_t dynamic = 0;
+	for (uint32_t pipe = A810_PIPE_BR; pipe <= A810_PIPE_DDE_BV; ++pipe) {
+		for (size_t i = 0; i < NATIVE_ADRENO_A810_DYN_PWRUP_COUNT; ++i) {
+			if (NativeAdrenoA810DynPwrup[i][1] & (1u << pipe)) {
+				++dynamic;
+			}
+		}
+	}
+	const uint32_t ifpc = NATIVE_ADRENO_A810_IFPC_COUNT, preemption = NATIVE_ADRENO_A810_PWRUP_COUNT;
+	const size_t needed = 16 + (size_t)(ifpc + preemption) * 8 + (size_t)dynamic * 12;
+	if (capacity < needed || ifpc > 0xff || preemption > 0xff || dynamic > 0xffff) {
+		return A810_RING_NO_SPACE;
+	}
+	for (size_t i = 0; i < needed / 4; ++i) {
+		out[i] = 0;
+	}
+	/* struct cpu_gpu_lock: gpu_req, cpu_req, turn zero; then u8 ifpc_len, u8 preemption_len, u16 dynamic_len */
+	out[3] = ifpc | preemption << 8 | dynamic << 16;
+	size_t k = 4;
+	int status = 0;
+	if (io->write32(io->cookie, A810_CP_APERTURE_CNTL_HOST, 0)) {
+		return A810_RING_IO;
+	}
+	for (size_t i = 0; i < ifpc && !status; ++i) {
+		uint32_t v = 0;
+		out[k++] = NativeAdrenoA810IfpcRegs[i];
+		status = io->read32(io->cookie, NativeAdrenoA810IfpcRegs[i], &v);
+		out[k++] = v;
+	}
+	for (size_t i = 0; i < preemption && !status; ++i) {
+		uint32_t v = 0;
+		out[k++] = NativeAdrenoA810PwrupRegs[i];
+		status = io->read32(io->cookie, NativeAdrenoA810PwrupRegs[i], &v);
+		out[k++] = v;
+	}
+	for (uint32_t pipe = A810_PIPE_BR; pipe <= A810_PIPE_DDE_BV && !status; ++pipe) {
+		for (size_t i = 0; i < NATIVE_ADRENO_A810_DYN_PWRUP_COUNT && !status; ++i) {
+			if (!(NativeAdrenoA810DynPwrup[i][1] & (1u << pipe))) {
+				continue;
+			}
+			const uint32_t aperture = pipe << A810_CP_APERTURE_CNTL_HOST_PIPEID_SHIFT;   /* SLICEID 0 */
+			uint32_t v = 0;
+			out[k++] = aperture;
+			out[k++] = NativeAdrenoA810DynPwrup[i][0];
+			status = io->write32(io->cookie, A810_CP_APERTURE_CNTL_HOST, aperture) ||
+			    io->read32(io->cookie, NativeAdrenoA810DynPwrup[i][0], &v);
+			out[k++] = v;
+		}
+	}
+	if (io->write32(io->cookie, A810_CP_APERTURE_CNTL_HOST, 0)) {
+		status = 1;
+	}
+	if (status) {
+		for (size_t i = 0; i < needed / 4; ++i) {
+			out[i] = 0;
+		}
+		return A810_RING_IO;
+	}
+	io->barrier(io->cookie);
+	*written = needed;
+	return A810_RING_OK;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
