 // 128 MiB ran out at the Metal runtime's 64 MiB blocks, and XNU's window has no such contiguous run. The probe maps it whole
 // and halves the size down to 128 MiB if the map fails (pandora's 1 GiB in one ml_io_map panicked; ours is an IOKit map);
 // board.toml [gpu] gpu_pool_* must match.
-#define GPB_GPU_POOL_BASE 0xABFE00000ULL
-#define GPB_GPU_POOL_BYTES 0x40000000ULL
+// Bergamota asteroids (8 GB phone, 2026-10-28): its DDR ends at 0x9ffffefff (recovery /proc/iomem: System RAM
+// 0x8bf800000-0x9ffffefff), so 0xABFE00000 is not RAM here: mapping it raised an SError (boot ast5-gpu, right after
+// "next: GPU pool"). The pool is the top of the bank XNU leaves free instead: XNU's window is 0x8c0000000 +
+// 0x134000000 (tools/mkadt.py asteroids), the shim loads nothing above it, reserved-memory has no static region there.
+#define GPB_GPU_POOL_BASE 0x9F4000000ULL
+#define GPB_GPU_POOL_BYTES 0x8000000ULL
