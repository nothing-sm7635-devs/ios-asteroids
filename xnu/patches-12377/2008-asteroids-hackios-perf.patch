+/*
+ * The scaled copy split across cores (idea from HackiOS 8c6ea92, fb_threads): the presenter takes the first band of
+ * panel rows and sweetfb_threads-1 helper threads (default 3 in all, on the big cores, see sweet_amp_mark_big) take the
+ * others. A full 1080x2392 frame is ~10 MB of stores into the write-combined panel, one core does it in ~10 ms on an
+ * A720 and far longer on an A520. Small rects (cursor-sized updates) stay on the presenter.
+ */
+struct sweet_rows_job {
+	const uint8_t *base;
+	uintptr_t draw;
+	const uint32_t *xmap;
+	uint32_t bpr, rowBytes;
+	int32_t padY;
+	uint32_t scaleYNum, scaleYDen;
+	int32_t sy, dy, h, px0, n;
+};
+
+#define SWEET_ROWS_MAX_THREADS  4
+#define SWEET_ROWS_MIN_PIXELS   (256 * 1024)    /* below this one core is faster than waking helpers */
+
+
+static struct {
+	IOLock *lock;
+	unsigned helpers;               /* threads besides the presenter */
+	uint64_t gen;                   /* bumped per job; helpers wait for a new one */
+	unsigned pending;               /* helpers still drawing */
+	struct sweet_rows_job job;
+	int32_t band[SWEET_ROWS_MAX_THREADS + 1];
+} sweet_rows;
+
+static void
+sweet_rows_draw(const struct sweet_rows_job *j, int32_t from, int32_t to)
+{
+	for (int32_t py = from; py < to; py++) {
+		int32_t ly = (int32_t)((uint64_t)(py - j->padY) * j->scaleYDen / j->scaleYNum) - j->dy;
+		ly = ly < 0 ? 0 : (ly >= j->h ? j->h - 1 : ly);
+		const uint32_t *srow = (const uint32_t *)(j->base + (uint64_t)(j->sy + ly) * j->bpr);
+		/* not volatile: the panel mapping is write-combined, so the compiler may pair the stores */
+		uint32_t *drow = (uint32_t *)(j->draw + (uint64_t)py * j->rowBytes) + j->px0;
+		for (int32_t i = 0; i < j->n; i++) {
+			drow[i] = srow[j->xmap[i]];
+		}
+	}
+}
+
+static void
+sweet_rows_helper(void *arg, wait_result_t wr)
+{
+	unsigned index = (unsigned)(uintptr_t)arg;
+	uint64_t seen = 0;
+	(void)wr;
+
+	thread_set_thread_name(current_thread(), "sweetfb-rows");
+	for (;;) {
+		IOLockLock(sweet_rows.lock);
+		while (sweet_rows.gen == seen) {
+			IOLockSleep(sweet_rows.lock, &sweet_rows.gen, THREAD_UNINT);
+		}
+		seen = sweet_rows.gen;
+		struct sweet_rows_job job = sweet_rows.job;
+		int32_t from = sweet_rows.band[index], to = sweet_rows.band[index + 1];
+		IOLockUnlock(sweet_rows.lock);
+		sweet_rows_draw(&job, from, to);
+		IOLockLock(sweet_rows.lock);
+		if (--sweet_rows.pending == 0) {
+			IOLockWakeup(sweet_rows.lock, &sweet_rows.pending, false);
+		}
+		IOLockUnlock(sweet_rows.lock);
+	}
+}
+
+static void
+sweet_rows_start(void)
+{
+	unsigned threads = 3;
+	PE_parse_boot_argn("sweetfb_threads", &threads, sizeof(threads));
+	if (threads > SWEET_ROWS_MAX_THREADS) {
+		threads = SWEET_ROWS_MAX_THREADS;
+	}
+	if (threads <= 1 || (sweet_rows.lock = IOLockAlloc()) == NULL) {
+		return;
+	}
+	for (unsigned i = 1; i < threads; i++) {
+		thread_t thread;
+		if (kernel_thread_start(sweet_rows_helper, (void *)(uintptr_t)i, &thread) != KERN_SUCCESS) {
+			break;
+		}
+		sweet_amp_mark_big(thread);
+		thread_deallocate(thread);
+		sweet_rows.helpers++;
+	}
+	IOLog("SWEET FB: scaled copy on %u threads (sweetfb_threads)\n", sweet_rows.helpers + 1);
+}
+
+static void
+sweet_rows_run(const struct sweet_rows_job *j, int32_t py0, int32_t py1)
+{
+	unsigned parts = sweet_rows.helpers + 1;
+	if (parts == 1 || (int64_t)(py1 - py0) * j->n < SWEET_ROWS_MIN_PIXELS) {
+		sweet_rows_draw(j, py0, py1);
+		return;
+	}
+	IOLockLock(sweet_rows.lock);
+	sweet_rows.job = *j;
+	for (unsigned i = 0; i <= parts; i++) {
+		sweet_rows.band[i] = py0 + (int32_t)((int64_t)(py1 - py0) * i / parts);
+	}
+	sweet_rows.pending = sweet_rows.helpers;
+	sweet_rows.gen++;
+	IOLockWakeup(sweet_rows.lock, &sweet_rows.gen, false);
+	IOLockUnlock(sweet_rows.lock);
+	sweet_rows_draw(j, sweet_rows.band[0], sweet_rows.band[1]);
+	IOLockLock(sweet_rows.lock);
+	while (sweet_rows.pending != 0) {
+		IOLockSleep(sweet_rows.lock, &sweet_rows.pending, THREAD_UNINT);
+	}
+	IOLockUnlock(sweet_rows.lock);
+}
