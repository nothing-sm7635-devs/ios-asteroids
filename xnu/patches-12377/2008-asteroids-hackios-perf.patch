+/*
+ * Full-screen buffers kept for reuse (HackiOS e9d2151): the window server makes and drops screen-sized surfaces all the
+ * time, and each create was a fresh 6 MB wired allocation plus a bzero (2.6-4 ms there), each free a 2 ms unwire. Up
+ * to SWEET_SURF_CACHE freed buffers of SWEET_SURF_CACHE_MIN bytes or more are kept; a thread call zeroes them off the
+ * caller's path (a reused buffer must never show the previous owner's pixels); a create of the same size takes a zeroed
+ * one. Oldest evicted. sweetsurf_cache=0 turns it off.
+ */
+#define SWEET_SURF_CACHE        4
+#define SWEET_SURF_CACHE_MIN    (4u << 20)
+
+static struct {
+	IOBufferMemoryDescriptor *mem;
+	uint32_t size;
+	uint8_t state;                  /* 0 dirty, 1 being zeroed, 2 zeroed */
+	uint64_t stamp;
+} sweet_surf_cache[SWEET_SURF_CACHE];
+static IOLock *sweet_surf_cache_lock;
+static thread_call_t sweet_surf_cache_call;
+static uint64_t sweet_surf_cache_seq, sweet_surf_cache_hits, sweet_surf_cache_puts;
+static int sweet_surf_cache_on = -1;
+
+static void
+sweet_surf_cache_zero(thread_call_param_t, thread_call_param_t)
+{
+	for (;;) {
+		IOBufferMemoryDescriptor *mem = NULL;
+		unsigned slot = 0;
+		IOLockLock(sweet_surf_cache_lock);
+		for (unsigned i = 0; i < SWEET_SURF_CACHE; i++) {
+			if (sweet_surf_cache[i].mem != NULL && sweet_surf_cache[i].state == 0) {
+				sweet_surf_cache[i].state = 1;
+				mem = sweet_surf_cache[i].mem;
+				slot = i;
+				break;
+			}
+		}
+		IOLockUnlock(sweet_surf_cache_lock);
+		if (mem == NULL) {
+			return;
+		}
+		bzero(mem->getBytesNoCopy(), sweet_surf_cache[slot].size);
+		IOLockLock(sweet_surf_cache_lock);
+		sweet_surf_cache[slot].state = 2;       /* the slot is only emptied by take/put, which skip state 1 */
+		IOLockUnlock(sweet_surf_cache_lock);
+	}
+}
+
+static bool
+sweet_surf_cache_enabled(void)
+{
+	if (sweet_surf_cache_on < 0) {
+		int on = sweet_board_asteroids() ? 1 : 0;
+		PE_parse_boot_argn("sweetsurf_cache", &on, sizeof(on));
+		IOLock *lock = on ? IOLockAlloc() : NULL;
+		thread_call_t call = on ? thread_call_allocate_with_options(sweet_surf_cache_zero, NULL,
+		    THREAD_CALL_PRIORITY_KERNEL, THREAD_CALL_OPTIONS_ONCE) : NULL;
+		if (on && (lock == NULL || call == NULL)) {
+			on = 0;
+		}
+		if (!on || !OSCompareAndSwapPtr(NULL, lock, &sweet_surf_cache_lock)) {
+			if (lock != NULL) {
+				IOLockFree(lock);
+			}
+			if (call != NULL) {
+				thread_call_free(call);
+			}
+		} else {
+			sweet_surf_cache_call = call;
+		}
+		sweet_surf_cache_on = (on && sweet_surf_cache_lock != NULL && sweet_surf_cache_call != NULL) ? 1 : 0;
+	}
+	return sweet_surf_cache_on == 1;
+}
+
+/* A zeroed buffer of exactly this size, or NULL. */
+static IOBufferMemoryDescriptor *
+sweet_surf_cache_take(uint32_t size)
+{
+	IOBufferMemoryDescriptor *mem = NULL;
+	if (size < SWEET_SURF_CACHE_MIN || !sweet_surf_cache_enabled()) {
+		return NULL;
+	}
+	IOLockLock(sweet_surf_cache_lock);
+	for (unsigned i = 0; i < SWEET_SURF_CACHE; i++) {
+		if (sweet_surf_cache[i].mem != NULL && sweet_surf_cache[i].state == 2 && sweet_surf_cache[i].size == size) {
+			mem = sweet_surf_cache[i].mem;
+			sweet_surf_cache[i].mem = NULL;
+			sweet_surf_cache_hits++;
+			break;
+		}
+	}
+	IOLockUnlock(sweet_surf_cache_lock);
+	return mem;
+}
+
+/* Keeps mem (the caller's reference passes to the cache); false: not kept, the caller releases it. */
+static bool
+sweet_surf_cache_put(IOBufferMemoryDescriptor *mem, uint32_t size)
+{
+	IOBufferMemoryDescriptor *evict = NULL;
+	if (size < SWEET_SURF_CACHE_MIN || !sweet_surf_cache_enabled()) {
+		return false;
+	}
+	IOLockLock(sweet_surf_cache_lock);
+	int slot = -1;
+	for (unsigned i = 0; i < SWEET_SURF_CACHE; i++) {
+		if (sweet_surf_cache[i].mem == NULL) {
+			slot = (int)i;
+			break;
+		}
+		if (sweet_surf_cache[i].state != 1 && (slot < 0 || sweet_surf_cache[i].stamp < sweet_surf_cache[slot].stamp)) {
+			slot = (int)i;
+		}
+	}
+	if (slot >= 0) {
+		evict = sweet_surf_cache[slot].mem;
+		sweet_surf_cache[slot].mem = mem;
+		sweet_surf_cache[slot].size = size;
+		sweet_surf_cache[slot].state = 0;
+		sweet_surf_cache[slot].stamp = ++sweet_surf_cache_seq;
+		if ((++sweet_surf_cache_puts & 1023) == 1) {
+			IOLog("SWEET SURF: buffer cache: %llu kept, %llu reused\n", sweet_surf_cache_puts, sweet_surf_cache_hits);
+		}
+	}
+	IOLockUnlock(sweet_surf_cache_lock);
+	if (slot < 0) {
+		return false;
+	}
+	OSSafeReleaseNULL(evict);
+	thread_call_enter(sweet_surf_cache_call);
+	return true;
+}
