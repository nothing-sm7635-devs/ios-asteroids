+/*
+ * The GPU bank's fault status, polled by SweetAdreno's fence wait. A fault (TF/AFF/PF/EF/TLB/ASF/UUT/SS/MULTI; bit 10 reads
+ * set on this SMMU without a fault) is logged with what its page is here, then cleared. The bank terminates faulting
+ * transactions (SCTLR.CFCFG 0), so the GPU is not held; whether it then finishes is what the fence wait sees.
+ * Returns false: the wait goes on.
+ */
+bool
+sweet_a810_msm_fault_check(void)
+{
+	uint32_t f[5];
+	static uint64_t last_page = ~0ull;
+
+	if (!am_inited || am_mapped == NULL || !sweet_a810_ready()) {
+		return false;
+	}
+	a810_gpu_context_faults(f);
+	if (!(f[0] & 0xc00001feu)) {
+		return false;
+	}
+	uint64_t far = ((uint64_t)f[2] << 32) | f[1], page = far & ~(AM_PAGE - 1);
+	a810_gpu_context_clear_fault(f[0]);
+	am_faults++;
+	if (page == last_page && am_faults > 1) {
+		return false;
+	}
+	last_page = page;
+	if (am_faults > 64 && (am_faults & 63) != 0) {
+		return false;
+	}
+	const char *what = "outside the GPU address window";
+	if (far >= SWEET_A810_VA_START && far < SWEET_A810_VA_END) {
+		what = am_bit(page) ? "MAPPED (a permission or walk fault)" : "inside a live allocation but not mapped (its guard page?)";
+		for (unsigned i = 0; i < am_nfree; i++) {
+			if (far >= am_free[i].start && far < am_free[i].start + am_free[i].size) {
+				what = "in FREE address space";
+				break;
+			}
+		}
+	}
+	printf("SWEET GPU: A810 SMMU FAULT %u: FSR %#x FAR %#llx FSYNR0 %#x (%s, %s): %s; newest fence %u, observed done %d\n",
+	    am_faults, f[0], far, f[3], (f[3] & 0x10) ? "write" : "read", (f[0] & 0x40000000u) ? "stalled" : "terminated", what,
+	    am_last, sweet_a810_fence_passed(am_last));
+	unsigned shown = 0;
+	for (unsigned k = 0; k < AM_FREED && k < am_freed_next && shown < 4; k++) {
+		unsigned i = (am_freed_next - 1 - k) % AM_FREED;
+		if (far >= am_freed[i].iova && far < am_freed[i].iova + am_freed[i].size + AM_PAGE) {
+			printf("SWEET GPU: A810 SMMU FAULT %u: the page was in %#llx+%#llx, freed %u frees ago at fence %u\n", am_faults,
+			    am_freed[i].iova, am_freed[i].size, k, am_freed[i].fence);
+			shown++;
+		}
+	}
+	if (!shown) {
+		uint64_t lo = 0, hi = ~0ull;
+		for (unsigned i = 0; i < am_nfree; i++) {
+			uint64_t e = am_free[i].start + am_free[i].size;
+			if (am_free[i].start <= far && far < e) {
+				lo = am_free[i].start;
+				hi = e;
+			}
+		}
+		printf("SWEET GPU: A810 SMMU FAULT %u: not among the last %u frees; free range around it %#llx-%#llx, %u free ranges\n",
+		    am_faults, AM_FREED, lo, hi, am_nfree);
+	}
+	sweet_log_sync();
+	return false;
+}
