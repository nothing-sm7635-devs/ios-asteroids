+/* Clears the GPU bank's fault status (write-one-to-clear), so the next fault is recorded on its own. */
+void
+a810_gpu_context_clear_fault(uint32_t fsr)
+{
+	if (gpu_ctx.used && gpu_ctx.context_offset && fsr) {
+		io_write32(&gpu_ctx.io, (size_t)gpu_ctx.context_offset + 0x58, fsr);
+	}
+}
