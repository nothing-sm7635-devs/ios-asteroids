-		IOLog("SWEET GPU: no GPU address space for %llu bytes\n", size);
-		return kIOReturnNoSpace;
+		quarantineDrain(true);       /* the quarantine may hold the space: give back what the GPU is done with */
+		if (!sweet_gpu_iova_alloc(size + tail, &iova, &taken)) {
+			IOLog("SWEET GPU: no GPU address space for %llu bytes (quarantine %u BOs, %llu bytes)\n", size, gQuarCount, gQuarBytes);
+			return kIOReturnNoSpace;
+		}
 	}
 	bool ok = true;
 	uint64_t mapped = 0;
@@ -796,6 +880,7 @@ SweetAdrenoUserClient::submit(struct sweet_msm_gem_submit *r)
 		fLastFence = fence;
