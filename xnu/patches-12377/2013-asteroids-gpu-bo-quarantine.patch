 		sweet_gpu_vm_unmap(g->iova, g->size + g->tail);
 		sweet_gpu_iova_free(g->iova, g->vaLen);
 	}
@@ -501,8 +582,11 @@ SweetAdrenoUserClient::mapGem(struct sweet_gem *slot, uint32_t flags, uint32_t *
