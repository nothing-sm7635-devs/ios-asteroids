+/*
+ * 2014: a hang's command streams in the kernel log, for decoding offline (Mesa's cffdec): the BR and BV pipes' IB1/IB2/IB3
+ * pointers, then the dwords of each IB that lies in one of this client's BOs with a kernel alias (Turnip's command-stream
+ * BOs are GEM_NEW ones). Up to 4096 dwords an IB, eight a line: "SWEET HANG <what> <iova>: w0 .. w7". Once a boot.
+ */
+void
+SweetAdrenoUserClient::dumpIova(const char *what, uint64_t iova, uint32_t dwords, uint32_t at)
+{
+	if (iova == 0 || dwords == 0 || fGems == NULL) {
+		return;
+	}
+	if (dwords > 4096) {
+		dwords = 4096;
+	}
+	for (uint32_t i = 0; i < GEM_MAX; i++) {
+		struct sweet_gem *g = &fGems[i];
+		if (g->md == NULL || g->kva == NULL || g->iova == IOVA_UNSET || iova < g->iova || iova >= g->iova + g->size) {
+			continue;
+		}
+		uint64_t off = iova - g->iova;
+		if (off + (uint64_t)dwords * 4 > g->size) {
+			dwords = (uint32_t)((g->size - off) / 4);
+		}
+		IOLog("SWEET HANG %s %#llx: %u dwords in handle %u (BO %#llx+%#llx), the CP at dword %u\n", what, iova, dwords, i,
+		    g->iova, g->size, at);
+		const volatile uint32_t *w = (const volatile uint32_t *)(g->kva + off);
+		for (uint32_t k = 0; k < dwords; k += 8) {
+			uint32_t v[8] = {0};
+			for (uint32_t j = 0; j < 8 && k + j < dwords; j++) {
+				v[j] = w[k + j];
+			}
+			IOLog("SWEET HANG %s %#llx: %08x %08x %08x %08x %08x %08x %08x %08x\n", what, iova + (uint64_t)k * 4, v[0], v[1], v[2],
+			    v[3], v[4], v[5], v[6], v[7]);
+		}
+		return;
+	}
+	IOLog("SWEET HANG %s %#llx: not in a BO of this client with a kernel alias\n", what, iova);
+}
+
+void
+SweetAdrenoUserClient::dumpHang(void)
+{
+	static bool done;
+	uint32_t s[24];
+	if (done || !sweet_gpu_ib_state(s)) {
+		return;
+	}
+	done = true;
+	static const char *const names[6] = {"BR-IB1", "BR-IB2", "BR-IB3", "BV-IB1", "BV-IB2", "BV-IB3"};
+	for (unsigned k = 0; k < 6; k++) {
+		const uint32_t *r = &s[(k / 3) * 12 + (k % 3) * 4];
+		IOLog("SWEET HANG %s base %#llx rem %u init %u\n", names[k], ((uint64_t)r[1] << 32) | r[0], r[2], r[3]);
+	}
+	for (unsigned k = 0; k < 6; k++) {
+		const uint32_t *r = &s[(k / 3) * 12 + (k % 3) * 4];
+		uint64_t base = ((uint64_t)r[1] << 32) | r[0];
+		if (base != 0 && r[3] != 0) {
+			dumpIova(names[k], base, r[3], r[3] >= r[2] ? r[3] - r[2] : 0);
+		}
+	}
+}
