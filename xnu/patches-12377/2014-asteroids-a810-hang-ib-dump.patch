+/* The CP's indirect-buffer pointers (a6xx.xml A8XX-: CP_IB1_BASE 0x900, REM 0x902, INIT 0x903, IB2 0x904.., IB3 0x908..), for
+ * the BR pipe (out[0..11]) and the BV pipe (out[12..23]): base lo/hi, remaining and initial dwords of IB1, IB2, IB3. */
+bool
+sweet_a810_ib_state(uint32_t out[24])
+{
+	static const uint32_t regs[12] = {0x900, 0x901, 0x902, 0x903, 0x904, 0x905, 0x906, 0x907, 0x908, 0x909, 0x90a, 0x90b};
+	if (!a810_cp_started || !a810_gpu_writes) {
+		return false;
+	}
+	lck_mtx_lock(&a810_lck);
+	const uint32_t pipes[2] = {A810_PIPE_BR, A810_PIPE_BV};
+	for (unsigned p = 0; p < 2; p++) {
+		a810_reg_write(NULL, A810_CP_APERTURE_CNTL_HOST, pipes[p] << A810_CP_APERTURE_CNTL_HOST_PIPEID_SHIFT);
+		for (unsigned i = 0; i < 12; i++) {
+			out[p * 12 + i] = 0;
+			a810_reg_read(NULL, regs[i], &out[p * 12 + i]);
+		}
+	}
+	a810_reg_write(NULL, A810_CP_APERTURE_CNTL_HOST, 0);
+	lck_mtx_unlock(&a810_lck);
+	return true;
+}
