+/*
+ * GPU hang recovery (2015), the A8XX CP soft reset of Snapintosh's EL2 monitor (compat/adreno-ib.c adreno_recover, MIT,
+ * Acelogic/Snapintosh) on this bring-up's own stages: halt the SQE and the GX then CX bus traffic (each acknowledged),
+ * clear the SMMU fault, pulse RBBM_SW_RESET_CMD (A8XX 0x073, at least 100 us), wipe the ring and the memptrs, replay
+ * stage 13's hw_init (it unhalts GBIF) keeping the LLCC SCIDs, stage 14's SQE start and CP_ME_INIT on a re-attached ring,
+ * stage 15's secure-mode exit (the zap shader stays loaded across a soft reset), invalidate the GPU caches, clear the
+ * sticky RBBM interrupts. Every fence handed out before the hang then reads as passed (the hung work is void) and the
+ * next user submission carries the context entry again. At most 8 a boot. Returns 1 when the GPU answers again.
+ */
+static uint32_t a810_recoveries;
+
+static int
+a810_wait_bits(uint32_t reg, uint32_t mask, unsigned us)
+{
+	uint32_t v = 0;
+	for (unsigned t = 0; t <= us; t += 10) {
+		if (!a810_reg_read(NULL, reg, &v) && (v & mask) == mask) {
+			return 0;
+		}
+		delay(10);
+	}
+	return 1;
+}
+
+int
+sweet_a810_recover(const char *why)
+{
+	const char *step = "policy";
+	uint32_t f[5], sc0 = 0, sc1 = 0, v = 0, fence = 0, seen = 0;
+	int ok = 0, wait = -1, st = 0;
+
+	if (!a810_cp_started || !a810_gpu_writes || a810_recoveries >= 8) {
+		A810_LOG("SWEET A810: recovery refused (%s): started %d, %u recoveries so far\n", why, a810_cp_started, a810_recoveries);
+		return 0;
+	}
+	a810_recoveries++;
+	lck_mtx_lock(&a810_lck);
+	const uint32_t old = a810_ring.seqno;
+	a810_reg_read(NULL, 0x3c01, &sc0);                 /* GBIF_SCACHE_CNTL0/1: the LLCC SCIDs, kept */
+	a810_reg_read(NULL, 0x3c02, &sc1);
+	step = "halt";
+	a810_reg_write(NULL, A810_CP_SQE_CNTL, 3);
+	a810_reg_write(NULL, A810_RBBM_GBIF_HALT, 1);
+	if (a810_wait_bits(A810_RBBM_GBIF_HALT_ACK, 1, 1000)) {
+		goto out;
+	}
+	a810_reg_write(NULL, 0x3c45, 1);                    /* GBIF_HALT: client 1, then the arbiter 2 */
+	if (a810_wait_bits(0x3c46, 1, 1000)) {
+		goto out;
+	}
+	a810_reg_write(NULL, 0x3c45, 2);
+	if (a810_wait_bits(0x3c46, 2, 1000)) {
+		goto out;
+	}
+	a810_gpu_context_faults(f);
+	if (f[0] & 0xc00001feu) {
+		a810_gpu_context_clear_fault(f[0]);
+	}
+	step = "reset";
+	a810_reg_write(NULL, 0x073, 1);                     /* RBBM_SW_RESET_CMD */
+	a810_reg_read(NULL, 0x073, &v);
+	delay(150);
+	a810_reg_write(NULL, 0x073, 0);
+	a810_reg_read(NULL, 0x073, &v);
+	a810_reg_read(NULL, A810_CP_SQE_CNTL, &v);
+	if (v & 3) {
+		goto out;
+	}
+	for (size_t i = 0; i < a810_ring.ring_bytes / 4; i++) {
+		a810_ring.ring[i] = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	step = "hw_init";
+	{
+		const struct gpb_gx_io gio = {NULL, a810_gx_read, a810_gx_write, a810_gx_vote, a810_delay_us};
+		gpb_hw_init(&gio, &a810_hw);
+		if (a810_hw.failed || a810_hw.step != 9) {
+			goto out;
+		}
+	}
+	a810_reg_write(NULL, 0x3c01, sc0);
+	a810_reg_write(NULL, 0x3c02, sc1);
+	step = "cp";
+	{
+		const uint64_t sqe = a810_gbuf[A810_GPU_SQE].iova, bv_rptr = a810_gbuf[A810_GPU_MEMPTRS].iova + 8;
+		a810_reg_write(NULL, A810_CP_SQE_INSTR_BASE, (uint32_t)sqe);
+		a810_reg_write(NULL, A810_CP_SQE_INSTR_BASE + 1, (uint32_t)(sqe >> 32));
+		a810_ring.attached = 0;
+		a810_ring.poisoned = 0;
+		if (a810_ring_attach(&a810_ring, &a810_cp_io, a810_gbuf[A810_GPU_RING].cpu, (size_t)a810_gbuf[A810_GPU_RING].bytes,
+		    a810_gbuf[A810_GPU_RING].iova, a810_gbuf[A810_GPU_MEMPTRS].cpu, (size_t)a810_gbuf[A810_GPU_MEMPTRS].bytes,
+		    a810_gbuf[A810_GPU_MEMPTRS].iova)) {
+			goto out;
+		}
+		a810_reg_write(NULL, A810_CP_RB_RPTR_ADDR_BV, (uint32_t)bv_rptr);
+		a810_reg_write(NULL, A810_CP_RB_RPTR_ADDR_BV + 1, (uint32_t)(bv_rptr >> 32));
+		a810_reg_write(NULL, A810_CP_SQE_CNTL, A810_INIT_CP_SQE_CNTL);
+		if (a810_cp_init(&a810_ring, sqe, a810_gbuf[A810_GPU_PWRUP].iova, &fence) ||
+		    a810_ring_wait(&a810_ring, fence, a810_now, a810_idle, A810_FENCE_TIMEOUT_US, &seen)) {
+			goto out;
+		}
+	}
+	step = "secure";
+	{
+		uint32_t secure[2] = {0, 0};
+		if (a810_pm4_type7(GPB_CP_SET_SECURE_MODE, 1, &secure[0]) ||
+		    !a810_mem_write(a810_gbuf[A810_GPU_SCRATCH].iova + 4, secure, 2, 0x05ec0ff2, &fence, &seen, &st, &wait) || st || wait) {
+			goto out;
+		}
+		a810_secure_exit_regs("recovery");
+	}
+	step = "scrub";
+	{
+		uint32_t w[10];
+		if (a810_pm4_type7(0x17, 1, &w[0]) || a810_pm4_type7(0x46, 1, &w[2]) || a810_pm4_type7(0x46, 1, &w[4]) ||
+		    a810_pm4_type7(0x46, 1, &w[6]) || a810_pm4_type7(0x17, 1, &w[8])) {
+			goto out;
+		}
+		w[1] = 1;               /* CP_THREAD_CONTROL: BR */
+		w[3] = 0x18;            /* CP_EVENT_WRITE7: CCU_INVALIDATE_DEPTH */
+		w[5] = 0x19;            /* CCU_INVALIDATE_COLOR */
+		w[7] = 0x33;            /* CACHE_INVALIDATE7 */
+		w[9] = 3;               /* CP_THREAD_CONTROL: both */
+		if (a810_ring_submit(&a810_ring, w, 10, &fence) ||
+		    a810_ring_wait(&a810_ring, fence, a810_now, a810_idle, A810_FENCE_TIMEOUT_US, &seen)) {
+			goto out;
+		}
+	}
+	a810_reg_read(NULL, A810_RBBM_INT_0_STATUS, &v);
+	a810_reg_write(NULL, A810_RBBM_INT_CLEAR_CMD, v);
+	/* the hung work is void: every fence handed out so far reads as passed, numbering goes on from there */
+	a810_ring.seqno = a810_ring.completed = old;
+	a810_ring.fence[1] = old;
+	a810_ring.fence[3] = old;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a810_ring_request_reset(&a810_ring);
+	ok = 1;
+	step = "done";
+out:
+	if (!ok) {
+		a810_cp_state("recovery failed");
+	}
+	lck_mtx_unlock(&a810_lck);
+	A810_LOG("SWEET A810: RECOVERY %u (%s): %s at step %s, fences up to %u void\n", a810_recoveries, why,
+	    ok ? "the GPU answers again" : "FAILED", step, old);
+	sweet_log_sync();
+	return ok;
+}
+
+uint32_t
+sweet_a810_recoveries(void)
+{
+	return a810_recoveries;
+}
