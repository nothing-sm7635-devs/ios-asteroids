+/*
+ * After CP_SET_SECURE_MODE 0: RBBM_SECVID_TRUST_CNTL 0 and the BR pipe's RB_GC_GMEM_PROTECT (2015). hw_init's non-context
+ * list wrote the GMEM protect while the CP was still secure, where the write does not hold (NativeAdrenoA810HwInit.h says it
+ * is held back until after the secure-mode exit; nothing wrote it then). Snapintosh's A8XX recovery replays the same pair
+ * after the exit (compat/adreno-recover-table.h adreno_recover_secvid, MIT, Acelogic/Snapintosh). The value is A810's
+ * from the non-context list.
+ */
+static void
+a810_secure_exit_regs(const char *when)
+{
+	uint32_t trust = ~0u, prot = ~0u;
+	a810_reg_write(NULL, A810_RBBM_SECVID_TRUST_CNTL, 0);
+	a810_reg_read(NULL, A810_RBBM_SECVID_TRUST_CNTL, &trust);
+	a810_reg_write(NULL, A810_CP_APERTURE_CNTL_HOST, A810_PIPE_BR << A810_CP_APERTURE_CNTL_HOST_PIPEID_SHIFT);
+	a810_reg_write(NULL, A810_RB_GC_GMEM_PROTECT, 0x00900000u);
+	a810_reg_read(NULL, A810_RB_GC_GMEM_PROTECT, &prot);
+	a810_reg_write(NULL, A810_CP_APERTURE_CNTL_HOST, 0);
+	A810_LOG("SWEET A810: %s: after the secure exit: SECVID_TRUST_CNTL %#x, BR RB_GC_GMEM_PROTECT %#x\n", when, trust, prot);
+}
