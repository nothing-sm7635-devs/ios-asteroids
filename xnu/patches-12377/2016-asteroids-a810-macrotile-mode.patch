+ * set the hardware up as Linux does; the ast13 hang dump had a UBWC RGBA16F render target bound. */
 bool
 sweet_a810_msm_param(uint32_t which, uint64_t *value)
 {
@@ -453,7 +456,7 @@ sweet_a810_msm_param(uint32_t which, uint64_t *value)
 	case 15: *value = SWEET_A810_VA_END - SWEET_A810_VA_START; return true;     /* VA_SIZE */
 	case 16: *value = AM_UBWC_HBB; return true;                    /* HIGHEST_BANK_BIT */
 	case 18: *value = AM_UBWC_SWIZZLE; return true;                /* UBWC_SWIZZLE */
-	case 19: *value = 0; return true;                               /* MACROTILE_MODE */
+	case 19: *value = 1; return true;                               /* MACROTILE_MODE: 8-channel (2016) */
 	default: return false;
 	}
 }
