--- a/bsd/dev/sweet_a810_msm.c
+++ b/bsd/dev/sweet_a810_msm.c
@@ -431,7 +431,10 @@ sweet_a810_msm_fault_check(void)
 	return false;
 }
 
-/* msm MSM_PARAM_* (the numbers are sweet_a630.c's switch): the A810's facts from sweet_a810_board.h. */
+/* msm MSM_PARAM_* (the numbers are sweet_a630.c's switch): the A810's facts from sweet_a810_board.h.
+ * MACROTILE_MODE is Linux's qcom_ubwc_macrotile_mode(): ubwc_enc_version >= UBWC_3_1, so 1 for milos (UBWC 4.0). It was 0
