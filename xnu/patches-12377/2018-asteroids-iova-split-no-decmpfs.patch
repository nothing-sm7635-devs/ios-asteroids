diff --git a/bsd/sweet_hfs/core/hfs_vnops.c b/bsd/sweet_hfs/core/hfs_vnops.c
index cd5a56a..e69f1be 100644
--- a/bsd/sweet_hfs/core/hfs_vnops.c
+++ b/bsd/sweet_hfs/core/hfs_vnops.c
@@ -1274,6 +1274,16 @@ hfs_set_bsd_flags(struct hfsmount *hfsmp, struct cnode *cp,
 {
 	u_int16_t *fdFlags;
 
+	/*
+	 * 2018: this kernel registers no decmpfs decompressor (AppleFSCompression is not here), so a file turned compressed can
+	 * never be read again ("tried to access a compressed file of unregistered type 12": Safari aborted at launch and
+	 * Settings froze on files iOS had compressed with LZFSE at run time, asteroids ast15). The flag is refused; writers keep
+	 * the plain file. The volume no longer claims VOL_CAP_FMT_DECMPFS_COMPRESSION either (hfs_vfsops.c).
+	 */
+	if ((new_bsd_flags & UF_COMPRESSED) && !(cp->c_bsdflags & UF_COMPRESSED)) {
+		return ENOTSUP;
+	}
+
 	if ((new_bsd_flags & UF_TRACKED) && !(cp->c_bsdflags & UF_TRACKED)) {
 		struct FndrExtendedDirInfo *fip = (struct FndrExtendedDirInfo *)((char *)&cp->c_attr.ca_finderinfo + 16);
 
