diff --git a/bsd/dev/sweet_a810_msm.c b/bsd/dev/sweet_a810_msm.c
index 9305bd0..fa18b11 100644
--- a/bsd/dev/sweet_a810_msm.c
+++ b/bsd/dev/sweet_a810_msm.c
@@ -4,9 +4,11 @@
  * SweetAdreno.cpp calls the sweet_gpu_* functions of sweet_a630.c; on asteroids each of those forwards here
  * (sweet_board_asteroids()), and this file answers them with the A810 that sweeta810=16 brought up (sweet_a810_api.h).
  * Differences from the A630 backend that the user client does not see:
- *   - GPU addresses are [SWEET_A810_VA_START, SWEET_A810_VA_END), one bit per 4 KiB page, next-fit (2017: the A630's
- *     512-entry free list overflowed on asteroids and dropped every free it could not merge, ast14: 2640 ranges lost
- *     until no texture could be allocated).
+ *   - GPU addresses are [SWEET_A810_VA_START, SWEET_A810_VA_END), one bit per 4 KiB page (2017: the A630's 512-entry free
+ *     list overflowed on asteroids and dropped every free it could not merge, ast14: 2640 ranges lost). First-fit, small
+ *     allocations (under 1 MiB) in the lower half and large ones in the upper half, each falling back to the whole window
+ *     (2018: 2017's next-fit scattered long-lived small BOs over the whole window and full-screen textures found no hole
+ *     with 21% of it taken, ast15).
  *   - Page maps are collected into physically contiguous runs and entered at vm_flush (each sweet_a810_vm_map is one
  *     TLB invalidate). A bitmap of mapped pages lets a map over a page that is still mapped replace it (the A630's
  *     page-table write did) and lets an unmap skip pages that were never mapped.
@@ -44,7 +46,7 @@ extern void sweet_log_sync(void);               /* sweet_ufs.c */
 #define AM_PAGES        ((SWEET_A810_VA_END - SWEET_A810_VA_START) / AM_PAGE)
 
 static uint64_t *am_used;                       /* one bit per page of the window: taken from the allocator */
-static uint64_t am_hint, am_used_pages;         /* next-fit start (page index); pages taken */
+static uint64_t am_used_pages;                  /* pages taken */
 static bool am_inited, am_lost;
 static uint8_t *am_mapped;                      /* one bit per page of the window */
 static uint32_t am_last;                        /* the newest fence handed out */
@@ -182,19 +184,21 @@ am_find(uint64_t from, uint64_t to, uint64_t pages, uint64_t *first)
 	return false;
 }
 
+#define AM_SMALL_PAGES  256                     /* 1 MiB: below, the lower half of the window */
 bool
 sweet_a810_msm_iova_alloc(uint64_t size, uint64_t *iova, uint64_t *taken)
 {
-	uint64_t need = size + AM_GUARD, pages = need / AM_PAGE, first = 0;
+	uint64_t need = size + AM_GUARD, pages = need / AM_PAGE, first = 0, mid = AM_PAGES / 2;
 
 	if (!sweet_a810_msm_ready() || size == 0 || (size & (AM_PAGE - 1)) || pages > AM_PAGES) {
 		return false;
 	}
-	if (!am_find(am_hint, AM_PAGES, pages, &first) && !am_find(0, AM_PAGES, pages, &first)) {
+	bool found = pages < AM_SMALL_PAGES ? am_find(0, mid, pages, &first) : am_find(mid, AM_PAGES, pages, &first);
+	if (!found && !am_find(0, AM_PAGES, pages, &first)) {
+		printf("SWEET GPU: A810 no run of %llu pages (%llu of %llu taken)\n", pages, am_used_pages, (uint64_t)AM_PAGES);
 		return false;
 	}
 	am_used_mark(first, pages, true);
-	am_hint = first + pages < AM_PAGES ? first + pages : 0;
 	*iova = SWEET_A810_VA_START + first * AM_PAGE;
 	*taken = need;
 	return true;
