diff --git a/bsd/dev/sweet_a810.c b/bsd/dev/sweet_a810.c
index 884cbc5..59c4730 100644
--- a/bsd/dev/sweet_a810.c
+++ b/bsd/dev/sweet_a810.c
@@ -1553,7 +1553,8 @@ sweet_a810_hang_report(const char *why)
  * stage 13's hw_init (it unhalts GBIF) keeping the LLCC SCIDs, stage 14's SQE start and CP_ME_INIT on a re-attached ring,
  * stage 15's secure-mode exit (the zap shader stays loaded across a soft reset), invalidate the GPU caches, clear the
  * sticky RBBM interrupts. Every fence handed out before the hang then reads as passed (the hung work is void) and the
- * next user submission carries the context entry again. At most 8 a boot. Returns 1 when the GPU answers again.
+ * next user submission carries the context entry again. At most 64 a boot (8 until 2018: ast15 used 7 in one session).
+ * Returns 1 when the GPU answers again.
  */
 static uint32_t a810_recoveries;
 
@@ -1577,7 +1578,7 @@ sweet_a810_recover(const char *why)
 	uint32_t f[5], sc0 = 0, sc1 = 0, v = 0, fence = 0, seen = 0;
 	int ok = 0, wait = -1, st = 0;
 
-	if (!a810_cp_started || !a810_gpu_writes || a810_recoveries >= 8) {
+	if (!a810_cp_started || !a810_gpu_writes || a810_recoveries >= 64) {
 		A810_LOG("SWEET A810: recovery refused (%s): started %d, %u recoveries so far\n", why, a810_cp_started, a810_recoveries);
 		return 0;
 	}
