+/*
+ * 2020, from UniXNU's NativeAdreno (int-100, int-160, NativeAdrenoReassertWriteCombined): XNU can put the pages of a
+ * write-combined BO back to its default, cacheable attribute (they found 123847 scattered BO pages reset). A command
+ * stream or descriptor whose words then sit in a CPU cache is read stale by the GPU, which does not snoop: the CP stopped
+ * at the end of an IB, and data read as addresses. Before a submission the pages of its command-stream BOs, and every
+ * 32nd submission those of all its owned BOs, are checked and put back to write-combined (the pmap cleans a page it takes
+ * away from the cacheable attribute). Only managed pages: an I/O range answers VM_WIMG_IO and is left alone.
+ */
+#define SWEET_WIMG_MASK  0xffu
+#define SWEET_WIMG_WCOMB 0x6u           /* osfmk/arm/memory_types.h VM_WIMG_WCOMB */
+#define SWEET_WIMG_IO    0x7u           /* VM_WIMG_IO */
+static uint64_t gWcFixed, gWcChecked;
+static uint32_t gWcSubmits, gWcSaid;
+
+static uint32_t
+wcReassert(struct sweet_gem *g)
+{
+	uint32_t fixed = 0;
+	if (g == NULL || g->buf == NULL || g->md == NULL) {
+		return 0;                       /* owned (GEM_NEW, write-combined) BOs only */
+	}
+	for (uint64_t off = 0; off < g->size; off += PAGE_SIZE) {
+		IOByteCount length = 0;
+		addr64_t pa = g->md->getPhysicalSegment(off, &length, kIOMemoryMapperNone);
+		if (pa == 0) {
+			continue;
+		}
+		ppnum_t pn = (ppnum_t)(pa >> PAGE_SHIFT);
+		unsigned int attr = pmap_cache_attributes(pn) & SWEET_WIMG_MASK;
+		gWcChecked++;
+		if (attr != SWEET_WIMG_WCOMB && attr != SWEET_WIMG_IO) {
+			pmap_set_cache_attributes(pn, SWEET_WIMG_WCOMB);
+			fixed++;
+		}
+	}
+	return fixed;
+}
