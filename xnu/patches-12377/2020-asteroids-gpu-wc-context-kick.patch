+/*
+ * 2020, from UniXNU's NativeAdreno (c285ae8, 8ad15b6): the next framed submission carries the full context entry again
+ * (CP_RESET_CONTEXT_STATE between thread syncs, LRZ flush, SRAM init) whenever the submitting client changed: Turnip's
+ * BR/BV barriers keep on-chip timestamps and counters only that entry resets, and without it the two threads waited on
+ * each other for good with no fault. And a stalled fence first gets its write pointer written again (most of their
+ * stalls ended there within milliseconds) before the soft reset.
+ */
+void
+sweet_a810_context_switch(void)
+{
+	if (!a810_cp_started) {
+		return;
+	}
+	lck_mtx_lock(&a810_lck);
+	a810_ring_request_reset(&a810_ring);
+	lck_mtx_unlock(&a810_lck);
+}
+
+int
+sweet_a810_kick(void)
+{
+	uint32_t rptr = 0, wptr = 0, rbbm = 0;
+	int st;
+	if (!a810_cp_started) {
+		return -1;
+	}
+	lck_mtx_lock(&a810_lck);
+	a810_reg_read(NULL, A810_CP_RB_RPTR, &rptr);
+	a810_reg_read(NULL, A810_CP_RB_WPTR, &wptr);
+	a810_reg_read(NULL, A810_RBBM_STATUS, &rbbm);
+	st = a810_ring_kick(&a810_ring);
+	lck_mtx_unlock(&a810_lck);
+	A810_LOG("SWEET A810: stalled fence: WPTR written again (rptr %#x wptr %#x rbbm %#x) -> %d\n", rptr, wptr, rbbm, st);
+	return st;
+}
