@@ -3902,6 +3964,9 @@ VNOP_GETATTR(vnode_t vp, struct vnode_attr * vap, vfs_context_t ctx)
 
 	_err = (*vp->v_op[vnop_getattr_desc.vdesc_offset])(&a);
 	DTRACE_FSINFO(getattr, vnode_t, vp);
+	if (_err == 0 && VATTR_IS_ACTIVE(vap, va_dataprotect_class) && sweet_dataprotect_emulated(vp)) {
+		sweet_dataprotect_getattr(vp, vap, ctx);
+	}
 
 	return _err;
 }
