+/*
+ * Bergamota 2021: data protection classes on a volume without content protection (asteroids boots an HFS+ root, MNT_CPROTECT
+ * clear). Ported from UniXNU's iPadOS 27 bring-up (UniXNU-sheng e9865b0, zzzz-sheng-ipados27-bringup.patch, BSD-2-Clause-Patent):
+ * the file system keeps no class a caller sets, so a daemon that sets one and checks it back never sees it -- PosterBoard
+ * creates its poster data store with NSFileProtectionNone (class D), finds the class missing, judges the store not viable and
+ * has no wallpaper (here: PBFPosterExtensionDataStoreErrorDomain -2218 for every poster provider). A writable volume without
+ * content protection keeps the class a caller sets in an extended attribute, and a file without one reads as class D, which is
+ * what an unencrypted file is. Nothing is encrypted either way. Boot-arg sweetdataprotect=0 turns it off (default on).
+ */
+#define SWEET_DATAPROTECT_XATTR "com.bergamota.dataprotect-class"
+#define SWEET_DATAPROTECT_CLASS_D 4
+
+static int
+sweet_dataprotect_emulated(vnode_t vp)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		uint32_t value = 1;
+		PE_parse_boot_argn("sweetdataprotect", &value, sizeof(value));
+		enabled = value != 0;
+	}
+	mount_t mp = vnode_mount(vp);
+	return enabled && mp != NULL && !(vfs_flags(mp) & MNT_CPROTECT) && !vfs_isrdonly(mp) &&
+	       (vnode_isreg(vp) || vnode_isdir(vp));
+}
+
+static void
+sweet_dataprotect_getattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	uint32_t class = 0;
+	size_t size = sizeof(class);
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	if (uio == NULL) {
+		return;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(&class), sizeof(class));
+	if (vn_getxattr(vp, SWEET_DATAPROTECT_XATTR, uio, &size, XATTR_NOSECURITY, ctx) != 0 || class == 0 || class > 7) {
+		class = SWEET_DATAPROTECT_CLASS_D;
+	}
+	uio_free(uio);
+	vap->va_dataprotect_class = class;
+	VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+}
+
+/* Keeps the class asked for and takes it out of what the file system is asked to set (which would only drop it). */
+static void
+sweet_dataprotect_setattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	uint32_t class = vap->va_dataprotect_class;
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	if (uio == NULL) {
+		return;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(&class), sizeof(class));
+	if (vn_setxattr(vp, SWEET_DATAPROTECT_XATTR, uio, XATTR_NOSECURITY, ctx) == 0) {
+		VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+		VATTR_CLEAR_ACTIVE(vap, va_dataprotect_class);
+	}
+	uio_free(uio);
+}
+
 #if 0
