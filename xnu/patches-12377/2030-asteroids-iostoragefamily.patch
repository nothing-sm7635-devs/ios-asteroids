+                          IOStorageExtent *     extents,
+                          UInt32                extentsCount,
+                          IOStorageUnmapOptions options)
+{
+    //
+    // Delete unused data from the storage object at the specified byte offsets.
+    //
+
+    return kIOReturnUnsupported;
+}
