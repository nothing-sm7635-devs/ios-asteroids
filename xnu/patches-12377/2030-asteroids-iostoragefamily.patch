+        {
+            options = 0;
+        }
+        else
+        {
+            return IOStorage::synchronize( client, byteStart, byteCount, options );
+        }
+    }
+#endif /* TARGET_OS_OSX */
+
+    return getProvider( )->synchronize( this, byteStart, byteCount, options );
