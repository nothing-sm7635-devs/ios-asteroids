+ */
+
+#define kIOMediaRemovableKey "Removable"
+
+/*!
+ * @defined kIOMediaSizeKey
+ * @abstract
+ * A property of IOMedia objects.
+ * @discussion
+ * The kIOMediaSizeKey property has an OSNumber value and describes the total length of the media in
