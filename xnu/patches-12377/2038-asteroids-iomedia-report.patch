+/* Bergamota 2038: what IOStorageFamily built on the nub (IOBlockStorageDriver -> IOMedia -> IOGUIDPartitionScheme ->
+ * IOMedia per partition -> IOMediaBSDClient "BSD Name"), with the nub's I/O counts: the kernel log otherwise says nothing
+ * about the matching (asteroids ast18 boot 2). Logged 20 s and 90 s after the nub was published. */
+static void
+sweet_iomedia_report(thread_call_param_t p0, thread_call_param_t p1)
+{
+	IORegistryEntry *nub = (IORegistryEntry *)p0;
+	uint64_t r = 0, w = 0, e = 0;
+	int n = 0;
+
+	sweet_ufs_nub_counts(&r, &w, &e);
+	IOLog("SWEET IOMEDIA: after %llu s: nub reads %llu writes %llu errors %llu\n", (uint64_t)(uintptr_t)p1, r, w, e);
+	IORegistryIterator *it = IORegistryIterator::iterateOver(nub, gIOServicePlane, kIORegistryIterateRecursively);
+	if (!it) {
+		IOLog("SWEET IOMEDIA: no registry iterator\n");
+		return;
+	}
+	OSObject *o;
+	while ((o = it->getNextObject()) != NULL) {
+		IORegistryEntry *ent = OSDynamicCast(IORegistryEntry, o);
+		if (!ent) {
+			continue;
+		}
+		OSString *bsd = OSDynamicCast(OSString, ent->getProperty("BSD Name"));
+		OSString *content = OSDynamicCast(OSString, ent->getProperty("Content"));
+		OSNumber *size = OSDynamicCast(OSNumber, ent->getProperty("Size"));
+		IOLog("SWEET IOMEDIA:   %s: bsd %s size %llu MiB content %s\n", ent->getMetaClass()->getClassName(),
+		    bsd ? bsd->getCStringNoCopy() : "-", size ? (size->unsigned64BitValue() >> 20) : 0ULL,
+		    content ? content->getCStringNoCopy() : "-");
+		if (++n >= 48) {
+			break;
+		}
+	}
+	IOLog("SWEET IOMEDIA: %d client(s) under the nub\n", n);
+	it->release();
+}
+
+static void
+sweet_iomedia_report_later(IORegistryEntry *nub, unsigned seconds)
+{
+	thread_call_t tc = thread_call_allocate(sweet_iomedia_report, nub);
+	uint64_t deadline = 0;
+	if (!tc) {
+		return;
+	}
+	clock_interval_to_deadline(seconds, NSEC_PER_SEC, &deadline);
+	thread_call_enter1_delayed(tc, (thread_call_param_t)(uintptr_t)seconds, deadline);
+}
