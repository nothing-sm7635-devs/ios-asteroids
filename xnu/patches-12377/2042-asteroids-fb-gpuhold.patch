diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 76a8b9b..bcda563 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1123,6 +1123,21 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
  * 0229: the pending swap is taken only once the GPU work submitted before it has completed (it may be drawing that very
  * framebuffer), or after 50 ms (a stuck GPU must not stop the display). Called with fLock held.
  */
+/* Bergamota 2042: sweetfb_gpuhold=MS, how long a pending swap is held for the GPU work submitted before it (default 100;
+ * 50 before: on the A810 a submission often takes longer, and the display then copied the frame half drawn, asteroids
+ * ast21). A stuck GPU still never stops the display; its recovery takes about a second. */
+static uint64_t
+sweet_fb_gpuhold_ms(void)
+{
+	static uint32_t ms;
+	if (ms == 0) {
+		uint32_t v = 100;
+		PE_parse_boot_argn("sweetfb_gpuhold", &v, sizeof(v));
+		ms = (v == 0 || v > 2000) ? 100 : v;
+	}
+	return ms;
+}
+
 bool
 AppleCLCD::gpuGateOpen(uint64_t now)
 {
@@ -1130,7 +1145,7 @@ AppleCLCD::gpuGateOpen(uint64_t now)
 		return true;
 	}
 	uint64_t cap;
-	nanoseconds_to_absolutetime(50 * NSEC_PER_MSEC, &cap);
+	nanoseconds_to_absolutetime(sweet_fb_gpuhold_ms() * NSEC_PER_MSEC, &cap);
 	if (now - fPendAbs > cap) {
 		fSt.gpuHoldTimeouts++;
 		fPendFence = 0;
@@ -2510,7 +2525,7 @@ AppleCLCD::scanCopyPresent(SweetSurface *s, uint32_t id)
 		if (fScanGpu && !fScanGpuOff) {
 			/* 0241: swapFired did not hold this swap for the GPU (it expected a GPU copy): wait for its work here */
 			uint64_t lim;
-			nanoseconds_to_absolutetime(50 * NSEC_PER_MSEC, &lim);
+			nanoseconds_to_absolutetime(sweet_fb_gpuhold_ms() * NSEC_PER_MSEC, &lim);
 			while (!sweet_gpu_fence_passed(fPendFence) && mach_absolute_time() - t0 < lim) {
 				IODelay(50);
 			}
