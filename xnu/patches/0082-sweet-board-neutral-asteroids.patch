+/* The device tree root names the board: "xiaomi,sweet" is the SM7150 phone. */
+static bool
+sweet_board_is_sm7150(void)
+{
+	DTEntry root;
+	void const *prop;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", &prop, &size) != kSuccess) {
+		return false;
+	}
+	const char *s = prop, *end = s + size;
+	while (s < end) {
+		if (strncmp(s, "xiaomi,sweet", end - s) == 0) {
+			return true;
+		}
+		s += strnlen(s, end - s) + 1;
+	}
+	return false;
+}
