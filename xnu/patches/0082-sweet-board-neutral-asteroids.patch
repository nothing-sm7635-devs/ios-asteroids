+/*
+ * Take the framebuffer from boot_args (physical, 32 bpp); start.s mapped the
+ * 32MB block holding its start, so clip the height to the rows inside it.
+ * Same arithmetic as the stage-0 band in start.s.
+ */
+void
+sweet_early_setup(const boot_args *args)
+{
+	uint64_t base = args->Video.v_baseAddr, stride = args->Video.v_rowBytes;
+	if (!base || (args->Video.v_depth & kBootVideoDepthMask) != 32 || stride < 4 * 64 || args->Video.v_height < 64) {
+		return;
+	}
+	uint64_t rows = (ARM_TT_L2_SIZE - (base & ARM_TT_L2_OFFMASK)) / stride;
+	uint64_t height = args->Video.v_height < rows ? args->Video.v_height : rows;
+	uint64_t width = args->Video.v_width < stride / 4 ? args->Video.v_width : stride / 4;
+	if (height < 64) {
+		return;
+	}
+	early_phys = base;
+	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	early_width = (unsigned int)width;
+	early_height = (unsigned int)height;
+	early_stride = (unsigned int)(stride / 4);
+}
