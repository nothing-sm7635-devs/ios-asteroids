-/* v5 can map one PPID more than once; prefer the apps-owned entry. */
+/* The device tree root names the board. */
+static const struct keys_board *
+keys_find_board(void)
+{
+	DTEntry root;
+	void const *prop;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", &prop, &size) != kSuccess) {
+		return NULL;
+	}
+	for (const char *s = prop, *end = s + size; s < end; s += strnlen(s, end - s) + 1) {
+		for (unsigned b = 0; b < sizeof(keys_boards) / sizeof(keys_boards[0]); ++b) {
+			if (strncmp(s, keys_boards[b].compatible, end - s) == 0) {
+				return &keys_boards[b];
+			}
+		}
+	}
+	return NULL;
+}
